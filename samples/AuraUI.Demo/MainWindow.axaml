<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout"
        xmlns:input="using:AuraUI.Controls.Input"
        xmlns:selection="using:AuraUI.Controls.Selection"
        xmlns:display="using:AuraUI.Controls.Display"
        xmlns:feedback="using:AuraUI.Controls.Feedback"
        xmlns:core="using:AuraUI.Core.Helpers"
        x:Class="AuraUI.Demo.MainWindow"
        x:DataType="Window"
        Title="AuraUI Component Gallery"
        Width="1100"
        Height="750"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Padding="16,12"
                Background="{DynamicResource SystemAccentColor}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="AuraUI"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <TextBlock Text="Component Gallery"
                           FontSize="14"
                           Foreground="#CCFFFFFF"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Padding="16,8"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>

        <!-- Main content -->
        <TabControl x:Name="MainTabControl"
                    Margin="8"
                    SelectedIndex="0">

            <!-- ============================================================ -->
            <!-- LAYOUT TAB -->
            <!-- ============================================================ -->
            <TabItem Header="Layout">
                <ScrollViewer>
                    <StackPanel Spacing="16" Margin="8">

                        <!-- Card section -->
                        <TextBlock Text="Card" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <WrapPanel>
                            <layout:Card Header="Basic Card"
                                         Margin="0,0,12,12"
                                         Width="260"
                                         Padding="12">
                                <TextBlock Text="This is a basic card with header and content areas. Cards group related information." TextWrapping="Wrap"/>
                            </layout:Card>

                            <layout:Card Header="Hoverable Card"
                                         IsHoverable="True"
                                         Elevation="2"
                                         Margin="0,0,12,12"
                                         Width="260"
                                         Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="This card responds to hover with elevation change." TextWrapping="Wrap"/>
                                    <TextBlock Text="Elevation: 2" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                            </layout:Card>

                            <layout:Card Header="Card with Footer"
                                         Margin="0,0,12,12"
                                         Width="260"
                                         Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Cards support header, content, and footer sections." TextWrapping="Wrap"/>
                                </StackPanel>
                                <layout:Card.Footer>
                                    <TextBlock Text="Footer content" FontSize="11" Foreground="Gray"/>
                                </layout:Card.Footer>
                            </layout:Card>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- Expander section -->
                        <TextBlock Text="Expander" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <layout:Expander Header="Click to expand (Down)"
                                         IsExpanded="False"
                                         ExpandDirection="Down"
                                         Margin="0,0,0,8">
                            <TextBlock Text="This content expands downward with a smooth animation. The Expander control supports all four directions." TextWrapping="Wrap" Margin="16,8"/>
                        </layout:Expander>

                        <layout:Expander Header="Expanded by default"
                                         IsExpanded="True"
                                         Margin="0,0,0,8">
                            <TextBlock Text="This expander starts in the expanded state. Use the IsExpanded property to control initial visibility." TextWrapping="Wrap" Margin="16,8"/>
                        </layout:Expander>

                        <layout:Divider Margin="0,4"/>

                        <!-- Divider section -->
                        <TextBlock Text="Divider" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Above the divider" Margin="0,0,0,4"/>
                        <layout:Divider/>
                        <TextBlock Text="Below the divider" Margin="0,4,0,0"/>

                        <layout:Divider Margin="0,4"/>

                        <!-- Badge section -->
                        <TextBlock Text="Badge" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <WrapPanel>
                            <StackPanel Margin="0,0,16,12" Spacing="4">
                                <layout:Badge Value="5" Variant="Primary">
                                    <Border Width="40" Height="40" Background="LightGray" CornerRadius="8">
                                        <TextBlock Text="M" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                    </Border>
                                </layout:Badge>
                                <TextBlock Text="Primary (count)" FontSize="11" Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,16,12" Spacing="4">
                                <layout:Badge Value="150" MaxValue="99" Variant="Error">
                                    <Border Width="40" Height="40" Background="LightGray" CornerRadius="8">
                                        <TextBlock Text="N" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                    </Border>
                                </layout:Badge>
                                <TextBlock Text="Error (overflow)" FontSize="11" Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,16,12" Spacing="4">
                                <layout:Badge Variant="Success" IsDot="True">
                                    <Border Width="40" Height="40" Background="LightGray" CornerRadius="8">
                                        <TextBlock Text="U" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                    </Border>
                                </layout:Badge>
                                <TextBlock Text="Success (dot)" FontSize="11" Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,16,12" Spacing="4">
                                <layout:Badge Variant="Warning" IsDot="True">
                                    <Border Width="40" Height="40" Background="LightGray" CornerRadius="8">
                                        <TextBlock Text="W" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                    </Border>
                                </layout:Badge>
                                <TextBlock Text="Warning (dot)" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- Tag section -->
                        <TextBlock Text="Tag" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <WrapPanel>
                            <layout:Tag Content="Default Tag" Variant="Default" Margin="0,0,8,8"/>
                            <layout:Tag Content="Primary Tag" Variant="Primary" Margin="0,0,8,8"/>
                            <layout:Tag Content="Success Tag" Variant="Success" Margin="0,0,8,8"/>
                            <layout:Tag Content="Warning Tag" Variant="Warning" Margin="0,0,8,8"/>
                            <layout:Tag Content="Error Tag" Variant="Error" Margin="0,0,8,8"/>
                            <layout:Tag Content="Outlined Tag" Variant="Outlined" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <TextBlock Text="Closable tags" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <WrapPanel>
                            <layout:Tag Content="React" Variant="Primary" IsClosable="True" Margin="0,0,8,8" x:Name="ClosableTag1"/>
                            <layout:Tag Content="Avalonia" Variant="Success" IsClosable="True" Margin="0,0,8,8" x:Name="ClosableTag2"/>
                            <layout:Tag Content="TypeScript" Variant="Outlined" IsClosable="True" Margin="0,0,8,8" x:Name="ClosableTag3"/>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- Avatar section -->
                        <TextBlock Text="Avatar" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,12" Spacing="4" HorizontalAlignment="Center">
                                <layout:Avatar FallbackText="SK" Size="Large" FallbackBackground="#0078D4"/>
                                <TextBlock Text="Large" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12" Spacing="4" HorizontalAlignment="Center">
                                <layout:Avatar FallbackText="AB" Size="Medium" FallbackBackground="#107C10"/>
                                <TextBlock Text="Medium" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12" Spacing="4" HorizontalAlignment="Center">
                                <layout:Avatar FallbackText="JD" Size="Small" FallbackBackground="#D83B01"/>
                                <TextBlock Text="Small" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12" Spacing="4" HorizontalAlignment="Center">
                                <layout:Avatar FallbackText="MZ" Size="XL" FallbackBackground="#5C2D91"/>
                                <TextBlock Text="XL" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12" Spacing="4" HorizontalAlignment="Center">
                                <layout:Avatar FallbackText="SQ" Size="Medium" Shape="Square" FallbackBackground="#0078D4"/>
                                <TextBlock Text="Square" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- Skeleton section -->
                        <TextBlock Text="Skeleton" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Animated loading placeholders with shimmer effect."
                                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <StackPanel Spacing="8" Width="300" Margin="0,0,16,12">
                                <TextBlock Text="Text variant" FontSize="12" FontWeight="SemiBold"/>
                                <layout:Skeleton Variant="Text" Rows="3"/>
                            </StackPanel>
                            <StackPanel Spacing="8" Width="300" Margin="0,0,16,12">
                                <TextBlock Text="Circle variant" FontSize="12" FontWeight="SemiBold"/>
                                <layout:Skeleton Variant="Circle" Width="60" Height="60"/>
                            </StackPanel>
                            <StackPanel Spacing="8" Width="300" Margin="0,0,16,12">
                                <TextBlock Text="Image variant" FontSize="12" FontWeight="SemiBold"/>
                                <layout:Skeleton Variant="Image" Width="300"/>
                            </StackPanel>
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- INPUT TAB -->
            <!-- ============================================================ -->
            <TabItem Header="Input">
                <ScrollViewer>
                    <StackPanel Spacing="16" Margin="8">

                        <!-- AuraButton section -->
                        <TextBlock Text="AuraButton" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <TextBlock Text="Variant classes" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <input:AuraButton Content="Default" Margin="0,0,8,8"/>
                            <input:AuraButton Content="Primary" Classes="primary" Margin="0,0,8,8"/>
                            <input:AuraButton Content="Secondary" Classes="secondary" Margin="0,0,8,8"/>
                            <input:AuraButton Content="Destructive" Classes="destructive" Margin="0,0,8,8"/>
                            <input:AuraButton Content="Outline" Classes="outline" Margin="0,0,8,8"/>
                            <input:AuraButton Content="Ghost" Classes="ghost" Margin="0,0,8,8"/>
                            <input:AuraButton Content="Link" Classes="link" Margin="0,0,8,8"/>
                            <input:AuraButton Content="Disabled" IsEnabled="False" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <TextBlock Text="Size classes" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <WrapPanel>
                            <input:AuraButton Content="Small" Classes="sm" Margin="0,0,8,8"/>
                            <input:AuraButton Content="Medium" Classes="md" Margin="0,0,8,8"/>
                            <input:AuraButton Content="Large" Classes="lg" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <TextBlock Text="Loading state" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <WrapPanel>
                            <input:AuraButton Content="Click to load" Classes="primary" Margin="0,0,8,8" Click="LoadingButton_Click" x:Name="DemoLoadingButton"/>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- AuraTextBox section -->
                        <TextBlock Text="AuraTextBox" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Spacing="8" MaxWidth="400">
                            <input:AuraTextBox Watermark="Enter your name..." />
                            <input:AuraTextBox Watermark="With clear button" IsClearable="True"/>
                            <input:AuraTextBox Watermark="With prefix and suffix" Prefix="$" Suffix=".00"/>
                            <input:AuraTextBox Watermark="Character count" ShowCount="True" MaxLengthDisplay="50"/>
                            <input:AuraTextBox Watermark="Filled variant" Variant="Filled" IsClearable="True"/>
                            <input:AuraTextBox Watermark="Underlined variant" Variant="Underlined"/>
                        </StackPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- AuraPasswordBox section -->
                        <TextBlock Text="AuraPasswordBox" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Spacing="8" MaxWidth="400">
                            <input:AuraPasswordBox Watermark="Enter password..." />
                            <input:AuraPasswordBox Watermark="Confirm password..." />
                        </StackPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- AuraNumericUpDown section -->
                        <TextBlock Text="AuraNumericUpDown" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Spacing="8" MaxWidth="400">
                            <input:AuraNumericUpDown Watermark="Enter a number" Minimum="0" Maximum="100" Increment="1" Value="50"/>
                            <input:AuraNumericUpDown Watermark="Decimal" Minimum="0" Maximum="10" Increment="0.5M" Value="3.5M" FormatString="F2"/>
                        </StackPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- SearchBox section -->
                        <TextBlock Text="SearchBox" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Spacing="8" MaxWidth="400">
                            <input:SearchBox Watermark="Search components..." SearchDelay="300" x:Name="DemoSearchBox"/>
                        </StackPanel>
                        <TextBlock Text="Press Escape to clear. Search fires after 300ms debounce."
                                   FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- SELECTION TAB -->
            <!-- ============================================================ -->
            <TabItem Header="Selection">
                <ScrollViewer>
                    <StackPanel Spacing="16" Margin="8">

                        <!-- AuraComboBox section -->
                        <TextBlock Text="AuraComboBox" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Spacing="8" MaxWidth="400">
                            <selection:AuraComboBox PlaceholderText="Select a fruit" SelectedIndex="0">
                                <ComboBoxItem>Apple</ComboBoxItem>
                                <ComboBoxItem>Banana</ComboBoxItem>
                                <ComboBoxItem>Cherry</ComboBoxItem>
                                <ComboBoxItem>Date</ComboBoxItem>
                                <ComboBoxItem>Elderberry</ComboBoxItem>
                            </selection:AuraComboBox>
                            <selection:AuraComboBox PlaceholderText="Searchable combo" IsSearchable="True">
                                <ComboBoxItem>Angular</ComboBoxItem>
                                <ComboBoxItem>React</ComboBoxItem>
                                <ComboBoxItem>Vue</ComboBoxItem>
                                <ComboBoxItem>Svelte</ComboBoxItem>
                                <ComboBoxItem>Avalonia</ComboBoxItem>
                                <ComboBoxItem>MAUI</ComboBoxItem>
                            </selection:AuraComboBox>
                            <selection:AuraComboBox PlaceholderText="Filled variant" Variant="Filled">
                                <ComboBoxItem>Option A</ComboBoxItem>
                                <ComboBoxItem>Option B</ComboBoxItem>
                                <ComboBoxItem>Option C</ComboBoxItem>
                            </selection:AuraComboBox>
                            <selection:AuraComboBox PlaceholderText="Disabled combo" IsEnabled="False">
                                <ComboBoxItem>Option A</ComboBoxItem>
                                <ComboBoxItem>Option B</ComboBoxItem>
                            </selection:AuraComboBox>
                        </StackPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- MultiComboBox section -->
                        <TextBlock Text="MultiComboBox" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Select multiple items and see them rendered as tags above the dropdown."
                                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel Spacing="8" MaxWidth="400">
                            <selection:MultiComboBox PlaceholderText="Select frameworks" IsSearchable="True" ShowSelectAll="True">
                                <ComboBoxItem>Angular</ComboBoxItem>
                                <ComboBoxItem>React</ComboBoxItem>
                                <ComboBoxItem>Vue</ComboBoxItem>
                                <ComboBoxItem>Svelte</ComboBoxItem>
                                <ComboBoxItem>Avalonia</ComboBoxItem>
                                <ComboBoxItem>MAUI</ComboBoxItem>
                            </selection:MultiComboBox>
                        </StackPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- AuraRadioButton section -->
                        <TextBlock Text="AuraRadioButton" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Default variant" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Spacing="8">
                            <selection:AuraRadioButton Content="Option A" GroupName="Options" IsChecked="True"/>
                            <selection:AuraRadioButton Content="Option B" GroupName="Options"/>
                            <selection:AuraRadioButton Content="Option C (Disabled)" GroupName="Options" IsEnabled="False"/>
                        </StackPanel>

                        <TextBlock Text="Button variant" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <selection:AuraRadioButton Content="Daily" GroupName="TimeRange" Variant="Button" IsChecked="True"/>
                            <selection:AuraRadioButton Content="Weekly" GroupName="TimeRange" Variant="Button"/>
                            <selection:AuraRadioButton Content="Monthly" GroupName="TimeRange" Variant="Button"/>
                            <selection:AuraRadioButton Content="Yearly" GroupName="TimeRange" Variant="Button"/>
                        </StackPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- AuraCheckBox section -->
                        <TextBlock Text="AuraCheckBox" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Spacing="8">
                            <selection:AuraCheckBox Content="Checked" IsChecked="True"/>
                            <selection:AuraCheckBox Content="Unchecked"/>
                            <selection:AuraCheckBox Content="Three-state" IsThreeState="True" IsChecked="{x:Null}"/>
                            <selection:AuraCheckBox Content="Disabled" IsEnabled="False"/>
                        </StackPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- Switch section -->
                        <TextBlock Text="Switch" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <selection:Switch IsChecked="True" Size="Small"/>
                                <TextBlock Text="Small" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <selection:Switch IsChecked="True" Size="Medium"/>
                                <TextBlock Text="Medium (default)" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <selection:Switch IsChecked="False" Size="Large"/>
                                <TextBlock Text="Large" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <selection:Switch IsEnabled="False"/>
                                <TextBlock Text="Disabled" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- RateControl section -->
                        <TextBlock Text="RateControl" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Star rating (clickable)" FontSize="12" FontWeight="SemiBold"/>
                                <selection:RateControl Value="3.5" Max="5" AllowHalf="True" ShowValue="True" x:Name="DemoRateControl"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Read-only rating" FontSize="12" FontWeight="SemiBold"/>
                                <selection:RateControl Value="4" Max="5" IsReadOnly="True" ShowValue="True"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- DISPLAY TAB -->
            <!-- ============================================================ -->
            <TabItem Header="Display">
                <ScrollViewer>
                    <StackPanel Spacing="16" Margin="8">

                        <!-- ProgressRing section -->
                        <TextBlock Text="ProgressRing" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,24,12" Spacing="8" HorizontalAlignment="Center">
                                <display:ProgressRing IsIndeterminate="True" Size="Large"/>
                                <TextBlock Text="Indeterminate" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12" Spacing="8" HorizontalAlignment="Center">
                                <display:ProgressRing Value="65" Maximum="100" Size="Large"/>
                                <TextBlock Text="65%" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12" Spacing="8" HorizontalAlignment="Center">
                                <display:ProgressRing IsIndeterminate="True" Size="Medium"/>
                                <TextBlock Text="Medium" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12" Spacing="8" HorizontalAlignment="Center">
                                <display:ProgressRing IsIndeterminate="True" Size="Small"/>
                                <TextBlock Text="Small" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- AuraProgressBar section -->
                        <TextBlock Text="AuraProgressBar" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Spacing="12" MaxWidth="500">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Indeterminate" FontSize="12"/>
                                <display:AuraProgressBar IsIndeterminate="True" Height="6"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Primary (default)" FontSize="12"/>
                                <display:AuraProgressBar Value="25" Maximum="100" Height="6" ShowLabel="True"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Success variant" FontSize="12"/>
                                <display:AuraProgressBar Value="75" Maximum="100" Height="6" Variant="Success" ShowLabel="True"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Warning variant" FontSize="12"/>
                                <display:AuraProgressBar Value="50" Maximum="100" Height="6" Variant="Warning" ShowLabel="True"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Error variant" FontSize="12"/>
                                <display:AuraProgressBar Value="90" Maximum="100" Height="6" Variant="Error" ShowLabel="True"/>
                            </StackPanel>
                        </StackPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- AuraCarousel section -->
                        <TextBlock Text="AuraCarousel" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <display:AuraCarousel AutoPlay="True"
                                              ShowIndicators="True"
                                              ShowNavigation="True"
                                              Width="500"
                                              Height="200"
                                              Margin="0,0,0,8">
                            <display:AuraCarousel.Items>
                                <Border Background="#0078D4" CornerRadius="8" Margin="4">
                                    <TextBlock Text="Slide 1 - Welcome to AuraUI"
                                               Foreground="White" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#107C10" CornerRadius="8" Margin="4">
                                    <TextBlock Text="Slide 2 - Built with Avalonia 12"
                                               Foreground="White" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#D83B01" CornerRadius="8" Margin="4">
                                    <TextBlock Text="Slide 3 - Cross-platform UI"
                                               Foreground="White" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#5C2D91" CornerRadius="8" Margin="4">
                                    <TextBlock Text="Slide 4 - Fluent + Material Themes"
                                               Foreground="White" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </display:AuraCarousel.Items>
                        </display:AuraCarousel>

                        <layout:Divider Margin="0,4"/>

                        <!-- AuraTimeline section -->
                        <TextBlock Text="AuraTimeline" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <display:AuraTimeline Orientation="Vertical" MaxWidth="500">
                            <display:AuraTimelineItem Timestamp="2026-01-15" DotColor="#0078D4">
                                <TextBlock Text="Project Created" FontWeight="SemiBold"/>
                            </display:AuraTimelineItem>
                            <display:AuraTimelineItem Timestamp="2026-03-20" DotColor="#107C10">
                                <TextBlock Text="Beta Release" FontWeight="SemiBold"/>
                            </display:AuraTimelineItem>
                            <display:AuraTimelineItem Timestamp="2026-05-29" DotColor="#D83B01">
                                <TextBlock Text="v1.0 Stable Release" FontWeight="SemiBold"/>
                            </display:AuraTimelineItem>
                        </display:AuraTimeline>

                        <layout:Divider Margin="0,4"/>

                        <!-- StepIndicator section -->
                        <TextBlock Text="StepIndicator" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <display:StepIndicator CurrentStep="1" Orientation="Horizontal" MaxWidth="500">
                            <display:StepIndicatorItem Title="Details" Description="Enter your information"/>
                            <display:StepIndicatorItem Title="Review" Description="Review and confirm"/>
                            <display:StepIndicatorItem Title="Confirm" Description="Final confirmation"/>
                        </display:StepIndicator>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- FEEDBACK TAB -->
            <!-- ============================================================ -->
            <TabItem Header="Feedback">
                <ScrollViewer>
                    <StackPanel Spacing="16" Margin="8">

                        <!-- Toast section -->
                        <TextBlock Text="AuraToast" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Toast notifications appear in the overlay layer with auto-dismiss. Uses static methods to show."
                                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <input:AuraButton Content="Success Toast" Classes="primary" Margin="0,0,8,8" Click="ShowSuccessToast_Click"/>
                            <input:AuraButton Content="Warning Toast" Classes="outline" Margin="0,0,8,8" Click="ShowWarningToast_Click"/>
                            <input:AuraButton Content="Error Toast" Classes="destructive" Margin="0,0,8,8" Click="ShowErrorToast_Click"/>
                            <input:AuraButton Content="Info Toast" Margin="0,0,8,8" Click="ShowInfoToast_Click"/>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- AuraMessageBox section -->
                        <TextBlock Text="AuraMessageBox" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <input:AuraButton Content="Show MessageBox" Classes="primary" Margin="0,0,8,8" Click="ShowMessageBox_Click"/>
                            <input:AuraButton Content="Show Confirmation" Classes="outline" Margin="0,0,8,8" Click="ShowConfirmation_Click"/>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- Snackbar section -->
                        <TextBlock Text="Snackbar" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <input:AuraButton Content="Show Snackbar" Classes="primary" Margin="0,0,8,8" Click="ShowSnackbar_Click"/>
                            <input:AuraButton Content="Snackbar with Action" Classes="outline" Margin="0,0,8,8" Click="ShowSnackbarWithAction_Click"/>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- AuraNotification section -->
                        <TextBlock Text="AuraNotification" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <input:AuraButton Content="Show Notification" Classes="primary" Margin="0,0,8,8" Click="ShowNotification_Click"/>
                            <input:AuraButton Content="Persistent Notification" Classes="outline" Margin="0,0,8,8" Click="ShowPersistentNotification_Click"/>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <!-- AuraDialog section -->
                        <TextBlock Text="AuraDialog" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <input:AuraButton Content="Show Dialog" Classes="primary" Margin="0,0,8,8" Click="ShowDialog_Click"/>
                            <input:AuraButton Content="Custom Dialog" Classes="outline" Margin="0,0,8,8" Click="ShowCustomDialog_Click"/>
                        </WrapPanel>

                        <!-- Inline AuraDialog for custom dialog demo -->
                        <feedback:AuraDialog x:Name="DemoDialog"
                                              DialogTitle="Custom Dialog"
                                              IsModal="True"
                                              CloseOnOverlay="True"
                                              DialogWidth="480"
                                              Placement="Center">
                            <StackPanel Spacing="16" Margin="24">
                                <TextBlock Text="This dialog is declared inline in XAML and toggled via IsOpen binding."
                                           TextWrapping="Wrap" FontSize="14"/>
                                <input:AuraTextBox Watermark="Enter a value..." />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <input:AuraButton Content="Cancel" Click="DialogCancel_Click"/>
                                    <input:AuraButton Content="Submit" Classes="primary" Click="DialogSubmit_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </feedback:AuraDialog>

                        <layout:Divider Margin="0,4"/>

                        <!-- PendingDialog section -->
                        <TextBlock Text="PendingDialog" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Shows a spinner while an async operation runs. Auto-closes when work completes."
                                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <input:AuraButton Content="Simulate Pending Operation" Classes="primary" Margin="0,0,8,8" Click="ShowPendingDialog_Click"/>

                        <layout:Divider Margin="0,4"/>

                        <!-- LoadingOverlay section -->
                        <TextBlock Text="LoadingOverlay" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Attached property that shows a semi-transparent overlay with spinner over any control."
                                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Border x:Name="LoadingOverlayTarget"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                MaxWidth="400"
                                Height="120">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="This content will be covered by a loading overlay." HorizontalAlignment="Center"/>
                                <input:AuraButton Content="Show Loading Overlay" Classes="primary" Margin="0,12,0,0" Click="ShowLoadingOverlay_Click" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- THEMING TAB -->
            <!-- ============================================================ -->
            <TabItem Header="Theming">
                <ScrollViewer>
                    <StackPanel Spacing="16" Margin="8">

                        <TextBlock Text="Theme Switcher" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="AuraUI supports Light and Dark theme variants. Toggle between them below."
                                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Theme Variant" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <input:AuraButton Content="Light" Classes="primary" Click="LightTheme_Click" x:Name="LightThemeButton"/>
                                    <input:AuraButton Content="Dark" Click="DarkTheme_Click" x:Name="DarkThemeButton"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <layout:Divider Margin="0,4"/>

                        <TextBlock Text="Design Tokens" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="AuraUI uses design tokens for consistent theming. Tokens are defined as resource dictionaries and include:"
                                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <WrapPanel>
                            <layout:Card Header="Colors" Padding="12" Width="220" Margin="0,0,12,12">
                                <TextBlock Text="Primary, Secondary, Success, Warning, Error, Surface, Background, and semantic color tokens."
                                           TextWrapping="Wrap" FontSize="12"/>
                            </layout:Card>
                            <layout:Card Header="Spacing" Padding="12" Width="220" Margin="0,0,12,12">
                                <TextBlock Text="Consistent spacing scale (4px, 8px, 12px, 16px, 24px, 32px, 48px) for margins and padding."
                                           TextWrapping="Wrap" FontSize="12"/>
                            </layout:Card>
                            <layout:Card Header="Typography" Padding="12" Width="220" Margin="0,0,12,12">
                                <TextBlock Text="Font sizes, weights, and line heights following a consistent type scale."
                                           TextWrapping="Wrap" FontSize="12"/>
                            </layout:Card>
                            <layout:Card Header="Shadows" Padding="12" Width="220" Margin="0,0,12,12">
                                <TextBlock Text="Elevation shadow tokens (levels 0-3) for depth and layering effects."
                                           TextWrapping="Wrap" FontSize="12"/>
                            </layout:Card>
                            <layout:Card Header="Animations" Padding="12" Width="220" Margin="0,0,12,12">
                                <TextBlock Text="Duration and easing tokens for consistent motion across all controls."
                                           TextWrapping="Wrap" FontSize="12"/>
                            </layout:Card>
                            <layout:Card Header="Corners" Padding="12" Width="220" Margin="0,0,12,12">
                                <TextBlock Text="Corner radius tokens (None, Small, Medium, Large, Round) for border radii."
                                           TextWrapping="Wrap" FontSize="12"/>
                            </layout:Card>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <TextBlock Text="Theme System" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="AuraUI ships with two complete theme packages:"
                                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <WrapPanel>
                            <layout:Card Header="AuraUI.Themes.Fluent" Padding="16" Width="350" Margin="0,0,12,12" Elevation="2">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Windows 11 / Fluent Design inspired theme. Clean, modern, and professional. Ships as the default theme."
                                               TextWrapping="Wrap" FontSize="13"/>
                                    <TextBlock Text="avares://AuraUI.Themes.Fluent/AuraUITheme.axaml"
                                               FontFamily="Consolas, monospace" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </layout:Card>
                            <layout:Card Header="AuraUI.Themes.Material" Padding="16" Width="350" Margin="0,0,12,12" Elevation="2">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Google Material Design 3 inspired theme. Rounded corners, bold colors, and tactile surfaces."
                                               TextWrapping="Wrap" FontSize="13"/>
                                    <TextBlock Text="avares://AuraUI.Themes.Material/AuraUITheme.axaml"
                                               FontFamily="Consolas, monospace" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </layout:Card>
                        </WrapPanel>

                        <layout:Divider Margin="0,4"/>

                        <TextBlock Text="Customization" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Override design tokens by merging your own resource dictionary after the theme:"
                                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                Padding="16" CornerRadius="8" MaxWidth="600">
                            <TextBlock FontFamily="Consolas, monospace" FontSize="12" TextWrapping="Wrap"
                                       Text="&lt;Application.Styles&gt;&#x0a;    &lt;FluentTheme /&gt;&#x0a;    &lt;StyleInclude Source=&quot;avares://AuraUI.Themes.Fluent/AuraUITheme.axaml&quot;/&gt;&#x0a;&lt;/Application.Styles&gt;&#x0a;&#x0a;&lt;Application.Resources&gt;&#x0a;    &lt;ResourceDictionary&gt;&#x0a;        &lt;SolidColorBrush x:Key=&quot;AuraPrimaryBrush&quot; Color=&quot;#6366F1&quot;/&gt;&#x0a;    &lt;/ResourceDictionary&gt;&#x0a;&lt;/Application.Resources&gt;"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
