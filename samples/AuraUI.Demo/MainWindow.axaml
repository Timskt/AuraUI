<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AuraUI.Demo.MainWindow"
        Title="AuraUI Component Gallery"
        Width="1280"
        Height="860"
        MinWidth="960"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Padding="20,12"
                Background="{DynamicResource AuraPrimaryBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" DockPanel.Dock="Left">
                    <TextBlock Text="AuraUI"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AuraForegroundOnAccentBrush}"
                               VerticalAlignment="Center"/>
                    <Border Background="#FFFFFF22" CornerRadius="6" Padding="10,4">
                        <TextBlock Text="Component Gallery"
                                   FontSize="13"
                                   Foreground="{DynamicResource AuraForegroundOnAccentBrush}"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="ThemeToggleButton"
                            Content="Toggle Dark/Light"
                            Classes="outline"
                            Foreground="{DynamicResource AuraForegroundOnAccentBrush}"
                            BorderBrush="{DynamicResource AuraForegroundOnAccentBrush}"
                            Click="ThemeToggle_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Padding="20,6"
                BorderBrush="{DynamicResource AuraDividerBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="12"
                       Foreground="{DynamicResource AuraForegroundSecondaryBrush}"/>
        </Border>

        <!-- Main: Sidebar + Content -->
        <Grid ColumnDefinitions="260,*">
            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource AuraSurfaceBrush}"
                    BorderBrush="{DynamicResource AuraDividerBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Search -->
                    <Border DockPanel.Dock="Top" Padding="12,10">
                        <TextBox x:Name="SearchBox"
                                 PlaceholderText="Search components..."
                                 Classes="underline"
                                 KeyUp="SearchBox_KeyUp"/>
                    </Border>
                    <!-- Nav List -->
                    <ListBox x:Name="NavList"
                             SelectionChanged="NavList_SelectionChanged"
                             Padding="4"/>
                </DockPanel>
            </Border>

            <!-- Content -->
            <ContentControl x:Name="ContentArea"
                            Grid.Column="1"
                            Content="{x:Null}"/>
        </Grid>
    </DockPanel>
</Window>
