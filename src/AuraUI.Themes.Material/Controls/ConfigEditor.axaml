<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="using:AuraUI.Controls.Input">

    <!-- ConfigEditor — Material Style -->
    <Style Selector="input|ConfigEditor">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraOnSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Border.Transitions>
                        <BrushTransition Duration="0:0:0.200" Property="Background"/>
                        <BrushTransition Duration="0:0:0.200" Property="BorderBrush"/>
                    </Border.Transitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{TemplateBinding Tag}"
                                   FontWeight="Medium"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuraOnSurfaceBrush}"
                                   Margin="0,0,0,16"/>
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource AuraErrorContainerBrush}"
                                CornerRadius="{DynamicResource AuraRadiusSm}"
                                Padding="12,8"
                                Margin="0,16,0,0"
                                IsVisible="False">
                            <ItemsControl/>
                        </Border>
                        <ScrollViewer/>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="input|ConfigEditor:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="input|ConfigEditor:disabled">
        <Setter Property="Opacity" Value="0.38"/>
    </Style>

</Styles>
