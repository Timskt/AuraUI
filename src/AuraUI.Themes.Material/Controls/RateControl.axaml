<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="clr-namespace:AuraUI.Controls.Selection;assembly=AuraUI.Controls">

    <!-- Material Design 3 — RateControl (Star Rating) -->

    <Style Selector="selection|RateControl">
        <Setter Property="Foreground" Value="{DynamicResource AuraWarningBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SelectedColor" Value="{DynamicResource AuraWarningBrush}"/>
        <Setter Property="UnselectedColor" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="ItemSize" Value="24"/>
        <Setter Property="ItemSpacing" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="selection:RateControl">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel Name="PART_RatingPanel"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small size -->
    <Style Selector="selection|RateControl:small">
        <Setter Property="ItemSize" Value="16"/>
    </Style>

    <!-- Large size -->
    <Style Selector="selection|RateControl:large">
        <Setter Property="ItemSize" Value="32"/>
    </Style>

</Styles>
