<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feedback="using:AuraUI.Controls.Feedback">

    <Style Selector="feedback|AuraMessage">
        <Setter Property="Background" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="MinWidth" Value="280"/>
        <Setter Property="MaxWidth" Value="480"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,24,0,0"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        ClipToBounds="{TemplateBinding ClipToBounds}">
                    <DockPanel>
                        <Button Name="PART_CloseButton"
                                Classes="message-close"
                                DockPanel.Dock="Right"
                                Content="&#x2715;"
                                IsVisible="{TemplateBinding ShowClose}"/>
                        <Border Name="PART_Icon"
                                Classes="message-icon"
                                DockPanel.Dock="Left"
                                Margin="0,0,10,0"
                                IsVisible="{TemplateBinding ShowIcon}">
                            <Panel>
                                <Path Name="IconInfo"
                                      Width="12" Height="12"
                                      Data="M 8,1 A 7,7 0 1,1 8,15 A 7,7 0 1,1 8,1 M 8,4.5 L 8,5.5 M 8,7 L 8,11"
                                      Stroke="{DynamicResource AuraInfoBrush}"
                                      StrokeThickness="1.5"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <Path Name="IconSuccess"
                                      Width="12" Height="12"
                                      Data="M 5,8 L 7,11 L 11,5"
                                      Stroke="{DynamicResource AuraSuccessBrush}"
                                      StrokeThickness="2"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="False"/>
                                <Path Name="IconWarning"
                                      Width="12" Height="12"
                                      Data="M 8,2 L 15,14 L 1,14 Z M 8,6 L 8,10 M 8,12 L 8,12.5"
                                      Stroke="{DynamicResource AuraWarningBrush}"
                                      StrokeThickness="1.5"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="False"/>
                                <Path Name="IconError"
                                      Width="12" Height="12"
                                      Data="M 5.5,5.5 L 10.5,10.5 M 10.5,5.5 L 5.5,10.5"
                                      Stroke="{DynamicResource AuraErrorBrush}"
                                      StrokeThickness="2"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="False"/>
                            </Panel>
                        </Border>
                        <TextBlock Text="{TemplateBinding Text}"
                                   FontSize="14"
                                   Foreground="{DynamicResource AuraForegroundBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="feedback|AuraMessage">
        <Style.Animations>
            <Animation Duration="00:00:00.300" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="-20"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Button.message-close">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundTertiaryBrush}"/>
    </Style>
    <Style Selector="Button.message-close:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <Style Selector="Border.message-icon">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="feedback|AuraMessage:success">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraSuccessBrush}"/>
    </Style>
    <Style Selector="feedback|AuraMessage:success Border.message-icon">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryContainerBrush}"/>
    </Style>

    <Style Selector="feedback|AuraMessage:warning">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraWarningBrush}"/>
    </Style>
    <Style Selector="feedback|AuraMessage:warning Border.message-icon">
        <Setter Property="Background" Value="{DynamicResource AuraSecondaryContainerBrush}"/>
    </Style>

    <Style Selector="feedback|AuraMessage:error">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>
    <Style Selector="feedback|AuraMessage:error Border.message-icon">
        <Setter Property="Background" Value="{DynamicResource AuraErrorContainerBrush}"/>
    </Style>

    <Style Selector="feedback|AuraMessage:info">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInfoBrush}"/>
    </Style>
    <Style Selector="feedback|AuraMessage:info Border.message-icon">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryContainerBrush}"/>
    </Style>

    <!-- ============================================================
         AuraMessage Icon Variant Visibility
         ============================================================ -->

    <!-- Success: hide info, show checkmark -->
    <Style Selector="feedback|AuraMessage:success Border.message-icon Path#IconInfo">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="feedback|AuraMessage:success Border.message-icon Path#IconSuccess">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Warning: hide info, show exclamation -->
    <Style Selector="feedback|AuraMessage:warning Border.message-icon Path#IconInfo">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="feedback|AuraMessage:warning Border.message-icon Path#IconWarning">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Error: hide info, show X -->
    <Style Selector="feedback|AuraMessage:error Border.message-icon Path#IconInfo">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="feedback|AuraMessage:error Border.message-icon Path#IconError">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

</Styles>
