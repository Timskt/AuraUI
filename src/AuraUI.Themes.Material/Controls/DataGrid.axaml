<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- Material Design 3 — AuraDataGrid -->

    <Style Selector="display|AuraDataGrid">
        <Setter Property="Background" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="AreRowGroupHeadersFrozen" Value="True"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="True"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
    </Style>

    <!-- DataGridColumnHeader — Material Style -->
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontLabelLargeFamily}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ContentPresenter Grid.Column="0"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                        <Path Name="PART_SortIcon"
                              Grid.Column="1"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              Fill="{DynamicResource AuraForegroundSecondaryBrush}"
                              IsVisible="False"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ColumnHeader :pointerover -->


    <!-- ColumnHeader :sorted -->
    <Style Selector="DataGridColumnHeader:sorted /template/ Path#PART_SortIcon">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- DataGridRow — Material Style -->
    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <!-- DataGridRow :pointerover -->
    <Style Selector="DataGridRow:pointerover">
        <Setter Property="Opacity" Value="0.92"/>
    </Style>

    <!-- DataGridRow :selected -->
    <Style Selector="DataGridRow:selected">
        <Setter Property="Background" Value="{DynamicResource AuraSecondaryContainerBrush}"/>
    </Style>

    <!-- DataGridCell — Material Style -->
    <Style Selector="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- DataGridCell :selected -->
    <Style Selector="DataGridCell:selected">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
    </Style>

    <!-- DataGridCell :focus -->
    <Style Selector="DataGridCell:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraFocusBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- DataGridRowHeader — Material Style -->
    <Style Selector="DataGridRowHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

</Styles>
