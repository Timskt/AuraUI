<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="clr-namespace:AuraUI.Controls.Selection;assembly=AuraUI.Controls">

    <!-- Material Design 3 — ColorPicker -->

    <Style Selector="selection|ColorPicker">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraDialogCornerRadius}"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="MinWidth" Value="280"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="selection:ColorPicker">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <Panel>
                            <Border Name="StateLayer"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <StackPanel Spacing="16">
                                <!-- Color spectrum -->
                                <Border Name="PART_Spectrum"
                                        Width="256"
                                        Height="200"
                                        CornerRadius="{DynamicResource AuraRadiusSm}"
                                        ClipToBounds="True"
                                        Cursor="Crosshair"
                                        Background="{DynamicResource AuraMutedBrush}"/>

                                <!-- Color preview and hex input row -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <Border Name="PART_ColorPreview"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="{DynamicResource AuraRadiusFull}"
                                            Background="{DynamicResource AuraPrimaryBrush}"
                                            BorderBrush="{DynamicResource AuraOutlineBrush}"
                                            BorderThickness="1"/>
                                    <TextBox Name="PART_HexInput"
                                             Grid.Column="1"
                                             Watermark="#RRGGBB"
                                             FontFamily="Consolas, monospace"
                                             Classes="outlined"
                                             VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Hue slider -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Hue"
                                               FontSize="12"
                                               Foreground="{DynamicResource AuraForegroundSecondaryBrush}"/>
                                    <Slider Name="PART_HueSlider"
                                            Minimum="0"
                                            Maximum="360"
                                            Value="0"/>
                                </StackPanel>

                                <!-- Alpha slider -->
                                <StackPanel Name="PART_AlphaSection"
                                            Spacing="4">
                                    <TextBlock Text="Alpha"
                                               FontSize="12"
                                               Foreground="{DynamicResource AuraForegroundSecondaryBrush}"/>
                                    <Slider Name="PART_AlphaSlider"
                                            Minimum="0"
                                            Maximum="255"
                                            Value="255"/>
                                </StackPanel>

                                <!-- RGB sliders -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Red"
                                               FontSize="12"
                                               Foreground="{DynamicResource AuraForegroundSecondaryBrush}"/>
                                    <Slider Name="PART_RedSlider"
                                            Minimum="0"
                                            Maximum="255"
                                            Value="0"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Green"
                                               FontSize="12"
                                               Foreground="{DynamicResource AuraForegroundSecondaryBrush}"/>
                                    <Slider Name="PART_GreenSlider"
                                            Minimum="0"
                                            Maximum="255"
                                            Value="0"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Blue"
                                               FontSize="12"
                                               Foreground="{DynamicResource AuraForegroundSecondaryBrush}"/>
                                    <Slider Name="PART_BlueSlider"
                                            Minimum="0"
                                            Maximum="255"
                                            Value="0"/>
                                </StackPanel>

                                <!-- Preset colors -->
                                <ItemsControl Name="PART_PresetPanel"
                                              Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="32"
                                                    Height="32"
                                                    CornerRadius="16"
                                                    Margin="4"
                                                    Cursor="Hand"
                                                    BorderBrush="{DynamicResource AuraOutlineBrush}"
                                                    BorderThickness="1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.200"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Spectrum hover -->
    <Style Selector="selection|ColorPicker /template/ Border#PART_Spectrum:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Hide alpha when ShowAlpha is false -->
    <Style Selector="selection|ColorPicker:not(:has-alpha) /template/ StackPanel#PART_AlphaSection">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Compact mode -->
    <Style Selector="selection|ColorPicker:compact /template/ Border#PART_Spectrum">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="selection|ColorPicker:disabled">
        <Setter Property="Opacity" Value="0.38"/>
    </Style>

</Styles>
