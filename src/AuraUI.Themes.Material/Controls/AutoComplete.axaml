<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:AuraUI.Controls.Input;assembly=AuraUI.Controls">

    <!-- Material Design 3 — AutoComplete -->

    <Style Selector="input|AutoComplete">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,0"/>
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraTextFieldHeight}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyLargeFamily}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Panel>
                        <TextBox Name="PART_TextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Watermark="{TemplateBinding Placeholder}"
                                 Padding="16,12"
                                 FontSize="16"
                                 FontFamily="{DynamicResource AuraFontBodyLargeFamily}"
                                 VerticalAlignment="Stretch"/>
                        <Popup Name="PART_Popup"
                               IsLightDismissEnabled="True"
                               Placement="BottomEdgeAlignedLeft"
                               MaxHeight="300">
                            <Border Background="{DynamicResource AuraSurfaceBrush}"
                                    BorderBrush="{DynamicResource AuraOutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource AuraRadiusSm}"
                                    BoxShadow="{DynamicResource AuraShadowLevel2}"
                                    Padding="0">
                                <ListBox Name="PART_SuggestionsList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MaxHeight="250"/>
                            </Border>
                        </Popup>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.200"/>
                <BrushTransition Property="Background" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="input|AutoComplete:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Focused -->
    <Style Selector="input|AutoComplete:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <!-- Outlined variant -->
    <Style Selector="input|AutoComplete.outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusSm}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="input|AutoComplete:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

</Styles>
