<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feedback="clr-namespace:AuraUI.Controls.Feedback;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Tour -->

    <Style Selector="feedback|Tour">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="feedback:Tour">
                    <Panel>
                        <!-- Overlay -->
                        <Border Name="PART_Overlay"
                                Background="#80000000"
                                IsVisible="False"/>
                        <!-- Tooltip -->
                        <Border Name="PART_Tooltip"
                                Background="{DynamicResource AuraSurfaceBrush}"
                                CornerRadius="{DynamicResource AuraRadiusMd}"
                                BoxShadow="0 4 8 3 #26000000, 0 1 3 0 #4D000000"
                                Padding="16"
                                MinWidth="240"
                                MaxWidth="360"
                                IsVisible="False">
                            <StackPanel Spacing="12">
                                <!-- Step title -->
                                <TextBlock Name="PART_Title"
                                           FontSize="16"
                                           FontWeight="Medium"
                                           FontFamily="{DynamicResource AuraFontTitleMediumFamily}"
                                           TextWrapping="Wrap"/>
                                <!-- Step description -->
                                <TextBlock Name="PART_Description"
                                           FontSize="14"
                                           Foreground="{DynamicResource AuraForegroundSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <!-- Navigation -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Button Name="PART_CloseButton"
                                            Grid.Column="0"
                                            Classes="icon"
                                            Width="32" Height="32"
                                            Margin="0,0,8,0">
                                        <Path Data="M 8,8 L 16,16 M 16,8 L 8,16"
                                              Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                              StrokeThickness="1.5"
                                              Width="12" Height="12"/>
                                    </Button>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <Button Name="PART_PreviousButton"
                                                Classes="text"
                                                Content="Previous"/>
                                        <Button Name="PART_NextButton"
                                                Content="Next"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tour :open -->
    <Style Selector="feedback|Tour:open /template/ Border#PART_Overlay">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="feedback|Tour:open /template/ Border#PART_Tooltip">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

</Styles>
