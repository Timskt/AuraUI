<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:AuraUI.Controls.Input;assembly=AuraUI.Controls">

    <!-- Material Design 3 — MaskedTextBox -->

    <Style Selector="input|MaskedTextBox">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,0"/>
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraTextFieldHeight}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Consolas, monospace"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="#296750A4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="input:MaskedTextBox">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel>
                            <Border Name="StateLayer"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <Grid Margin="{TemplateBinding Padding}">
                                <TextBlock Name="PART_Watermark"
                                           Text="{TemplateBinding Watermark}"
                                           Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           IsVisible="False"/>
                                <ScrollViewer Name="PART_ScrollViewer"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden">
                                    <TextPresenter Name="PART_TextPresenter"
                                                   Text="{TemplateBinding Text, Mode=TwoWay}"
                                                   CaretBrush="{TemplateBinding CaretBrush}"
                                                   SelectionBrush="{TemplateBinding SelectionBrush}"/>
                                </ScrollViewer>
                            </Grid>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.200"/>
                <BrushTransition Property="Background" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Bottom border line -->
    <Style Selector="input|MaskedTextBox /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
    </Style>

    <!-- Hover state layer -->


    <!-- Focused -->
    <!-- Hover -->
    <Style Selector="input|MaskedTextBox:pointerover /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Focused -->
    <Style Selector="input|MaskedTextBox:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="input|MaskedTextBox:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundDisabledBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Outlined variant -->
    <Style Selector="input|MaskedTextBox.outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusSm}"/>
    </Style>

    <Style Selector="input|MaskedTextBox.outlined:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

</Styles>
