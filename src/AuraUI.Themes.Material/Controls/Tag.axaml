<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AuraUI.Controls.Layout;assembly=AuraUI.Controls">

    <!-- ========================================
         Material Design 3 — Tag (Chip)
         Variants: .default, .primary, .success, .warning, .error, .outlined
         ======================================== -->

    <Style Selector="layout|Tag">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraChipCornerRadius}"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontLabelLargeFamily}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraChipHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CloseIconForeground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="CloseButtonSize" Value="10"/>
        <Setter Property="CloseButtonHoverBackground" Value="{DynamicResource AuraPressedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="layout:Tag">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <Panel>
                        <Border Name="StateLayer"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <!-- Icon -->
                            <ContentPresenter Name="PART_IconPresenter"
                                              Content="{TemplateBinding Icon}"
                                              ContentTemplate="{TemplateBinding IconTemplate}"
                                              IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <!-- Text -->
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center"/>
                            <!-- Close button -->
                            <Button Name="PART_CloseButton"
                                    Content="&#x2715;"
                                    Classes="icon"
                                    Width="18"
                                    Height="18"
                                    Padding="0"
                                    FontSize="10"
                                    IsVisible="False"/>
                        </StackPanel>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover state layer -->
    <Style Selector="layout|Tag:pointerover /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Pressed -->
    <Style Selector="layout|Tag:pressed /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraPressedBrush}"/>
    </Style>

    <!-- Closable — show close button -->
    <Style Selector="layout|Tag:closable /template/ Button#PART_CloseButton">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Variant: Default (filled with surface) -->
    <Style Selector="layout|Tag:default">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
    </Style>

    <!-- Variant: Primary -->
    <Style Selector="layout|Tag:primary">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryContainerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraOnPrimaryContainerBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Variant: Success -->
    <Style Selector="layout|Tag:success">
        <Setter Property="Background" Value="#1A2E7D32"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraSuccessBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Variant: Warning -->
    <Style Selector="layout|Tag:warning">
        <Setter Property="Background" Value="#1AED6C02"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraWarningBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Variant: Error -->
    <Style Selector="layout|Tag:error">
        <Setter Property="Background" Value="{DynamicResource AuraErrorContainerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraOnErrorContainerBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Variant: Outlined -->
    <Style Selector="layout|Tag:outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
    </Style>

</Styles>
