<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:AuraUI.Controls.Input;assembly=AuraUI.Controls">

    <!-- Material Design 3 — PasswordBox -->

    <Style Selector="input|AuraPasswordBox">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyLargeFamily}"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraTextFieldHeight}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="PasswordChar" Value="*"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="input:AuraPasswordBox">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel>
                            <!-- State layer -->
                            <Border Name="StateLayer"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>

                            <DockPanel Margin="{TemplateBinding Padding}">
                                <!-- Reveal / hide toggle button -->
                                <Button Name="PART_RevealButton"
                                        DockPanel.Dock="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8,0"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Focusable="False">
                                    <Path Width="16" Height="16"
                                          Data="M 8,3 C 4,3 1,8 1,8 C 1,8 4,13 8,13 C 12,13 15,8 15,8 C 15,8 12,3 8,3 M 8,5.5 A 2.5,2.5 0 1,1 8,10.5 A 2.5,2.5 0 1,1 8,5.5"
                                          Stroke="{DynamicResource AuraForegroundTertiaryBrush}"
                                          StrokeThickness="1.2"
                                          Stretch="Uniform"/>
                                </Button>

                                <!-- Text input area -->
                                <Panel>
                                    <TextBlock Name="PART_Watermark"
                                               Text="{TemplateBinding Watermark}"
                                               Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               IsVisible="False"/>
                                    <ScrollViewer Name="PART_ScrollViewer"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden">
                                        <TextPresenter Name="PART_TextPresenter"
                                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                                       CaretBrush="{TemplateBinding CaretBrush}"
                                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                                       TextAlignment="{TemplateBinding TextAlignment}"
                                                       SelectionStart="{TemplateBinding SelectionStart}"
                                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                                       CaretIndex="{TemplateBinding CaretIndex}"
                                                       PasswordChar="{TemplateBinding PasswordChar}"
                                                       RevealPassword="{TemplateBinding RevealPassword}"/>
                                    </ScrollViewer>
                                </Panel>
                            </DockPanel>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.200"/>
                <BrushTransition Property="Background" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="input|AuraPasswordBox:pointerover /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Focused -->
    <Style Selector="input|AuraPasswordBox:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="input|AuraPasswordBox:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundDisabledBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Reveal button styles -->
    <Style Selector="input|AuraPasswordBox /template/ Button#PART_RevealButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>


    <!-- Outlined variant -->
    <Style Selector="input|AuraPasswordBox.outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusSm}"/>
    </Style>

    <Style Selector="input|AuraPasswordBox.outlined:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

</Styles>
