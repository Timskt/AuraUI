<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:AuraUI.Controls.Input;assembly=AuraUI.Controls">

    <!-- Material Design 3 — PasswordBox -->

    <Style Selector="input|AuraPasswordBox">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="#296750A4"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyLargeFamily}"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraTextFieldHeight}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,0"/>
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Hover -->
    <Style Selector="input|AuraPasswordBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Focused -->
    <Style Selector="input|AuraPasswordBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="input|AuraPasswordBox:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundDisabledBrush}"/>
    </Style>

    <!-- Outlined variant -->
    <Style Selector="input|AuraPasswordBox.outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusSm}"/>
    </Style>

    <Style Selector="input|AuraPasswordBox.outlined:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

</Styles>
