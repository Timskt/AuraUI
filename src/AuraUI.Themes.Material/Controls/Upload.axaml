<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:AuraUI.Controls.Input;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Upload -->

    <Style Selector="input|Upload">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="input:Upload">
                    <Border Background="{TemplateBinding Background}"
                            Padding="4">
                        <DockPanel>
                            <!-- Upload trigger area -->
                            <Border DockPanel.Dock="Top"
                                    Name="PART_DropZone"
                                    BorderBrush="{DynamicResource AuraOutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource AuraRadiusMd}"
                                    Padding="16"
                                    Background="Transparent">
                                <StackPanel Spacing="8"
                                            HorizontalAlignment="Center">
                                    <Path Data="M 12,4 L 12,16 M 6,10 L 12,4 L 18,10"
                                          Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                          StrokeThickness="2"
                                          Width="24" Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click or drag files to upload"
                                               Foreground="{DynamicResource AuraForegroundSecondaryBrush}"
                                               FontSize="14"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Upload button -->
                            <Button Name="PART_UploadButton"
                                    DockPanel.Dock="Top"
                                    Classes="text"
                                    Content="Browse Files"
                                    Margin="0,8,0,0"
                                    IsVisible="False"/>
                            <!-- File list -->
                            <ItemsControl Name="PART_FileList"
                                          Margin="0,8,0,0"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Disabled -->
    <Style Selector="input|Upload:disabled">
        <Setter Property="Opacity" Value="0.38"/>
    </Style>

</Styles>
