<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:AuraUI.Controls.Display;assembly=AuraUI.Controls">

    <!-- Material Design 3 — ProgressRing (Circular) -->

    <Style Selector="display|ProgressRing">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryContainerBrush}"/>
        <Setter Property="StrokeWidth" Value="4"/>
    </Style>

    <!-- Small size -->
    <Style Selector="display|ProgressRing:small">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>

    <!-- Large size -->
    <Style Selector="display|ProgressRing:large">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
    </Style>

</Styles>
