<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================
         Material Design 3 — Breadcrumb
         ======================================== -->

    <Style Selector="Breadcrumb">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Breadcrumb">
                    <ItemsControl Name="PART_ItemsControl"
                                  ItemsSource="{TemplateBinding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="0"
                                            VerticalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Breadcrumb item -->
    <Style Selector="BreadcrumbItem">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BreadcrumbItem">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Name="PART_Separator"
                                   Text="/"
                                   Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Name="StateLayer"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="BreadcrumbItem:pointerover /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Active (current page) -->
    <Style Selector="BreadcrumbItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
    </Style>

</Styles>
