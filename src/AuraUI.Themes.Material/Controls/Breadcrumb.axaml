<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="clr-namespace:AuraUI.Controls.Navigation;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Breadcrumb -->

    <Style Selector="navigation|Breadcrumb">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
    </Style>

    <!-- Breadcrumb item -->
    <Style Selector="navigation|BreadcrumbItem">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="navigation:BreadcrumbItem">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Name="PART_Separator"
                                   Text="{TemplateBinding SeparatorText}"
                                   Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Name="StateLayer"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover — text color change only -->
    <Style Selector="navigation|BreadcrumbItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Active (current page) -->
    <Style Selector="navigation|BreadcrumbItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
    </Style>

</Styles>
