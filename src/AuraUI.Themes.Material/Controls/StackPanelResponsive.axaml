<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout">

    <!-- StackPanelResponsive — Material Style -->
    <Style Selector="layout|StackPanelResponsive">
        <Setter Property="Spacing" Value="8"/>
    </Style>

</Styles>
