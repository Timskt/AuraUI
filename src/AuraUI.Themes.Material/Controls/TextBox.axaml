<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material Design 3 — TextBox (Filled & Outlined) -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyLargeFamily}"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraTextFieldHeight}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel>
                            <!-- State layer (hover/press) -->
                            <Border Name="StateLayer"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>

                            <!-- Content area -->
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <!-- Prefix -->
                                <ContentPresenter Name="PART_PrefixPresenter"
                                                  DockPanel.Dock="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"/>
                                <!-- Suffix -->
                                <ContentPresenter Name="PART_SuffixPresenter"
                                                  DockPanel.Dock="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="4,0,0,0"/>
                                <!-- Clear button -->
                                <Button Name="PART_ClearButton"
                                        DockPanel.Dock="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,0"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        IsVisible="False">
                                    <Path Width="10" Height="10"
                                          Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                          Stroke="{DynamicResource AuraForegroundTertiaryBrush}"
                                          StrokeThickness="1.5"/>
                                </Button>
                                <!-- Character count -->
                                <TextBlock Name="PART_CharacterCount"
                                           DockPanel.Dock="Bottom"
                                           FontSize="11"
                                           Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,4"
                                           IsVisible="False"/>
                                <!-- Text input area -->
                                <Panel>
                                    <!-- Watermark / placeholder -->
                                    <TextBlock Name="PART_Watermark"
                                               Text="{TemplateBinding Watermark}"
                                               Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               IsVisible="False"/>
                                    <ScrollViewer Name="PART_ScrollViewer"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden">
                                        <TextPresenter Name="PART_TextPresenter"
                                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                                       CaretBrush="{TemplateBinding CaretBrush}"
                                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                                       TextAlignment="{TemplateBinding TextAlignment}"
                                                       SelectionStart="{TemplateBinding SelectionStart}"
                                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                                       CaretIndex="{TemplateBinding CaretIndex}"/>
                                    </ScrollViewer>
                                </Panel>
                            </DockPanel>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.200"/>
                <BrushTransition Property="Background" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Filled style (default Material filled text field) -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- Bottom border line (filled style) -->
    <Style Selector="TextBox /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
    </Style>

    <!-- Hover -->
    <Style Selector="TextBox:pointerover /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Focused -->
    <Style Selector="TextBox:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundDisabledBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Outlined Variant (.outlined) -->
    <Style Selector="TextBox.outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusSm}"/>
    </Style>

    <Style Selector="TextBox.outlined:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Error state -->
    <Style Selector="TextBox:error">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>

    <Style Selector="TextBox:error:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>

</Styles>
