<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================
         Material Design 3 — ProgressBar (Linear)
         ======================================== -->

    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MinHeight="{TemplateBinding MinHeight}"
                            ClipToBounds="True">
                        <!-- Indicator bar -->
                        <Border Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                HorizontalAlignment="Left"
                                MinHeight="{TemplateBinding MinHeight}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indeterminate (animated sliding) -->
    <Style Selector="ProgressBar:indeterminate /template/ Border#PART_Indicator">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Width" Value="100"/>
        <Style.Animations>
            <Animation Duration="00:00:02.000"
                       IterationCount="Infinite"
                       Easing="LinearEasing">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.X" Value="-200"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.X" Value="500"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Color variants -->
    <Style Selector="ProgressBar.success">
        <Setter Property="Foreground" Value="{DynamicResource AuraSuccessBrush}"/>
    </Style>
    <Style Selector="ProgressBar.warning">
        <Setter Property="Foreground" Value="{DynamicResource AuraWarningBrush}"/>
    </Style>
    <Style Selector="ProgressBar.error">
        <Setter Property="Foreground" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>
    <Style Selector="ProgressBar.info">
        <Setter Property="Foreground" Value="{DynamicResource AuraInfoBrush}"/>
    </Style>

    <!-- Thin variant -->
    <Style Selector="ProgressBar.thin">
        <Setter Property="MinHeight" Value="2"/>
    </Style>

</Styles>
