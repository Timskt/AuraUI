<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material Design 3 — ComboBox (Dropdown) -->

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraTextFieldHeight}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyLargeFamily}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Panel>
                            <!-- State layer -->
                            <Border Name="StateLayer"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <!-- Selection box area -->
                                <Border Grid.Column="0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter Name="PART_ContentPresenter"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>

                                <!-- Dropdown toggle -->
                                <Border Name="PART_DropdownGlyph"
                                        Grid.Column="1"
                                        Width="48"
                                        Background="Transparent"
                                        VerticalAlignment="Stretch">
                                    <Path Name="Chevron"
                                          Width="12" Height="12"
                                          Data="M 1,4 L 6,9 L 11,4"
                                          Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                          StrokeThickness="1.5"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5"/>
                                </Border>
                            </Grid>

                            <!-- Dropdown popup -->
                            <Popup Name="PART_Popup"
                                   IsLightDismissEnabled="True"
                                   Placement="BottomEdgeAlignedLeft"
                                   MaxHeight="300">
                                <Border Name="PART_DropdownBorder"
                                        Background="{DynamicResource AuraSurfaceBrush}"
                                        BorderBrush="{DynamicResource AuraOutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource AuraRadiusMd}"
                                        Padding="4"
                                        BoxShadow="0 4 8 3 #26000000, 0 1 3 0 #4D000000">
                                    <DockPanel>
                                        <!-- Search box (shown when IsSearchable) -->
                                        <TextBox Name="PART_SearchBox"
                                                 DockPanel.Dock="Top"
                                                 Margin="4,4,4,8"
                                                 FontSize="14"
                                                 Watermark="Search..."
                                                 IsVisible="False"/>
                                        <ScrollViewer>
                                            <ItemsPresenter Name="PART_ItemsPresenter"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.200"/>
                <BrushTransition Property="Background" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="ComboBox:pointerover /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Focused / Open -->
    <Style Selector="ComboBox:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Expanded -->
    <Style Selector="ComboBox:expanded /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Outlined variant -->
    <Style Selector="ComboBox.outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusSm}"/>
    </Style>

    <Style Selector="ComboBox.outlined:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- ComboBoxItem -->
    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyLargeFamily}"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Name="RootBorder"
                            Background="Transparent"
                            CornerRadius="{DynamicResource AuraRadiusNone}"
                            ClipToBounds="True">
                        <Panel>
                            <Border Name="StateLayer"
                                    Background="Transparent"/>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="ComboBoxItem:pointerover /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Pressed -->
    <Style Selector="ComboBoxItem:pressed /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraPressedBrush}"/>
    </Style>

    <!-- Selected -->
    <Style Selector="ComboBoxItem:selected /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraSelectedBrush}"/>
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

</Styles>
