<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:AuraUI.Controls.Input;assembly=AuraUI.Controls">

    <!-- Material Design 3 — NumericUpDown -->

    <Style Selector="input|AuraNumericUpDown">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraTextFieldHeight}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyLargeFamily}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="input:AuraNumericUpDown">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Panel>
                            <!-- State layer -->
                            <Border Name="StateLayer"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <!-- Text area -->
                                <TextBox Name="PART_TextBox"
                                         Grid.Column="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CornerRadius="0"
                                         Padding="16,8"
                                         FontSize="{TemplateBinding FontSize}"
                                         VerticalAlignment="Stretch"/>

                                <!-- Spin buttons -->
                                <DockPanel Grid.Column="1"
                                           LastChildFill="False"
                                           Margin="0,4"
                                           Width="40">
                                    <Button Name="PART_IncreaseButton"
                                            DockPanel.Dock="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="0"
                                            Padding="0"
                                            VerticalAlignment="Top">
                                        <Path Width="10" Height="6"
                                              Data="M 1,5 L 5,1 L 9,5"
                                              Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                              StrokeThickness="1.5"/>
                                    </Button>
                                    <Border Width="1" Background="{DynamicResource AuraDividerBrush}"/>
                                    <Button Name="PART_DecreaseButton"
                                            DockPanel.Dock="Bottom"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="0"
                                            Padding="0"
                                            VerticalAlignment="Bottom">
                                        <Path Width="10" Height="6"
                                              Data="M 1,1 L 5,5 L 9,1"
                                              Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                              StrokeThickness="1.5"/>
                                    </Button>
                                </DockPanel>
                            </Grid>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.200"/>
                <BrushTransition Property="Background" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="input|AuraNumericUpDown:pointerover /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
    </Style>

    <!-- Focused -->
    <Style Selector="input|AuraNumericUpDown:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="input|AuraNumericUpDown:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Spin button styles -->
    <Style Selector="input|AuraNumericUpDown /template/ Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="input|AuraNumericUpDown /template/ Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <Style Selector="input|AuraNumericUpDown /template/ Button:pressed">
        <Setter Property="Background" Value="{DynamicResource AuraPressedBrush}"/>
    </Style>

</Styles>
