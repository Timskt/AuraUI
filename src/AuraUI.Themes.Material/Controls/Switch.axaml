<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material Design 3 — Switch -->

    <Style Selector="ToggleSwitch">
        <Setter Property="MinWidth" Value="52"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Hover state layer -->
    <Style Selector="ToggleSwitch:pointerover">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <!-- Checked (on) -->
    <Style Selector="ToggleSwitch:checked">
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="ToggleSwitch:disabled">
        <Setter Property="Opacity" Value="0.38"/>
    </Style>

</Styles>
