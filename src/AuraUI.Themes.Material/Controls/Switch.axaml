<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="using:AuraUI.Controls.Selection">

    <!-- ============================================================
         AuraUI Switch — Material Design 3
         ============================================================ -->
    <Style Selector="selection|Switch">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="TrackBackground" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="TrackCornerRadius" Value="16"/>
        <Setter Property="ThumbBackground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="ThumbSize" Value="16"/>
        <Setter Property="CheckedTrackBackground" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="CheckedThumbBackground" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="selection:Switch">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <!-- Track -->
                        <Border Name="PART_Track"
                                Width="52" Height="32"
                                CornerRadius="{TemplateBinding TrackCornerRadius}"
                                Background="{TemplateBinding TrackBackground}"
                                BorderBrush="{DynamicResource AuraBorderBrush}"
                                BorderThickness="2"
                                VerticalAlignment="Center">
                            <!-- Thumb -->
                            <Border Name="PART_Thumb"
                                    Width="{TemplateBinding ThumbSize}"
                                    Height="{TemplateBinding ThumbSize}"
                                    CornerRadius="999"
                                    Background="{TemplateBinding ThumbBackground}"
                                    Margin="8,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>
                        </Border>

                        <!-- Content -->
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="TrackBackground" Duration="0:0:0.200"/>
                <BrushTransition Property="ThumbBackground" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="selection|Switch:pointerover /template/ Border#PART_Track">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
    </Style>

    <!-- Checked (on) -->
    <Style Selector="selection|Switch:checked /template/ Border#PART_Track">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <Style Selector="selection|Switch:checked /template/ Border#PART_Thumb">
        <Setter Property="Margin" Value="28,0,8,0"/>
        <Setter Property="Background" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <!-- Pressed: knob grows slightly (M3 tactile feedback) -->
    <Style Selector="selection|Switch:pressed /template/ Border#PART_Thumb">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="selection|Switch:checked:pressed /template/ Border#PART_Thumb">
        <Setter Property="Margin" Value="24,0,8,0"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="selection|Switch:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Small -->
    <Style Selector="selection|Switch:small /template/ Border#PART_Track">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="selection|Switch:small /template/ Border#PART_Thumb">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Margin" Value="6,0"/>
    </Style>
    <Style Selector="selection|Switch:small:checked /template/ Border#PART_Thumb">
        <Setter Property="Margin" Value="22,0,6,0"/>
    </Style>

    <!-- Large -->
    <Style Selector="selection|Switch:large /template/ Border#PART_Track">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="36"/>
    </Style>
    <Style Selector="selection|Switch:large /template/ Border#PART_Thumb">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="8,0"/>
    </Style>
    <Style Selector="selection|Switch:large:checked /template/ Border#PART_Thumb">
        <Setter Property="Margin" Value="32,0,8,0"/>
    </Style>

    <!-- ============================================================
         ToggleSwitch — Material Design 3 (base Avalonia control)
         ============================================================ -->

    <Style Selector="ToggleSwitch">
        <Setter Property="MinWidth" Value="52"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Panel Name="PART_MovingKnobs" Width="52" Height="32">
                            <!-- Track -->
                            <Border Name="PART_SwitchTrack"
                                    Width="52" Height="32"
                                    CornerRadius="16"
                                    Background="{DynamicResource AuraMutedBrush}"
                                    BorderBrush="{DynamicResource AuraBorderBrush}"
                                    BorderThickness="2"
                                    VerticalAlignment="Center">
                            </Border>

                            <!-- Knob -->
                            <Panel Name="PART_SwitchKnob">
                                <Border Name="PART_SwitchKnobBorder"
                                        Width="16" Height="16"
                                        CornerRadius="8"
                                        Background="{DynamicResource AuraForegroundSecondaryBrush}"
                                        Margin="8,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                </Border>
                            </Panel>
                        </Panel>

                        <!-- On/Off labels -->
                        <TextBlock Name="PART_OnText"
                                   Text="On"
                                   VerticalAlignment="Center"
                                   IsVisible="False"/>
                        <TextBlock Name="PART_OffText"
                                   Text="Off"
                                   VerticalAlignment="Center"
                                   IsVisible="False"/>

                        <!-- Content -->
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hover: subtle border change -->
    <Style Selector="ToggleSwitch:pointerover /template/ Border#PART_SwitchTrack">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
    </Style>

    <!-- Checked (on) -->
    <Style Selector="ToggleSwitch:checked /template/ Border#PART_SwitchTrack">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <Style Selector="ToggleSwitch:checked /template/ Border#PART_SwitchKnobBorder">
        <Setter Property="Margin" Value="28,0,8,0"/>
        <Setter Property="Background" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <!-- Checked + hover -->
    <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#PART_SwitchTrack">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Pressed: knob grows slightly (M3 tactile feedback) -->
    <Style Selector="ToggleSwitch:pressed /template/ Border#PART_SwitchKnobBorder">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="ToggleSwitch:checked:pressed /template/ Border#PART_SwitchKnobBorder">
        <Setter Property="Margin" Value="24,0,8,0"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="ToggleSwitch:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="ToggleSwitch:disabled /template/ Border#PART_SwitchTrack">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
    </Style>

    <Style Selector="ToggleSwitch:disabled /template/ Border#PART_SwitchKnobBorder">
        <Setter Property="Background" Value="{DynamicResource AuraForegroundDisabledBrush}"/>
    </Style>

</Styles>
