<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AuraUI.Controls.Layout;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Accordion -->

    <Style Selector="layout|Accordion">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="layout:Accordion">
                    <Border Background="{TemplateBinding Background}">
                        <ItemsPresenter Name="PART_ItemsPresenter"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Material Design 3 — AccordionItem -->

    <Style Selector="layout|AccordionItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyLargeFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="layout:AccordionItem">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <StackPanel>
                            <!-- Header area -->
                            <ContentControl Name="PART_HeaderSite"
                                            Cursor="Hand"
                                            MinHeight="48">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <ContentPresenter Name="PART_IconPresenter"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding Tag}"
                                                      VerticalAlignment="Center"
                                                      Margin="16,0,12,0"/>
                                    <ContentPresenter Name="PART_HeaderPresenter"
                                                      Grid.Column="1"
                                                      Content="{TemplateBinding Header}"
                                                      VerticalAlignment="Center"/>
                                    <Border Name="PART_ChevronContainer"
                                            Grid.Column="2"
                                            Width="24" Height="24"
                                            CornerRadius="12"
                                            Background="Transparent"
                                            VerticalAlignment="Center"
                                            Margin="12,0,16,0">
                                        <Path Name="PART_Chevron"
                                              Data="M 6,9 L 12,15 L 18,9"
                                              Stroke="{DynamicResource AuraOnSurfaceVariantBrush}"
                                              StrokeThickness="2"
                                              Width="12" Height="6"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                </Grid>
                            </ContentControl>

                            <!-- Expand content area -->
                            <ContentControl Name="PART_ExpandSite"
                                            IsVisible="False">
                                <Border Padding="16,0,52,16">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                </Border>
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <DoubleTransition Duration="0:0:0.200" Property="Opacity" Easing="{DynamicResource AuraEasingStandard}"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover header -->


    <!-- Pressed header -->

    <!-- Chevron hover -->


    <!-- Expanded state — rotate chevron 180 degrees -->
    <Style Selector="layout|AccordionItem:expanded /template/ Path#PART_Chevron">
        <Setter Property="RenderTransform">
            <RotateTransform Angle="180"/>
        </Setter>
    </Style>

    <!-- First item: top border and corner radius -->
    <Style Selector="layout|AccordionItem:first-child">
        <Setter Property="BorderThickness" Value="1,1,1,1"/>
        <Setter Property="CornerRadius" Value="12,12,0,0"/>
    </Style>

    <!-- Last item: bottom border and corner radius -->
    <Style Selector="layout|AccordionItem:last-child">
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="CornerRadius" Value="0,0,12,12"/>
    </Style>


    <!-- ============================================================ -->
    <!-- CodexSwitchUI: Opacity-based interaction states              -->
    <!-- ============================================================ -->
    <Style Selector="layout|AccordionItem:pressed">
        <Setter Property="Opacity" Value="0.86"/>
        <Setter Property="ScaleTransform.ScaleX" Value="0.98"/>
        <Setter Property="ScaleTransform.ScaleY" Value="0.98"/>
    </Style>

</Styles>
