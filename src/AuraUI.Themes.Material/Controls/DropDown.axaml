<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AuraUI.Controls.Layout;assembly=AuraUI.Controls">

    <!-- ========================================
         Material Design 3 — DropDown
         ======================================== -->

    <Style Selector="layout|DropDown">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="DropDownCornerRadius" Value="4"/>
        <Setter Property="DropDownShadow" Value="0 2 6 0 #20000000, 0 8 24 0 #15000000"/>
        <Setter Property="OverlayBrush" Value="{DynamicResource AuraOverlayBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="layout:DropDown">
                    <Panel>
                        <!-- Anchor content -->
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>

                        <!-- Popup -->
                        <Popup Name="PART_Popup"
                               IsLightDismissEnabled="{Binding !StaysOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               IsOpen="{TemplateBinding IsOpen}"
                               Placement="BottomEdgeAlignedLeft"
                               MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <Border Name="PART_DropdownBorder"
                                    Background="{DynamicResource AuraSurfaceBrush}"
                                    CornerRadius="{TemplateBinding DropDownCornerRadius}"
                                    BoxShadow="{TemplateBinding DropDownShadow}"
                                    ClipToBounds="True"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Transitions>
                                    <BrushTransition Duration="0:0:0.200" Property="Background"/>
                                    <BoxShadowsTransition Duration="0:0:0.200" Property="BoxShadow"/>
                                </Border.Transitions>
                                <ScrollViewer>
                                    <ContentPresenter Content="{TemplateBinding DropDownContent}"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Panel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hover state -->
    <Style Selector="layout|DropDown:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Open state — elevate -->
    <Style Selector="layout|DropDown:open /template/ Popup Border">
        <Setter Property="BoxShadow" Value="0 4 12 0 #20000000, 0 16 40 0 #15000000"/>
    </Style>

</Styles>
