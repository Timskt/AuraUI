<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AuraUI.Controls.Layout;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Avatar -->

    <Style Selector="layout|Avatar">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryContainerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraOnPrimaryContainerBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontTitleMediumFamily}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="layout:Avatar">
                    <Border Name="RootBorder"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Panel>
                            <!-- Image (shown when Source is set) -->
                            <Image Name="PART_Image"
                                   Source="{TemplateBinding Source}"
                                   Stretch="UniformToFill"
                                   IsVisible="False"/>
                            <!-- Fallback text (shown when no image) -->
                            <TextBlock Name="PART_Fallback"
                                       Text="{TemplateBinding FallbackText}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Size: Small (via pseudo-class from control) -->
    <Style Selector="layout|Avatar:small">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Size: Medium (default) -->
    <Style Selector="layout|Avatar:medium">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Size: Large -->
    <Style Selector="layout|Avatar:large">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="FontSize" Value="22"/>
    </Style>

    <!-- Size: XL -->
    <Style Selector="layout|Avatar:xl">
        <Setter Property="Width" Value="72"/>
        <Setter Property="Height" Value="72"/>
        <Setter Property="FontSize" Value="28"/>
    </Style>

    <!-- Shape: Square -->
    <Style Selector="layout|Avatar:square">
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
    </Style>

</Styles>
