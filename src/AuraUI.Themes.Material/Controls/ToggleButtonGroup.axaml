<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="clr-namespace:AuraUI.Controls.Selection;assembly=AuraUI.Controls">

    <!-- ========================================
         Material Design 3 — ToggleButtonGroup
         ======================================== -->

    <Style Selector="selection|ToggleButtonGroup">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="selection:ToggleButtonGroup">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <ItemsPresenter Name="PART_ItemsPresenter">
                            <ItemsPresenter.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsPresenter.ItemsPanel>
                        </ItemsPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>

    <!-- Individual buttons in group — flat, no borders -->
    <Style Selector="selection|ToggleButtonGroup /template/ ItemsPresenter ToggleButton">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

    <!-- First button gets left radius -->
    <Style Selector="selection|ToggleButtonGroup /template/ ItemsPresenter ToggleButton:nth-child(1)">
        <Setter Property="CornerRadius" Value="20,0,0,20"/>
    </Style>

    <!-- Last button gets right radius -->
    <Style Selector="selection|ToggleButtonGroup /template/ ItemsPresenter ToggleButton:last-child">
        <Setter Property="CornerRadius" Value="0,20,20,0"/>
    </Style>

    <!-- Checked button within group gets primary fill -->
    <Style Selector="selection|ToggleButtonGroup /template/ ItemsPresenter ToggleButton:checked">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryContainerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraOnPrimaryContainerBrush}"/>
    </Style>

    <!-- Hover on unchecked -->
    <Style Selector="selection|ToggleButtonGroup /template/ ItemsPresenter ToggleButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

</Styles>
