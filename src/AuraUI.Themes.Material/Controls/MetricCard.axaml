<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- MetricCard — Material Style -->
    <Style Selector="display|MetricCard">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraOnSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Border.Transitions>
                        <BrushTransition Duration="0:0:0.200" Property="Background"/>
                        <BrushTransition Duration="0:0:0.200" Property="BorderBrush"/>
                    </Border.Transitions>
                    <StackPanel Spacing="4">
                        <TextBlock Name="PART_Title"
                                   FontSize="12"
                                   Foreground="{DynamicResource AuraOnSurfaceVariantBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                            <TextBlock Name="PART_Value"
                                       FontSize="28"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource AuraOnSurfaceBrush}"/>
                            <TextBlock Name="PART_Unit"
                                       FontSize="13"
                                       Foreground="{DynamicResource AuraOnSurfaceVariantBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,4"/>
                        </StackPanel>
                        <StackPanel Name="PART_TrendRow"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="0,4,0,0">
                            <TextBlock Name="PART_TrendIcon"
                                       FontSize="12"
                                       Foreground="{DynamicResource AuraSuccessBrush}"/>
                            <TextBlock Name="PART_TrendValue"
                                       FontSize="12"
                                       Foreground="{DynamicResource AuraOnSurfaceVariantBrush}"/>
                        </StackPanel>
                        <Border Name="PART_SparklineBorder"
                                Height="32"
                                Margin="0,8,0,0"
                                IsVisible="False"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="display|MetricCard:pointerover /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowSm}"/>
    </Style>

    <Style Selector="display|MetricCard:disabled">
        <Setter Property="Opacity" Value="0.38"/>
    </Style>

</Styles>
