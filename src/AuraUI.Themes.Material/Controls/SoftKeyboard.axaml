<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="using:AuraUI.Controls.Input">

    <!-- SoftKeyboard — Material Style -->
    <Style Selector="input|SoftKeyboard">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceContainerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraOnSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Name="PART_KeyRows" Spacing="4"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="input|SoftKeyboard:disabled">
        <Setter Property="Opacity" Value="0.38"/>
    </Style>

</Styles>
