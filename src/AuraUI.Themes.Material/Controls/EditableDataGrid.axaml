<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:AuraUI.Controls.Display;assembly=AuraUI.Controls">

    <!-- Material Design 3 — EditableDataGrid -->

    <Style Selector="display|EditableDataGrid">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraOnSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="display:EditableDataGrid">
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            BoxShadow="{DynamicResource AuraShadowLevel1}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="PART_RowsPanel"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.200"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="display|EditableDataGrid:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Focus -->
    <Style Selector="display|EditableDataGrid:focus-visible /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraFocusBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Read-only -->
    <Style Selector="display|EditableDataGrid:readonly">
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="display|EditableDataGrid:disabled">
        <Setter Property="Opacity" Value="0.38"/>
    </Style>

</Styles>
