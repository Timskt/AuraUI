<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feedback="clr-namespace:AuraUI.Controls.Feedback;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Toast -->

    <Style Selector="feedback|AuraToast">
        <Setter Property="Background" Value="{DynamicResource AuraInverseSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraInverseOnSurfaceBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MaxWidth" Value="560"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="feedback:AuraToast">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource AuraRadiusSm}"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="{TemplateBinding MaxWidth}"
                            BoxShadow="0 4 8 3 #26000000, 0 1 3 0 #4D000000">
                        <Panel>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">
                                <!-- Message -->
                                <TextBlock Name="PART_Message"
                                           Text="{TemplateBinding Message}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Success variant -->
    <Style Selector="feedback|AuraToast.success">
        <Setter Property="Background" Value="#2E7D32"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Error variant -->
    <Style Selector="feedback|AuraToast.error">
        <Setter Property="Background" Value="#D32F2F"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Warning variant -->
    <Style Selector="feedback|AuraToast.warning">
        <Setter Property="Background" Value="#ED6C02"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Info variant -->
    <Style Selector="feedback|AuraToast.info">
        <Setter Property="Background" Value="#0288D1"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

</Styles>
