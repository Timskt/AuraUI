<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feedback="clr-namespace:AuraUI.Controls.Feedback;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Toast -->

    <Style Selector="feedback|AuraToast">
        <Setter Property="Background" Value="{DynamicResource AuraInverseSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraInverseOnSurfaceBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MaxWidth" Value="560"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="feedback:AuraToast">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource AuraRadiusSm}"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="{TemplateBinding MaxWidth}"
                            BoxShadow="{DynamicResource AuraShadowLevel3}"
                            ClipToBounds="True">
                        <DockPanel>
                            <!-- Close button -->
                            <Button Name="PART_CloseButton"
                                    DockPanel.Dock="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    Width="28" Height="28"
                                    Margin="8,0,-4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Cursor="Hand"
                                    IsVisible="{TemplateBinding ShowClose}">
                                <Path Width="10" Height="10"
                                      Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                      Stroke="{DynamicResource AuraInverseOnSurfaceBrush}"
                                      StrokeThickness="1.5"/>
                            </Button>

                            <!-- Icon -->
                            <ContentPresenter Name="PART_IconPresenter"
                                              DockPanel.Dock="Left"
                                              VerticalAlignment="Top"
                                              Margin="0,0,12,0"/>

                            <!-- Progress bar -->
                            <Border Name="PART_ProgressBar"
                                    DockPanel.Dock="Bottom"
                                    Height="3"
                                    CornerRadius="1.5"
                                    Background="{DynamicResource AuraPrimaryBrush}"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"/>

                            <!-- Content area -->
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding ToastTitle}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{TemplateBinding ToastTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="{TemplateBinding Message}"
                                           FontSize="14"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Success variant -->
    <Style Selector="feedback|AuraToast.success">
        <Setter Property="Background" Value="{DynamicResource AuraSuccessBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <!-- Error variant -->
    <Style Selector="feedback|AuraToast.error">
        <Setter Property="Background" Value="{DynamicResource AuraErrorBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <!-- Warning variant -->
    <Style Selector="feedback|AuraToast.warning">
        <Setter Property="Background" Value="{DynamicResource AuraWarningBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <!-- Info variant -->
    <Style Selector="feedback|AuraToast.info">
        <Setter Property="Background" Value="{DynamicResource AuraInfoBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
    </Style>

</Styles>
