<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="clr-namespace:AuraUI.Controls.Selection;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Cascader -->

    <Style Selector="selection|Cascader">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,0"/>
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraTextFieldHeight}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyLargeFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="selection:Cascader">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Panel>
                            <Border Name="StateLayer"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Name="PART_Input"
                                         Grid.Column="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Watermark="{TemplateBinding Placeholder}"
                                         Padding="16,8"
                                         VerticalAlignment="Stretch"/>
                                <Border Grid.Column="1"
                                        Width="48"
                                        Background="Transparent"
                                        VerticalAlignment="Stretch">
                                    <Path Width="12" Height="12"
                                          Data="M 1,4 L 6,9 L 11,4"
                                          Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                          StrokeThickness="1.5"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Popup Name="PART_Dropdown"
                                   IsLightDismissEnabled="True"
                                   Placement="BottomEdgeAlignedLeft"
                                   MaxHeight="400">
                                <Border Background="{DynamicResource AuraSurfaceBrush}"
                                        BorderBrush="{DynamicResource AuraOutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource AuraRadiusMd}"
                                        BoxShadow="{DynamicResource AuraShadowLevel3}"
                                        Padding="4">
                                    <ScrollViewer>
                                        <StackPanel/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.200"/>
                <BrushTransition Property="Background" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="selection|Cascader:pointerover /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
    </Style>

    <!-- Focused / Open -->
    <Style Selector="selection|Cascader:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <!-- Outlined variant -->
    <Style Selector="selection|Cascader.outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusSm}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="selection|Cascader:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

</Styles>
