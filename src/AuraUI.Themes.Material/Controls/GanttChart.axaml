<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- GanttChart — Material Style (Control-based) -->
    <Style Selector="display|GanttChart">
        <Setter Property="Opacity" Value="1"/>
    </Style>

</Styles>
