<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AuraUI.Controls.Layout;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Resizable -->
    <Style Selector="layout|Resizable">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource AuraRadiusMd}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="layout|Resizable.horizontal">
        <Setter Property="Cursor" Value="SizeWestEast"/>
    </Style>

    <Style Selector="layout|Resizable.vertical">
        <Setter Property="Cursor" Value="SizeNorthSouth"/>
    </Style>

    <Style Selector="layout|Resizable.dragging">
        <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <Style Selector="layout|Resizable.disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

</Styles>
