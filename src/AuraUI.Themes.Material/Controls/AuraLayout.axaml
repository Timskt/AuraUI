<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout">

    <!-- ============================================================
         AuraLayout — Material Style
         ============================================================ -->
    <Style Selector="layout|AuraLayout">
        <Setter Property="Background" Value="{DynamicResource AuraBackgroundBrush}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*,Auto">
                    <ContentPresenter Grid.Row="0"
                                      Content="{TemplateBinding Header}"
                                      IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="{TemplateBinding SiderWidth}"
                                ClipToBounds="True"
                                IsVisible="{TemplateBinding HasSider}">
                            <ContentPresenter Content="{TemplateBinding Sider}"/>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Grid>
                    <ContentPresenter Grid.Row="2"
                                      Content="{TemplateBinding Footer}"
                                      IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
