<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AuraUI.Controls.Layout;assembly=AuraUI.Controls">

    <!-- ========================================
         Material Design 3 — Bubble
         ======================================== -->

    <Style Selector="layout|Bubble">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BubbleCornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BubbleShadow" Value="0 1 3 0 #20000000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="layout:Bubble">
                    <Panel>
                        <!-- Arrow -->
                        <Path Name="PART_Arrow"
                              Fill="{TemplateBinding Background}"
                              Stroke="Transparent"
                              StrokeThickness="0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="16,0,0,0"/>

                        <!-- Bubble body -->
                        <Border Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding BubbleCornerRadius}"
                                BoxShadow="{TemplateBinding BubbleShadow}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,8,0,8">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="layout|Bubble:arrow-top /template/ Path#PART_Arrow">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="layout|Bubble:arrow-bottom /template/ Path#PART_Arrow">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="layout|Bubble:arrow-left /template/ Path#PART_Arrow">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="layout|Bubble:arrow-right /template/ Path#PART_Arrow">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- Material Primary Container variant -->
    <Style Selector="layout|Bubble.accent">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryLightBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

</Styles>
