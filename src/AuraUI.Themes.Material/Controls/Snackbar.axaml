<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================
         Material Design 3 — Snackbar
         Positioned at bottom of screen.
         ======================================== -->

    <Style Selector="Snackbar">
        <Setter Property="Background" Value="{DynamicResource AuraInverseSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraInverseOnSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraSnackbarCornerRadius}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MaxWidth" Value="560"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Snackbar">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="{TemplateBinding MaxWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="16,0,16,16">
                        <Border.BoxShadow>
                            <BoxShadow BlurRadius="8"
                                       SpreadRadius="0"
                                       OffsetX="0"
                                       OffsetY="4"
                                       Color="#26000000"/>
                        </Border.BoxShadow>
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto">
                            <!-- Message -->
                            <TextBlock Name="PART_Message"
                                       Grid.Column="0"
                                       Grid.Row="0"
                                       Text="{TemplateBinding Message}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                            <!-- Action button (right side) -->
                            <Button Name="PART_ActionButton"
                                    Grid.Column="1"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Classes="text"
                                    Content="{TemplateBinding ActionText}"
                                    Foreground="{DynamicResource AuraInversePrimaryBrush}"
                                    VerticalAlignment="Center"
                                    Margin="8,0,-8,0"
                                    IsVisible="False"/>

                            <!-- Close button (below message) -->
                            <Button Name="PART_CloseButton"
                                    Grid.Column="0"
                                    Grid.Row="1"
                                    Classes="icon"
                                    Width="32"
                                    Height="32"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Left"
                                    IsVisible="False">
                                <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                      Stroke="{DynamicResource AuraInverseOnSurfaceBrush}"
                                      StrokeThickness="2"/>
                                      Width="12"
                                      Height="12"/>
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Multi-line variant -->
    <Style Selector="Snackbar.multiline">
        <Setter Property="MinHeight" Value="68"/>
    </Style>

</Styles>
