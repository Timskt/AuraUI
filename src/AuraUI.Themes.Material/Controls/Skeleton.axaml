<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AuraUI.Controls.Layout;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Skeleton Loading -->

    <Style Selector="layout|Skeleton">
        <Setter Property="BaseColor" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusSm}"/>
        <Setter Property="IsAnimated" Value="True"/>
    </Style>

    <!-- Circle skeleton (avatars, icons) -->
    <Style Selector="layout|Skeleton:circle">
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
    </Style>

    <!-- Text skeleton -->
    <Style Selector="layout|Skeleton:text">
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

</Styles>
