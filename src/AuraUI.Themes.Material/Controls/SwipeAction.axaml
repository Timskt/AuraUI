<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout">

    <!-- SwipeAction — Material Style -->
    <Style Selector="layout|SwipeAction">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel ClipToBounds="True">
                    <Border Name="PART_LeftActions"
                            Background="{DynamicResource AuraSuccessBrush}"
                            HorizontalAlignment="Left"
                            IsVisible="False">
                        <ContentPresenter Content="{TemplateBinding Tag}"
                                          Margin="16,0"/>
                    </Border>
                    <Border Name="PART_RightActions"
                            Background="{DynamicResource AuraErrorBrush}"
                            HorizontalAlignment="Right"
                            IsVisible="False">
                        <ContentPresenter Content="{TemplateBinding Tag}"
                                          Margin="16,0"/>
                    </Border>
                    <Border Name="PART_ContentBorder"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Duration="0:0:0.250" Property="TranslateTransform.X" Easing="{DynamicResource AuraEasingDecelerate}"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="layout|SwipeAction:left-revealed /template/ Border#PART_LeftActions">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="layout|SwipeAction:right-revealed /template/ Border#PART_RightActions">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

</Styles>
