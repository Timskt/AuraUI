<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material Design 3 — CheckBox -->

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <!-- Checkbox box -->
                        <Border Name="PART_Box"
                                Width="{DynamicResource AuraCheckboxSize}"
                                Height="{DynamicResource AuraCheckboxSize}"
                                CornerRadius="2"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource AuraForegroundBrush}"
                                Background="Transparent"
                                VerticalAlignment="Center">
                            <Panel>
                                <Border Name="StateLayer"
                                        Background="Transparent"
                                        CornerRadius="2"/>
                                <!-- Checkmark path -->
                                <Path Name="PART_CheckMark"
                                      Data="M 3.5,8.5 L 7,12 L 14.5,4.5"
                                      Stroke="Transparent"
                                      StrokeThickness="2"
                                      IsVisible="False"
                                      Margin="-1,-1,-1,-1"/>
                                <!-- Indeterminate mark -->
                                <Border Name="PART_IndeterminateMark"
                                        Width="10"
                                        Height="2"
                                        Background="Transparent"
                                        CornerRadius="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="False"/>
                            </Panel>
                        </Border>
                        <!-- Content -->
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover state layer -->
    <Style Selector="CheckBox:pointerover /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="Opacity" Value="0.08"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <!-- Pressed state layer -->
    <Style Selector="CheckBox:pressed /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="Opacity" Value="0.12"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <!-- Checked -->
    <Style Selector="CheckBox:checked /template/ Border#PART_Box">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <Style Selector="CheckBox:checked /template/ Path#PART_CheckMark">
        <Setter Property="Stroke" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Indeterminate -->
    <Style Selector="CheckBox:indeterminate /template/ Border#PART_Box">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <Style Selector="CheckBox:indeterminate /template/ Border#PART_IndeterminateMark">
        <Setter Property="Background" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="CheckBox:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="CheckBox:disabled /template/ Border#PART_Box">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraForegroundDisabledBrush}"/>
    </Style>

    <Style Selector="CheckBox:checked:disabled /template/ Border#PART_Box">
        <Setter Property="Background" Value="{DynamicResource AuraForegroundDisabledBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraForegroundDisabledBrush}"/>
    </Style>

</Styles>
