<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="clr-namespace:AuraUI.Controls.Selection;assembly=AuraUI.Controls">

    <!-- Material Design 3 — TimePicker -->

    <Style Selector="selection|TimePicker">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraOnSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="selection:TimePicker">
                    <StackPanel>
                        <Border Name="PART_TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Name="PART_TextBox"
                                         Grid.Column="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="16,12"
                                         Watermark="{TemplateBinding PlaceholderText}"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                <Button Name="PART_DropdownButton"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="12"
                                        Cursor="Hand">
                                    <Path Width="20" Height="20"
                                          Data="M 2,8 A 6,6 0 1,1 14,8 A 6,6 0 1,1 2,8 M 8,4 L 8,8 L 11,10"
                                          Stroke="{DynamicResource AuraOnSurfaceVariantBrush}"
                                          StrokeThickness="1.5"
                                          Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Popup Name="PART_Popup"
                               IsLightDismissEnabled="True"
                               Placement="BottomEdgeAlignedLeft"
                               IsOpen="False">
                            <Border Background="{DynamicResource AuraSurfaceBrush}"
                                    BorderBrush="{DynamicResource AuraOutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource AuraRadiusMd}"
                                    Padding="16"
                                    BoxShadow="{DynamicResource AuraShadowMd}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                                        <ListBox Name="PART_HourSelector"
                                                 Grid.Column="0"
                                                 MaxHeight="160"
                                                 Width="60"/>
                                        <TextBlock Grid.Column="1"
                                                   Text=":"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="20"
                                                   Margin="4,0"/>
                                        <ListBox Name="PART_MinuteSelector"
                                                 Grid.Column="2"
                                                 MaxHeight="160"
                                                 Width="60"/>
                                        <TextBlock Grid.Column="3"
                                                   Text=":"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="20"
                                                   Margin="4,0"
                                                   IsVisible="False"/>
                                        <ListBox Name="PART_SecondSelector"
                                                 Grid.Column="4"
                                                 MaxHeight="160"
                                                 Width="60"
                                                 IsVisible="False"/>
                                    </Grid>
                                    <ListBox Name="PART_AmPmSelector"
                                             HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="selection|TimePicker:focus /template/ Border#PART_TextBoxBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="selection|TimePicker:disabled">
        <Setter Property="Opacity" Value="0.38"/>
    </Style>

</Styles>
