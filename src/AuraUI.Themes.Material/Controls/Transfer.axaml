<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="clr-namespace:AuraUI.Controls.Selection;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Transfer -->

    <Style Selector="selection|Transfer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="selection:Transfer">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource AuraOutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource AuraRadiusMd}"
                            Padding="0">
                        <Grid ColumnDefinitions="*,Auto,*">
                            <!-- Source list -->
                            <Border Grid.Column="0"
                                    BorderBrush="{DynamicResource AuraDividerBrush}"
                                    BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top"
                                            Padding="12,8"
                                            BorderBrush="{DynamicResource AuraDividerBrush}"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock Text="{TemplateBinding LeftTitle}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource AuraForegroundSecondaryBrush}"/>
                                    </Border>
                                    <TextBox Name="PART_SourceSearchBox"
                                             DockPanel.Dock="Top"
                                             Margin="8,4"
                                             FontSize="14"
                                             Watermark="Search..."
                                             IsVisible="False"/>
                                    <ListBox Name="PART_SourceList"
                                             Background="Transparent"
                                             BorderThickness="0"/>
                                </DockPanel>
                            </Border>

                            <!-- Move buttons -->
                            <StackPanel Grid.Column="1"
                                        Spacing="8"
                                        Margin="8,0"
                                        VerticalAlignment="Center">
                                <Button Name="PART_MoveRightButton"
                                        Classes="tonal"
                                        HorizontalAlignment="Stretch"
                                        MinWidth="60"
                                        Padding="8">
                                    <Path Data="M 4,12 L 12,4 L 20,12"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"/>
                                </Button>
                                <Button Name="PART_MoveLeftButton"
                                        Classes="tonal"
                                        HorizontalAlignment="Stretch"
                                        MinWidth="60"
                                        Padding="8">
                                    <Path Data="M 4,4 L 12,12 L 20,4"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <!-- Target list -->
                            <Border Grid.Column="2">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top"
                                            Padding="12,8"
                                            BorderBrush="{DynamicResource AuraDividerBrush}"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock Text="{TemplateBinding RightTitle}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource AuraForegroundSecondaryBrush}"/>
                                    </Border>
                                    <TextBox Name="PART_TargetSearchBox"
                                             DockPanel.Dock="Top"
                                             Margin="8,4"
                                             FontSize="14"
                                             Watermark="Search..."
                                             IsVisible="False"/>
                                    <ListBox Name="PART_TargetList"
                                             Background="Transparent"
                                             BorderThickness="0"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Disabled -->
    <Style Selector="selection|Transfer:disabled">
        <Setter Property="Opacity" Value="0.38"/>
    </Style>

</Styles>
