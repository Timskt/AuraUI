<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="clr-namespace:AuraUI.Controls.Selection;assembly=AuraUI.Controls">

    <!-- Material Design 3 — TreeSelect -->

    <Style Selector="selection|TreeSelect">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,0"/>
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraTextFieldHeight}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyLargeFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="selection:TreeSelect">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Panel>
                            <Border Name="StateLayer"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- Selection display area -->
                                <Border Grid.Column="0"
                                        Padding="16,8">
                                    <TextBlock Name="PART_DisplayText"
                                               Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <!-- Dropdown toggle -->
                                <Border Grid.Column="1"
                                        Width="48"
                                        Background="Transparent"
                                        VerticalAlignment="Stretch">
                                    <Path Width="12" Height="12"
                                          Data="M 1,4 L 6,9 L 11,4"
                                          Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                          StrokeThickness="1.5"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Popup Name="PART_Dropdown"
                                   IsLightDismissEnabled="True"
                                   Placement="BottomEdgeAlignedLeft"
                                   MaxHeight="400">
                                <Border Background="{DynamicResource AuraSurfaceBrush}"
                                        BorderBrush="{DynamicResource AuraOutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource AuraRadiusMd}"
                                        BoxShadow="{DynamicResource AuraShadowLevel3}"
                                        Padding="4">
                                    <DockPanel>
                                        <TextBox Name="PART_SearchBox"
                                                 DockPanel.Dock="Top"
                                                 Margin="4,4,4,8"
                                                 FontSize="14"
                                                 Watermark="Search..."
                                                 IsVisible="False"/>
                                        <TreeView Name="PART_TreeView"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="0"/>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.200"/>
                <BrushTransition Property="Background" Duration="0:0:0.200"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="selection|TreeSelect:pointerover /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
    </Style>

    <!-- Focused / Open -->
    <Style Selector="selection|TreeSelect:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <!-- Outlined variant -->
    <Style Selector="selection|TreeSelect.outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusSm}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="selection|TreeSelect:disabled">
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

</Styles>
