<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:AuraUI.Controls.Display;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Calendar -->

    <Style Selector="display|Calendar">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="display:Calendar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <!-- Header -->
                            <Panel Name="PART_Header"
                                   DockPanel.Dock="Top"
                                   Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Button Name="PART_PreviousButton"
                                            Grid.Column="0"
                                            Classes="icon"
                                            Width="40" Height="40">
                                        <Path Data="M 15,3 L 7,12 L 15,21"
                                              Stroke="{DynamicResource AuraForegroundBrush}"
                                              StrokeThickness="1.5"
                                              Width="12" Height="12"
                                              Stretch="Uniform"/>
                                    </Button>
                                    <Button Name="PART_MonthYearButton"
                                            Grid.Column="1"
                                            Classes="text"
                                            HorizontalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="Medium"/>
                                    <Button Name="PART_NextButton"
                                            Grid.Column="2"
                                            Classes="icon"
                                            Width="40" Height="40">
                                        <Path Data="M 9,3 L 17,12 L 9,21"
                                              Stroke="{DynamicResource AuraForegroundBrush}"
                                              StrokeThickness="1.5"
                                              Width="12" Height="12"
                                              Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Panel>
                            <!-- Calendar content area -->
                            <ScrollViewer>
                                <Panel/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Disabled -->
    <Style Selector="display|Calendar:disabled">
        <Setter Property="Opacity" Value="0.38"/>
    </Style>

</Styles>
