<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feedback="clr-namespace:AuraUI.Controls.Feedback;assembly=AuraUI.Controls">

    <!-- Material Design 3 — Dialog -->

    <Style Selector="feedback|AuraDialog">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyMediumFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="feedback:AuraDialog">
                    <Panel>
                        <!-- Scrim / overlay -->
                        <Border Name="PART_Overlay"
                                Background="{DynamicResource AuraScrimBrush}"
                                Opacity="0.32"/>
                        <!-- Dialog surface -->
                        <Border Name="PART_DialogBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource AuraDialogCornerRadius}"
                                MinWidth="{DynamicResource AuraDialogMinWidth}"
                                MaxWidth="{DynamicResource AuraDialogMaxWidth}"
                                Padding="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel Spacing="16">
                                <!-- Title -->
                                <TextBlock Name="PART_Title"
                                           Text="{TemplateBinding DialogTitle}"
                                           FontSize="24"
                                           FontWeight="Normal"
                                           FontFamily="{DynamicResource AuraFontHeadlineSmallFamily}"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <!-- Content -->
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                <!-- Footer -->
                                <ContentPresenter Name="PART_FooterPresenter"
                                                  Content="{TemplateBinding DialogFooter}"
                                                  ContentTemplate="{TemplateBinding DialogFooterTemplate}"/>
                            </StackPanel>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</Styles>
