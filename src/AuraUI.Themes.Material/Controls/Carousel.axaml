<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:AuraUI.Controls.Display;assembly=AuraUI.Controls">

    <!-- ========================================
         Material Design 3 — Carousel
         ======================================== -->

    <Style Selector="display|AuraCarousel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="display:AuraCarousel">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource AuraCardCornerRadius}"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Items -->
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsSource="{TemplateBinding Items}"
                                            ItemTemplate="{TemplateBinding ItemTemplate}"/>

                            <!-- Navigation arrows -->
                            <Button Name="PART_PreviousButton"
                                    Grid.Column="0"
                                    Classes="icon"
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Background="#80000000"
                                    Foreground="White"
                                    CornerRadius="20">
                                <Path Data="M 15,6 L 9,12 L 15,18"
                                      Stroke="White"
                                      StrokeThickness="2"/>
                                      Width="6"
                                      Height="12"/>
                            </Button>

                            <Button Name="PART_NextButton"
                                    Grid.Column="0"
                                    Classes="icon"
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Background="#80000000"
                                    Foreground="White"
                                    CornerRadius="20">
                                <Path Data="M 9,6 L 15,12 L 9,18"
                                      Stroke="White"
                                      StrokeThickness="2"/>
                                      Width="6"
                                      Height="12"/>
                            </Button>

                            <!-- Indicator dots -->
                            <ItemsControl Name="PART_Indicators"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8"
                                                 Fill="#80FFFFFF"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fade transition class -->
    <Style Selector="display|AuraCarousel.fade /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Opacity" Value="1"/>
    </Style>

</Styles>
