<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================
         Material Design 3 — MultiComboBox
         ======================================== -->

    <Style Selector="MultiComboBox">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,0"/>
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraTextFieldHeight}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontBodyLargeFamily}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MultiComboBox">
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Border Name="StateLayer"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <Grid Margin="{TemplateBinding Padding}"
                                  ColumnDefinitions="*,Auto">
                                <!-- Selected items display -->
                                <ItemsPresenter Name="PART_SelectedItemsPresenter"
                                                Grid.Column="0"
                                                ItemsSource="{TemplateBinding SelectedItems}"
                                                VerticalAlignment="Center"/>
                                <!-- Dropdown arrow -->
                                <Path Name="PART_DropDownGlyph"
                                      Grid.Column="1"
                                      Data="M 0,0 L 4,4 L 8,0"
                                      Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                      StrokeThickness="1.5"/>
                                      StrokeLineJoin="Round"
                                      Width="8"
                                      Height="6"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="MultiComboBox:pointerover /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Focused -->
    <Style Selector="MultiComboBox:focus /template/ Border#RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="MultiComboBox:disabled">
        <Setter Property="Opacity" Value="0.38"/>
    </Style>

</Styles>
