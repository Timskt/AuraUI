<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================
         Material Design 3 — NavigationView
         Supports: .rail, .drawer, .bar variants
         ======================================== -->

    <Style Selector="NavigationView">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NavigationView">
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- Navigation pane -->
                        <Border Name="PART_PaneBorder"
                                Grid.Column="0"
                                Background="{DynamicResource AuraSurfaceBrush}"
                                Width="80">
                            <ScrollViewer>
                                <StackPanel Name="PART_PaneItems"
                                            Spacing="4"
                                            Margin="12,12"/>
                            </ScrollViewer>
                        </Border>
                        <!-- Content area -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource AuraBackgroundBrush}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              Margin="24"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rail variant (narrow, icon + label) -->
    <Style Selector="NavigationView.rail /template/ Border#PART_PaneBorder">
        <Setter Property="Width" Value="80"/>
    </Style>

    <!-- Drawer variant (wider, full menu) -->
    <Style Selector="NavigationView.drawer /template/ Border#PART_PaneBorder">
        <Setter Property="Width" Value="360"/>
    </Style>

    <!-- ==========================================
         NavigationViewItem
         ========================================== -->
    <Style Selector="NavigationViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{DynamicResource AuraFontLabelMediumFamily}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NavigationViewItem">
                    <StackPanel HorizontalAlignment="Center"
                                Spacing="4">
                        <Border Name="PART_IconContainer"
                                Width="56"
                                Height="32"
                                CornerRadius="16"
                                Background="Transparent"
                                HorizontalAlignment="Center">
                            <Border Name="StateLayer"
                                    Background="Transparent"
                                    CornerRadius="16"/>
                            <ContentPresenter Name="PART_IconPresenter"
                                              Content="{TemplateBinding Icon}"
                                              Width="24"
                                              Height="24"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="NavigationViewItem:pointerover /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Pressed -->
    <Style Selector="NavigationViewItem:pressed /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource AuraPressedBrush}"/>
    </Style>

    <!-- Selected -->
    <Style Selector="NavigationViewItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AuraOnSecondaryContainerBrush}"/>
    </Style>

    <Style Selector="NavigationViewItem:selected /template/ Border#PART_IconContainer">
        <Setter Property="Background" Value="{DynamicResource AuraSecondaryContainerBrush}"/>
    </Style>

</Styles>
