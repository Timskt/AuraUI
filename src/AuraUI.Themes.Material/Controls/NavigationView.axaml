<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="clr-namespace:AuraUI.Controls.Navigation;assembly=AuraUI.Controls">

    <!-- Material Design 3 — NavigationView -->

    <Style Selector="navigation|NavigationView">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="navigation:NavigationView">
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- Navigation pane -->
                        <Border Name="PART_PaneBorder"
                                Grid.Column="0"
                                Background="{DynamicResource AuraSurfaceBrush}"
                                Width="80">
                            <ScrollViewer>
                                <StackPanel Name="PART_PaneItems"
                                            Spacing="4"
                                            Margin="12,12"/>
                            </ScrollViewer>
                        </Border>
                        <!-- Content area -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource AuraBackgroundBrush}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              Margin="24"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rail variant (narrow, icon + label) -->
    <Style Selector="navigation|NavigationView /template/ Border#PART_PaneBorder">
        <Setter Property="Width" Value="80"/>
    </Style>

</Styles>
