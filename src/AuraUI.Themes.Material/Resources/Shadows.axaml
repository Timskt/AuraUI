<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================
         Material Design 3 — Elevation Shadows
         ======================================== -->

    <!-- Level 0: No shadow (flat surface) -->
    <BoxShadows x:Key="AuraShadowLevel0">none</BoxShadows>

    <!-- Level 1: Resting state cards, buttons -->
    <BoxShadows x:Key="AuraShadowLevel1">0 1 2 0 #4D000000, 0 1 3 1 #26000000</BoxShadows>

    <!-- Level 2: Hovered cards, floating action buttons -->
    <BoxShadows x:Key="AuraShadowLevel2">0 1 2 0 #4D000000, 0 2 6 2 #26000000</BoxShadows>

    <!-- Level 3: Navigation drawers, side sheets -->
    <BoxShadows x:Key="AuraShadowLevel3">0 4 8 3 #26000000, 0 1 3 0 #4D000000</BoxShadows>

    <!-- Level 4: Dialogs, modals -->
    <BoxShadows x:Key="AuraShadowLevel4">0 6 10 4 #26000000, 0 2 3 0 #4D000000</BoxShadows>

    <!-- Level 5: Top-level surfaces, tooltips -->
    <BoxShadows x:Key="AuraShadowLevel5">0 8 12 6 #26000000, 0 4 4 0 #4D000000</BoxShadows>

</ResourceDictionary>
