<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ========================================
         Material Design 3 — Motion Tokens
         ======================================== -->

    <!-- Duration — Short -->
    <sys:TimeSpan x:Key="AuraAnimationShort1">00:00:00.050</sys:TimeSpan>
    <sys:TimeSpan x:Key="AuraAnimationShort2">00:00:00.100</sys:TimeSpan>
    <sys:TimeSpan x:Key="AuraAnimationShort3">00:00:00.150</sys:TimeSpan>
    <sys:TimeSpan x:Key="AuraAnimationShort4">00:00:00.200</sys:TimeSpan>

    <!-- Duration — Medium -->
    <sys:TimeSpan x:Key="AuraAnimationMedium1">00:00:00.250</sys:TimeSpan>
    <sys:TimeSpan x:Key="AuraAnimationMedium2">00:00:00.300</sys:TimeSpan>
    <sys:TimeSpan x:Key="AuraAnimationMedium3">00:00:00.350</sys:TimeSpan>
    <sys:TimeSpan x:Key="AuraAnimationMedium4">00:00:00.400</sys:TimeSpan>

    <!-- Duration — Long -->
    <sys:TimeSpan x:Key="AuraAnimationLong1">00:00:00.450</sys:TimeSpan>
    <sys:TimeSpan x:Key="AuraAnimationLong2">00:00:00.500</sys:TimeSpan>
    <sys:TimeSpan x:Key="AuraAnimationLong3">00:00:00.550</sys:TimeSpan>
    <sys:TimeSpan x:Key="AuraAnimationLong4">00:00:00.600</sys:TimeSpan>

    <!-- Easing Curves -->
    <CubicEaseInOut x:Key="AuraEasingStandard"/>
    <CubicEaseOut x:Key="AuraEasingDecelerate"/>
    <CubicEaseIn x:Key="AuraEasingAccelerate"/>

    <!-- Default durations used by control transitions -->
    <sys:TimeSpan x:Key="AuraControlTransitionDuration">00:00:00.200</sys:TimeSpan>
    <sys:TimeSpan x:Key="AuraStateLayerDuration">00:00:00.150</sys:TimeSpan>

</ResourceDictionary>
