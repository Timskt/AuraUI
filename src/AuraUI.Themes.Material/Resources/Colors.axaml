<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ========================================
         Material Design 3 — Light Theme Colors
         ======================================== -->

    <!-- Background Hierarchy -->
    <SolidColorBrush x:Key="AuraBackgroundBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="AuraSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AuraCardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AuraOverlayBrush" Color="#00000052"/>
    <SolidColorBrush x:Key="AuraMutedBrush" Color="#F5F5F5"/>

    <!-- Foreground Hierarchy -->
    <SolidColorBrush x:Key="AuraForegroundBrush" Color="#212121"/>
    <SolidColorBrush x:Key="AuraForegroundSecondaryBrush" Color="#757575"/>
    <SolidColorBrush x:Key="AuraForegroundTertiaryBrush" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="AuraForegroundDisabledBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="AuraForegroundOnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AuraForegroundInverseBrush" Color="#F4EFF4"/>
    <SolidColorBrush x:Key="AuraForegroundLinkBrush" Color="#6750A4"/>
    <SolidColorBrush x:Key="AuraForegroundLinkHoverBrush" Color="#5B4C93"/>

    <!-- Semantic / Brand Colors -->
    <SolidColorBrush x:Key="AuraPrimaryBrush" Color="#6750A4"/>
    <SolidColorBrush x:Key="AuraPrimaryHoverBrush" Color="#7C6BB5"/>
    <SolidColorBrush x:Key="AuraPrimaryPressedBrush" Color="#5B4C93"/>
    <SolidColorBrush x:Key="AuraSecondaryBrush" Color="#625B71"/>
    <SolidColorBrush x:Key="AuraSuccessBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="AuraWarningBrush" Color="#ED6C02"/>
    <SolidColorBrush x:Key="AuraErrorBrush" Color="#D32F2F"/>
    <SolidColorBrush x:Key="AuraInfoBrush" Color="#0288D1"/>

    <!-- Interaction State Colors -->
    <SolidColorBrush x:Key="AuraHoverBrush" Color="#14212121"/>
    <SolidColorBrush x:Key="AuraPressedBrush" Color="#1E212121"/>
    <SolidColorBrush x:Key="AuraFocusBrush" Color="#6750A4"/>
    <SolidColorBrush x:Key="AuraDisabledBrush" Color="#1E000000"/>
    <SolidColorBrush x:Key="AuraBorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AuraBorderHoverBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="AuraDividerBrush" Color="#E0E0E0"/>

    <!-- On Surface / On Surface Variant (M3) -->
    <SolidColorBrush x:Key="AuraOnSurfaceBrush" Color="#212121"/>
    <SolidColorBrush x:Key="AuraOnSurfaceVariantBrush" Color="#757575"/>

    <!-- Surface Tint (Material You) -->
    <SolidColorBrush x:Key="AuraSurfaceTintBrush" Color="#6750A4"/>

    <!-- Primary Container (M3 tonal) -->
    <SolidColorBrush x:Key="AuraPrimaryContainerBrush" Color="#EADDFF"/>
    <SolidColorBrush x:Key="AuraOnPrimaryContainerBrush" Color="#21005D"/>

    <!-- Secondary Container -->
    <SolidColorBrush x:Key="AuraSecondaryContainerBrush" Color="#E8DEF8"/>
    <SolidColorBrush x:Key="AuraOnSecondaryContainerBrush" Color="#1D192B"/>

    <!-- Tertiary -->
    <SolidColorBrush x:Key="AuraTertiaryBrush" Color="#7D5260"/>
    <SolidColorBrush x:Key="AuraTertiaryContainerBrush" Color="#FFD8E4"/>
    <SolidColorBrush x:Key="AuraOnTertiaryContainerBrush" Color="#31111D"/>

    <!-- Error Container -->
    <SolidColorBrush x:Key="AuraErrorContainerBrush" Color="#F9DEDC"/>
    <SolidColorBrush x:Key="AuraOnErrorContainerBrush" Color="#410E0B"/>

    <!-- Success Container -->
    <SolidColorBrush x:Key="AuraSuccessContainerBrush" Color="#E8F5E9"/>
    <SolidColorBrush x:Key="AuraOnSuccessContainerBrush" Color="#1B5E20"/>

    <!-- Warning Container -->
    <SolidColorBrush x:Key="AuraWarningContainerBrush" Color="#FFF3E0"/>
    <SolidColorBrush x:Key="AuraOnWarningContainerBrush" Color="#E65100"/>

    <!-- Info Container -->
    <SolidColorBrush x:Key="AuraInfoContainerBrush" Color="#E1F5FE"/>
    <SolidColorBrush x:Key="AuraOnInfoContainerBrush" Color="#01579B"/>

    <!-- Primary Light (for tags/labels) -->
    <SolidColorBrush x:Key="AuraPrimaryLightBrush" Color="#EDE7F6"/>
    <SolidColorBrush x:Key="AuraSuccessLightBrush" Color="#E8F5E9"/>
    <SolidColorBrush x:Key="AuraWarningLightBrush" Color="#FFF3E0"/>
    <SolidColorBrush x:Key="AuraErrorLightBrush" Color="#FFEBEE"/>
    <SolidColorBrush x:Key="AuraInfoLightBrush" Color="#E1F5FE"/>

    <!-- Outline / Outline Variant -->
    <SolidColorBrush x:Key="AuraOutlineBrush" Color="#79747E"/>
    <SolidColorBrush x:Key="AuraOutlineVariantBrush" Color="#CAC4D0"/>

    <!-- Inverse -->
    <SolidColorBrush x:Key="AuraInverseSurfaceBrush" Color="#313033"/>
    <SolidColorBrush x:Key="AuraInverseOnSurfaceBrush" Color="#F4EFF4"/>
    <SolidColorBrush x:Key="AuraInversePrimaryBrush" Color="#D0BCFF"/>

    <!-- Scrim -->
    <SolidColorBrush x:Key="AuraScrimBrush" Color="#000000"/>

    <!-- Shadow -->
    <SolidColorBrush x:Key="AuraShadowBrush" Color="#000000"/>

    <!-- Common transparent -->
    <SolidColorBrush x:Key="AuraTransparentBrush" Color="#00000000"/>

    <!-- Border Focus / Disabled (for controls that reference these) -->
    <SolidColorBrush x:Key="AuraBorderFocusBrush" Color="#6750A4"/>
    <SolidColorBrush x:Key="AuraBorderDisabledBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AuraDividerLightBrush" Color="#F0F0F0"/>

    <!-- Input specific (for controls using input tokens) -->
    <SolidColorBrush x:Key="AuraInputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AuraInputBackgroundHoverBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="AuraInputBackgroundFocusBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AuraInputBackgroundDisabledBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="AuraInputBorderBrush" Color="#CAC4D0"/>
    <SolidColorBrush x:Key="AuraInputBorderHoverBrush" Color="#79747E"/>
    <SolidColorBrush x:Key="AuraInputBorderFocusBrush" Color="#6750A4"/>
    <SolidColorBrush x:Key="AuraPlaceholderBrush" Color="#9E9E9E"/>

    <!-- Selected state -->
    <SolidColorBrush x:Key="AuraSelectedBrush" Color="#6750A41A"/>
    <SolidColorBrush x:Key="AuraSelectedHoverBrush" Color="#6750A433"/>

    <!-- Flyout / Tooltip -->
    <SolidColorBrush x:Key="AuraFlyoutBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AuraFlyoutBorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AuraTooltipBackgroundBrush" Color="#313033"/>
    <SolidColorBrush x:Key="AuraTooltipForegroundBrush" Color="#F4EFF4"/>

    <!-- Chart Palette -->
    <SolidColorBrush x:Key="AuraChartPalette1" Color="#6750A4"/>
    <SolidColorBrush x:Key="AuraChartPalette2" Color="#625B71"/>
    <SolidColorBrush x:Key="AuraChartPalette3" Color="#7D5260"/>
    <SolidColorBrush x:Key="AuraChartPalette4" Color="#2E7D32"/>
    <SolidColorBrush x:Key="AuraChartPalette5" Color="#ED6C02"/>
    <SolidColorBrush x:Key="AuraChartPalette6" Color="#D32F2F"/>
    <SolidColorBrush x:Key="AuraChartPalette7" Color="#0288D1"/>
    <SolidColorBrush x:Key="AuraChartPalette8" Color="#9C27B0"/>
    <SolidColorBrush x:Key="AuraChartGridLineBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AuraChartAxisBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="AuraChartTooltipBackground" Color="#313033"/>
    <SolidColorBrush x:Key="AuraChartTooltipForeground" Color="#F4EFF4"/>

</ResourceDictionary>
