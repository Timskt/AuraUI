<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AuraUI.Controls</RootNamespace>
    <AssemblyName>AuraUI.Controls</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>AuraUI.Controls</PackageId>
    <Version>1.0.0</Version>
    <Authors>AuraUI</Authors>
    <Description>50+ professional controls and 22 chart types for Avalonia UI</Description>
    <PackageTags>avalonia;ui;controls;charts;framework;auraui</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Timskt/AuraUI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Timskt/AuraUI</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AuraUI.Core\AuraUI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AuraUI.Tests" />
  </ItemGroup>
</Project>
