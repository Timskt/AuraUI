<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AuraUI.Controls</RootNamespace>
    <AssemblyName>AuraUI.Controls</AssemblyName>
    <Description>40+ professional controls for Avalonia UI</Description>
    <PackageTags>avalonia;ui;controls;framework;auraui</PackageTags>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Dual Avalonia version support: pass -p:AvaloniaVersion=12 to build against Avalonia 12 -->
  <PropertyGroup Condition="'$(AvaloniaVersion)' == '12'">
    <DefineConstants>AVALONIA_12</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AuraUI.Core\AuraUI.Core.csproj" />
  </ItemGroup>
  <!-- Exclude half-finished G2 spec and transform code that has compilation errors -->
  <ItemGroup>
    <Compile Remove="Charts\G2\**" />
    <Compile Remove="Charts\Data\Transforms\**" />
  </ItemGroup>
</Project>
