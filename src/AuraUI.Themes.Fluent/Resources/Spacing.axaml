<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         AuraUI Fluent Theme — Spacing Tokens
         ============================================================ -->

    <!-- Spacing Scale -->
    <x:Double x:Key="AuraSpacingXs">2</x:Double>
    <x:Double x:Key="AuraSpacingSm">4</x:Double>
    <x:Double x:Key="AuraSpacingMd">8</x:Double>
    <x:Double x:Key="AuraSpacingLg">12</x:Double>
    <x:Double x:Key="AuraSpacingXl">16</x:Double>
    <x:Double x:Key="AuraSpacing2Xl">24</x:Double>
    <x:Double x:Key="AuraSpacing3Xl">32</x:Double>
    <x:Double x:Key="AuraSpacing4Xl">48</x:Double>

    <!-- Spacing as Thickness for padding/margin convenience -->
    <Thickness x:Key="AuraPaddingXs">2</Thickness>
    <Thickness x:Key="AuraPaddingSm">4</Thickness>
    <Thickness x:Key="AuraPaddingMd">8</Thickness>
    <Thickness x:Key="AuraPaddingLg">12</Thickness>
    <Thickness x:Key="AuraPaddingXl">16</Thickness>
    <Thickness x:Key="AuraPadding2Xl">24</Thickness>
    <Thickness x:Key="AuraPadding3Xl">32</Thickness>
    <Thickness x:Key="AuraPadding4Xl">48</Thickness>

    <Thickness x:Key="AuraMarginXs">2</Thickness>
    <Thickness x:Key="AuraMarginSm">4</Thickness>
    <Thickness x:Key="AuraMarginMd">8</Thickness>
    <Thickness x:Key="AuraMarginLg">12</Thickness>
    <Thickness x:Key="AuraMarginXl">16</Thickness>
    <Thickness x:Key="AuraMargin2Xl">24</Thickness>
    <Thickness x:Key="AuraMargin3Xl">32</Thickness>
    <Thickness x:Key="AuraMargin4Xl">48</Thickness>

    <!-- Corner Radius Scale -->
    <CornerRadius x:Key="AuraRadiusNone">0</CornerRadius>
    <CornerRadius x:Key="AuraRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="AuraRadiusMd">6</CornerRadius>
    <CornerRadius x:Key="AuraRadiusLg">8</CornerRadius>
    <CornerRadius x:Key="AuraRadiusXl">12</CornerRadius>
    <CornerRadius x:Key="AuraRadiusFull">9999</CornerRadius>

    <!-- Control specific radii -->
    <CornerRadius x:Key="AuraControlRadius">4</CornerRadius>
    <CornerRadius x:Key="AuraCardRadius">8</CornerRadius>
    <CornerRadius x:Key="AuraDialogRadius">12</CornerRadius>
    <CornerRadius x:Key="AuraButtonRadius">4</CornerRadius>
    <CornerRadius x:Key="AuraInputRadius">4</CornerRadius>
    <CornerRadius x:Key="AuraBadgeRadius">9999</CornerRadius>
    <CornerRadius x:Key="AuraTagRadius">4</CornerRadius>
    <CornerRadius x:Key="AuraAvatarRadius">9999</CornerRadius>
    <CornerRadius x:Key="AuraTooltipRadius">4</CornerRadius>

    <!-- Control Heights (size classes) -->
    <x:Double x:Key="AuraControlHeightSm">28</x:Double>
    <x:Double x:Key="AuraControlHeightMd">32</x:Double>
    <x:Double x:Key="AuraControlHeightLg">40</x:Double>

    <!-- Control MinWidths -->
    <x:Double x:Key="AuraControlMinWidthSm">60</x:Double>
    <x:Double x:Key="AuraControlMinWidthMd">80</x:Double>
    <x:Double x:Key="AuraControlMinWidthLg">100</x:Double>

    <!-- Icon Sizes -->
    <x:Double x:Key="AuraIconSizeSm">12</x:Double>
    <x:Double x:Key="AuraIconSizeMd">16</x:Double>
    <x:Double x:Key="AuraIconSizeLg">20</x:Double>

    <!-- Border Thickness -->
    <Thickness x:Key="AuraBorderThin">1</Thickness>
    <Thickness x:Key="AuraBorderMedium">2</Thickness>
    <Thickness x:Key="AuraBorderThick">3</Thickness>
    <Thickness x:Key="AuraFocusBorder">2</Thickness>

</ResourceDictionary>
