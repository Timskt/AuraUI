<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="/Resources/Colors.axaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="/Resources/Colors.Dark.axaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Spacing.axaml"/>
                <ResourceInclude Source="/Resources/Typography.axaml"/>
                <ResourceInclude Source="/Resources/Animations.axaml"/>
                <ResourceInclude Source="/Resources/Shadows.axaml"/>
                <ResourceInclude Source="/Resources/ChartColors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Include all control styles -->
    <StyleInclude Source="/Controls/Card.axaml"/>
    <StyleInclude Source="/Controls/Expander.axaml"/>
    <StyleInclude Source="/Controls/Divider.axaml"/>
    <StyleInclude Source="/Controls/Badge.axaml"/>
    <StyleInclude Source="/Controls/Tag.axaml"/>
    <StyleInclude Source="/Controls/Avatar.axaml"/>
    <StyleInclude Source="/Controls/Skeleton.axaml"/>
    <StyleInclude Source="/Controls/Button.axaml"/>
    <StyleInclude Source="/Controls/ToggleButton.axaml"/>
    <StyleInclude Source="/Controls/TextBox.axaml"/>
    <StyleInclude Source="/Controls/PasswordBox.axaml"/>
    <StyleInclude Source="/Controls/NumericUpDown.axaml"/>
    <StyleInclude Source="/Controls/SearchBox.axaml"/>
    <StyleInclude Source="/Controls/ComboBox.axaml"/>
    <StyleInclude Source="/Controls/MultiComboBox.axaml"/>
    <StyleInclude Source="/Controls/ListBox.axaml"/>
    <StyleInclude Source="/Controls/RadioButton.axaml"/>
    <StyleInclude Source="/Controls/CheckBox.axaml"/>
    <StyleInclude Source="/Controls/Switch.axaml"/>
    <StyleInclude Source="/Controls/RateControl.axaml"/>
    <StyleInclude Source="/Controls/Carousel.axaml"/>
    <StyleInclude Source="/Controls/Timeline.axaml"/>
    <StyleInclude Source="/Controls/ProgressRing.axaml"/>
    <StyleInclude Source="/Controls/ProgressBar.axaml"/>
    <StyleInclude Source="/Controls/StepIndicator.axaml"/>
    <StyleInclude Source="/Controls/TabControl.axaml"/>
    <StyleInclude Source="/Controls/Breadcrumb.axaml"/>
    <StyleInclude Source="/Controls/NavigationView.axaml"/>
    <StyleInclude Source="/Controls/Pagination.axaml"/>
    <StyleInclude Source="/Controls/MessageBox.axaml"/>
    <StyleInclude Source="/Controls/Toast.axaml"/>
    <StyleInclude Source="/Controls/Notification.axaml"/>
    <StyleInclude Source="/Controls/Dialog.axaml"/>
    <StyleInclude Source="/Controls/Snackbar.axaml"/>
    <StyleInclude Source="/Controls/WindowX.axaml"/>

    <!-- New controls -->
    <StyleInclude Source="/Controls/Drawer.axaml"/>
    <StyleInclude Source="/Controls/DateTimePicker.axaml"/>
    <StyleInclude Source="/Controls/RangeSlider.axaml"/>
    <StyleInclude Source="/Controls/StateControl.axaml"/>
    <StyleInclude Source="/Controls/DropDown.axaml"/>
    <StyleInclude Source="/Controls/ToggleButtonGroup.axaml"/>
    <StyleInclude Source="/Controls/FormGroup.axaml"/>
    <StyleInclude Source="/Controls/ColorPicker.axaml"/>
    <StyleInclude Source="/Controls/MaskedTextBox.axaml"/>
    <StyleInclude Source="/Controls/RepeatButton.axaml"/>
    <StyleInclude Source="/Controls/LoadingOverlay.axaml"/>
    <StyleInclude Source="/Controls/PendingDialog.axaml"/>
    <StyleInclude Source="/Controls/DividerPanel.axaml"/>
    <StyleInclude Source="/Controls/WindowXModalDialog.axaml"/>
    <StyleInclude Source="/Controls/Chart.axaml"/>

    <!-- V2 controls -->
    <StyleInclude Source="/Controls/ZoomViewer.axaml"/>
    <StyleInclude Source="/Controls/TransformControl.axaml"/>
    <StyleInclude Source="/Controls/AnimationStackPanel.axaml"/>
    <StyleInclude Source="/Controls/Bubble.axaml"/>
    <StyleInclude Source="/Controls/ContentControlX.axaml"/>
    <StyleInclude Source="/Controls/GridX.axaml"/>
</Styles>
