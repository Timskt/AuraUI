<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AuraUI.Themes.Fluent</RootNamespace>
    <AssemblyName>AuraUI.Themes.Fluent</AssemblyName>
    <Description>Fluent theme (Windows 11 style) for AuraUI framework</Description>
    <PackageTags>avalonia;ui;theme;fluent;auraui</PackageTags>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Dual Avalonia version support: pass -p:AvaloniaVersion=12 to build against Avalonia 12 -->
  <PropertyGroup Condition="'$(AvaloniaVersion)' == '12'">
    <DefineConstants>AVALONIA_12</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AuraUI.Controls\AuraUI.Controls.csproj" />
  </ItemGroup>
</Project>
