<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AuraUI.Themes.Fluent</RootNamespace>
    <AssemblyName>AuraUI.Themes.Fluent</AssemblyName>
    <!-- AVLN5001: TextBox.Watermark is deprecated but PlaceholderText not yet available in Avalonia 11.3 -->
    <NoWarn>$(NoWarn);AVLN5001</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>AuraUI.Themes.Fluent</PackageId>
    <Version>1.0.0</Version>
    <Authors>AuraUI</Authors>
    <Description>Fluent (Windows 11) theme for AuraUI framework</Description>
    <PackageTags>avalonia;ui;theme;fluent;auraui</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Timskt/AuraUI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Timskt/AuraUI</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AuraUI.Controls\AuraUI.Controls.csproj" />
  </ItemGroup>
</Project>
