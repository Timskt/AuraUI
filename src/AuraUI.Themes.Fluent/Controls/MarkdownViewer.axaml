<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- MarkdownViewer — Fluent Style (Control-based, no Template) -->
    <Style Selector="display|MarkdownViewer">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Empty state -->
    <Style Selector="display|MarkdownViewer:empty">
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

</Styles>
