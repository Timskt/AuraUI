<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout">

    <!-- ============================================================
         Splitter — Fluent Style
         ============================================================ -->
    <Style Selector="layout|Splitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="SplitterBrush" Value="{DynamicResource AuraDividerBrush}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <!-- Horizontal splitter (left/right panels) -->
                    <Grid Name="PART_LayoutGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- First panel -->
                        <ContentControl Name="PART_FirstPanel"
                                        Grid.Column="0"
                                        ClipToBounds="True"/>

                        <!-- Splitter grip -->
                        <Border Name="PART_SplitterGrip"
                                Grid.Column="1"
                                Width="{TemplateBinding SplitterThickness}"
                                Background="{TemplateBinding SplitterBrush}"
                                Cursor="SizeWestEast">
                            <!-- Grip dots -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="2">
                                <Ellipse Width="3" Height="3"
                                         Fill="{DynamicResource AuraForegroundTertiaryBrush}"/>
                                <Ellipse Width="3" Height="3"
                                         Fill="{DynamicResource AuraForegroundTertiaryBrush}"/>
                                <Ellipse Width="3" Height="3"
                                         Fill="{DynamicResource AuraForegroundTertiaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Second panel -->
                        <ContentControl Name="PART_SecondPanel"
                                        Grid.Column="2"
                                        ClipToBounds="True"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Grip hover -->


    <!-- Dragging state -->
    <Style Selector="layout|Splitter:dragging /template/ Border#PART_SplitterGrip">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- First panel collapsed -->
    <Style Selector="layout|Splitter:first-collapsed /template/ ContentControl#PART_FirstPanel">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Second panel collapsed -->
    <Style Selector="layout|Splitter:second-collapsed /template/ ContentControl#PART_SecondPanel">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

</Styles>
