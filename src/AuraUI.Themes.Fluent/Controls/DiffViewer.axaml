<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- DiffViewer — Fluent Style -->
    <Style Selector="display|DiffViewer">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Empty state -->
    <Style Selector="display|DiffViewer:empty">
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

</Styles>
