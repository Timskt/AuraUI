<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:AuraUI.Controls.Input;assembly=AuraUI.Controls">

    <!-- ============================================================
         FileDropZone — Fluent Style
         ============================================================ -->
    <Style Selector="input|FileDropZone">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Drag over state -->
    <Style Selector="input|FileDropZone /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- FileDropZone :disabled -->
    <Style Selector="input|FileDropZone:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
