<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- ============================================================
         AuraTimeline — Fluent Style
         ============================================================ -->
    <Style Selector="display|AuraTimeline">
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter">
                    <ItemsPresenter.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsPresenter.ItemsPanel>
                </ItemsPresenter>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================================
         AuraTimelineItem — Fluent Style
         ============================================================ -->
    <Style Selector="display|AuraTimelineItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="0,0,0,24">
                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,0">
                        <!-- Timestamp (left column) -->
                        <StackPanel Grid.Column="0" Width="100" Margin="0,0,12,0"
                                    VerticalAlignment="Top">
                            <TextBlock Text="{TemplateBinding Timestamp}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Dot and line -->
                        <Panel Grid.Column="1" Width="20">
                            <Border Name="PART_Dot"
                                    Width="12" Height="12"
                                    CornerRadius="6"
                                    Background="{TemplateBinding DotColor}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,4,0,0"/>
                            <Border Name="PART_Line"
                                    Width="2"
                                    Background="{DynamicResource AuraDividerBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0"/>
                        </Panel>

                        <!-- Content -->
                        <ContentPresenter Grid.Column="2"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="12,0,0,0"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Hide line on last item -->
    <Style Selector="display|AuraTimelineItem:last /template/ Border#PART_Line">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

</Styles>
