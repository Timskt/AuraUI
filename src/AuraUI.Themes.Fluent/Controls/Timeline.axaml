<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Timeline — Fluent Style
         ============================================================ -->
    <Style Selector="ItemsControl.timeline">
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter">
                    <ItemsPresenter.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsPresenter.ItemsPanel>
                </ItemsPresenter>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Timeline item container -->
    <Style Selector="Border.timeline-item">
        <Setter Property="Padding" Value="0,0,0,24"/>
    </Style>

    <!-- Timeline dot -->
    <Style Selector="Border.timeline-dot">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusFull}"/>
        <Setter Property="Background" Value="{StaticResource AuraPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Timeline line -->
    <Style Selector="Border.timeline-line">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Background" Value="{StaticResource AuraDividerBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Timeline content area -->
    <Style Selector="ContentPresenter.timeline-content">
        <Setter Property="Margin" Value="12,0"/>
    </Style>

    <!-- Timeline timestamp -->
    <Style Selector="TextBlock.timeline-timestamp">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource AuraForegroundTertiaryBrush}"/>
        <Setter Property="Margin" Value="12,0,0,4"/>
    </Style>

    <!-- Timeline dot variants -->
    <Style Selector="Border.timeline-dot.success">
        <Setter Property="Background" Value="{StaticResource AuraSuccessBrush}"/>
    </Style>
    <Style Selector="Border.timeline-dot.warning">
        <Setter Property="Background" Value="{StaticResource AuraWarningBrush}"/>
    </Style>
    <Style Selector="Border.timeline-dot.error">
        <Setter Property="Background" Value="{StaticResource AuraErrorBrush}"/>
    </Style>
    <Style Selector="Border.timeline-dot.info">
        <Setter Property="Background" Value="{StaticResource AuraInfoBrush}"/>
    </Style>
    <Style Selector="Border.timeline-dot.secondary">
        <Setter Property="Background" Value="{StaticResource AuraSecondaryBrush}"/>
    </Style>

    <!-- Timeline dot: pending (outline only) -->
    <Style Selector="Border.timeline-dot.pending">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

</Styles>
