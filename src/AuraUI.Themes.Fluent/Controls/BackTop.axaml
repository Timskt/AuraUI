<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout">

    <!-- ============================================================
         BackTop — Fluent Style (Scroll to top button)
         ============================================================ -->
    <Style Selector="layout|BackTop">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="ZIndex" Value="1000"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Width="44"
                        Height="44"
                        CornerRadius="{DynamicResource AuraRadiusFull}"
                        Background="{DynamicResource AuraCardBrush}"
                        BorderBrush="{DynamicResource AuraBorderBrush}"
                        BorderThickness="1"
                        BoxShadow="{DynamicResource AuraShadowMd}"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Transitions>
                        <BrushTransition Duration="00:00:00.200" Property="Background"/>
                        <BrushTransition Duration="00:00:00.200" Property="BorderBrush"/>
                    </Border.Transitions>
                    <TextBlock Text="&#x2191;"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AuraForegroundSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Hover state -->
    <Style Selector="layout|BackTop /template/ Border:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>
    <Style Selector="layout|BackTop /template/ Border:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <!-- Enter animation -->
    <Style Selector="layout|BackTop:visible">
        <Style.Animations>
            <Animation Duration="00:00:00.300"
                       Easing="CubicEaseOut"
                       FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="20"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>
