<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="using:AuraUI.Controls.Input">

    <!-- JsonEditor — Fluent Style -->
    <Style Selector="input|JsonEditor">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <DockPanel>
                        <!-- Error bar -->
                        <Border Name="PART_ErrorBar"
                                DockPanel.Dock="Bottom"
                                Background="{DynamicResource AuraErrorMutedBrush}"
                                Padding="10,6"
                                IsVisible="False">
                            <TextBlock Name="PART_ErrorText"
                                       FontSize="12"
                                       Foreground="{DynamicResource AuraErrorBrush}"/>
                        </Border>
                        <!-- Toolbar -->
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="8,4"
                                    HorizontalAlignment="Right">
                            <Button Name="PART_FormatButton"
                                    Content="Format"
                                    FontSize="11"
                                    Padding="8,3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource AuraPrimaryBrush}"/>
                            <Button Name="PART_CopyButton"
                                    Content="Copy"
                                    FontSize="11"
                                    Padding="8,3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource AuraPrimaryBrush}"/>
                        </StackPanel>
                        <!-- Editor area -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <DockPanel>
                                <TextBlock Name="PART_LineNumbers"
                                           DockPanel.Dock="Left"
                                           FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                           FontSize="13"
                                           Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                           Margin="8,4"
                                           TextAlignment="Right"/>
                                <TextBox Name="PART_Editor"
                                         FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                         FontSize="13"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         Margin="8,4"/>
                            </DockPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Valid state -->
    <Style Selector="input|JsonEditor:valid /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraSuccessBrush}"/>
    </Style>

    <!-- Invalid state -->
    <Style Selector="input|JsonEditor:invalid /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>
    <Style Selector="input|JsonEditor:invalid /template/ Border#PART_ErrorBar">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Hover -->
    <Style Selector="input|JsonEditor:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderHoverBrush}"/>
    </Style>

    <!-- Focus -->
    <Style Selector="input|JsonEditor:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderFocusBrush}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="input|JsonEditor:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
