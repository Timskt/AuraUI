<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:AuraUI.Controls.Display;assembly=AuraUI.Controls">

    <!-- ============================================================
         Calendar — Fluent Style
         ============================================================ -->
    <Style Selector="display|Calendar">
        <Setter Property="Background" Value="{DynamicResource AuraCardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <!-- Header -->
                        <Panel Name="PART_Header"
                               DockPanel.Dock="Top"
                               Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Name="PART_PreviousButton"
                                        Grid.Column="0"
                                        Classes="icon sm"
                                        Width="32" Height="32">
                                    <Path Data="M 12,4 L 4,12 L 12,20"
                                          Stroke="{DynamicResource AuraForegroundBrush}"
                                          StrokeThickness="2"
                                          Width="10" Height="10"
                                          Stretch="Uniform"/>
                                </Button>
                                <Button Name="PART_MonthYearButton"
                                        Grid.Column="1"
                                        Classes="text"
                                        HorizontalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="SemiBold"/>
                                <Button Name="PART_NextButton"
                                        Grid.Column="2"
                                        Classes="icon sm"
                                        Width="32" Height="32">
                                    <Path Data="M 4,4 L 12,12 L 4,20"
                                          Stroke="{DynamicResource AuraForegroundBrush}"
                                          StrokeThickness="2"
                                          Width="10" Height="10"
                                          Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Panel>
                        <!-- Calendar content area -->
                        <ScrollViewer>
                            <Panel/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Calendar :disabled -->
    <Style Selector="display|Calendar:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
