<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout">

    <!-- ============================================================
         Expander — Fluent Style
         ============================================================ -->
    <Style Selector="layout|Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <DockPanel>
                        <!-- Header (clickable area) -->
                        <ContentControl Name="PART_HeaderSite"
                                        DockPanel.Dock="Top"
                                        Content="{TemplateBinding Header}"
                                        Background="Transparent"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource AuraDividerBrush}"
                                        Padding="12,10"
                                        MinHeight="44"
                                        Cursor="Hand">
                            <ContentControl.Template>
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ContentPresenter Name="PART_ContentPresenter"
                                                              Content="{TemplateBinding Content}"
                                                              VerticalAlignment="Center"
                                                              Grid.Column="0"/>
                                            <Path Name="Chevron"
                                                  Grid.Column="1"
                                                  Width="12"
                                                  Height="12"
                                                  Data="M 1,4 L 6,9 L 11,4"
                                                  Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                                  StrokeThickness="1.5"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>

                        <!-- Expand/Collapse Content -->
                        <ContentControl Name="PART_ExpandSite"
                                        ClipToBounds="True"
                                        IsVisible="False">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="16,12"/>
                        </ContentControl>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Expander expanded state — rotate chevron -->
    <Style Selector="layout|Expander:expanded /template/ Path#Chevron">
        <Setter Property="RenderTransform">
            <RotateTransform Angle="180"/>
        </Setter>
    </Style>

    <!-- Expander header hover -->
    <Style Selector="layout|Expander /template/ ContentControl#PART_HeaderSite:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Expander with border -->
    <Style Selector="layout|Expander.bordered">
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

</Styles>
