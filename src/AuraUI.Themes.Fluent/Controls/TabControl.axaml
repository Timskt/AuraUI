<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="using:AuraUI.Controls.Navigation">

    <!-- ============================================================
         navigation|AuraTabControl — Fluent Style (Enhanced)
         ============================================================ -->
    <Style Selector="navigation|AuraTabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <!-- Tab strip with scroll support -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource AuraDividerBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <!-- Scroll left button -->
                            <Button Name="PART_ScrollLeftButton"
                                    DockPanel.Dock="Left"
                                    Classes="tab-scroll-button"
                                    Content="&#xE76B;"
                                    IsVisible="False"
                                    VerticalAlignment="Stretch"/>

                            <!-- Scroll right button -->
                            <Button Name="PART_ScrollRightButton"
                                    DockPanel.Dock="Right"
                                    Classes="tab-scroll-button"
                                    Content="&#xE76C;"
                                    IsVisible="False"
                                    VerticalAlignment="Stretch"/>

                            <!-- Add tab button -->
                            <Button Name="PART_AddTabButton"
                                    DockPanel.Dock="Right"
                                    Classes="add-tab-button"
                                    Content="+"
                                    IsVisible="False"
                                    VerticalAlignment="Stretch"
                                    Margin="4,0"/>

                            <!-- Tab strip scroll viewer -->
                            <ScrollViewer Name="PART_TabStripScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          Background="Transparent">
                                <TabStrip Name="PART_Header"
                                          Background="Transparent"
                                          SelectedIndex="{TemplateBinding SelectedIndex}"
                                          Margin="0,0,0,-1">
                                    <TabStrip.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </TabStrip.ItemsPanel>
                                </TabStrip>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Content area -->
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                      Margin="0,16,0,0"/>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================================
         TabItem (TabStripItem) — Fluent Style
         ============================================================ -->
    <Style Selector="TabStripItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="00:00:00.150" Property="Foreground"/>
                <BrushTransition Duration="00:00:00.150" Property="Background"/>
                <DoubleTransition Duration="00:00:00.200" Property="Opacity" Easing="{DynamicResource AuraEasingStandard}"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel LastChildFill="False">
                    <!-- Bottom indicator line -->
                    <Border Name="PART_SelectedPipe"
                            DockPanel.Dock="Bottom"
                            Height="3"
                            CornerRadius="1.5,1.5,0,0"
                            Background="Transparent"
                            Margin="0,4,0,-1">
                    </Border>

                    <!-- Tab content -->
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- TabItem :pointerover -->
    <Style Selector="TabStripItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
    </Style>


    <!-- TabItem :selected -->
    <Style Selector="TabStripItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TabStripItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- TabItem :disabled -->
    <Style Selector="TabStripItem:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- ============================================================
         Tab Scroll Buttons — Fluent Style
         ============================================================ -->
    <Style Selector="Button.tab-scroll-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,8"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>


    <Style Selector="Button.tab-scroll-button:pressed">
        <Setter Property="Opacity" Value="0.86"/>
        <Setter Property="ScaleTransform.ScaleX" Value="0.98"/>
        <Setter Property="ScaleTransform.ScaleY" Value="0.98"/>
    </Style>

    <!-- ============================================================
         Add Tab Button — Fluent Style
         ============================================================ -->
    <Style Selector="Button.add-tab-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,6"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusSm}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.add-tab-button:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
    </Style>

    <Style Selector="Button.add-tab-button:pressed">
        <Setter Property="Opacity" Value="0.86"/>
        <Setter Property="ScaleTransform.ScaleX" Value="0.98"/>
        <Setter Property="ScaleTransform.ScaleY" Value="0.98"/>
    </Style>

    <!-- ============================================================
         TabControl Variants
         ============================================================ -->

    <!-- Pills style -->
    <Style Selector="navigation|AuraTabControl.pills TabStripItem">
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="Transparent"
                        CornerRadius="{DynamicResource AuraRadiusFull}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="navigation|AuraTabControl.pills TabStripItem:selected /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryLightBrush}"/>
    </Style>

    <!-- Underline-less / clean -->
    <Style Selector="navigation|AuraTabControl.clean">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</Styles>
