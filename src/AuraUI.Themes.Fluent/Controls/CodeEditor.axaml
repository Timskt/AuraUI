<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- CodeEditor — Fluent Style -->
    <Style Selector="display|CodeEditor">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <DockPanel>
                        <!-- Toolbar -->
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="8,4"
                                    HorizontalAlignment="Right">
                            <ToggleButton Name="PART_WrapToggle"
                                          Content="Wrap"
                                          FontSize="11"
                                          Padding="6,2"
                                          Background="Transparent"/>
                            <Button Name="PART_CopyButton"
                                    Content="Copy"
                                    FontSize="11"
                                    Padding="6,2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource AuraPrimaryBrush}"/>
                        </StackPanel>
                        <!-- Code area -->
                        <ScrollViewer Name="PART_ScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <DockPanel>
                                <!-- Line numbers -->
                                <TextBlock Name="PART_LineNumbers"
                                           DockPanel.Dock="Left"
                                           FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                           FontSize="13"
                                           Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                           Margin="8,4"
                                           TextAlignment="Right"
                                           IsVisible="True"/>
                                <!-- Code content -->
                                <TextBlock Name="PART_CodePresenter"
                                           FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                           FontSize="13"
                                           Foreground="{DynamicResource AuraForegroundBrush}"
                                           Margin="8,4"
                                           TextWrapping="NoWrap"/>
                            </DockPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Dark theme pseudo-class -->
    <Style Selector="display|CodeEditor:dark">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceDarkBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundDarkBrush}"/>
    </Style>

    <!-- Hover -->
    <Style Selector="display|CodeEditor:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Focus -->
    <Style Selector="display|CodeEditor:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraFocusBrush}"/>
    </Style>

    <!-- Word wrap -->
    <Style Selector="display|CodeEditor:wordwrap /template/ TextBlock#PART_CodePresenter">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="display|CodeEditor:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
