<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="using:AuraUI.Controls.Navigation">

    <!-- ============================================================
         NavigationView — Fluent Style (Side Navigation)
         ============================================================ -->

    <!-- NavigationView ControlTemplate -->
    <Style Selector="navigation|NavigationView">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="navigation:NavigationView">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Navigation pane -->
                    <Border Name="PART_PaneBorder"
                            Grid.Column="0"
                            Background="{DynamicResource AuraSurfaceBrush}"
                            BorderBrush="{DynamicResource AuraDividerBrush}"
                            BorderThickness="0,0,1,0"
                            Width="280"
                            ClipToBounds="True">
                        <DockPanel>
                            <!-- Toggle / Hamburger button -->
                            <Button Name="PART_ToggleButton"
                                    DockPanel.Dock="Top"
                                    Classes="ghost"
                                    Width="36"
                                    Height="36"
                                    Margin="12,12,12,4"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand">
                                <Path Width="18" Height="18"
                                      Data="M 3,6 L 21,6 M 3,12 L 21,12 M 3,18 L 21,18"
                                      Stroke="{DynamicResource AuraForegroundBrush}"
                                      StrokeThickness="1.5"/>
                            </Button>

                            <!-- Back button -->
                            <Button Name="PART_BackButton"
                                    DockPanel.Dock="Top"
                                    Classes="ghost"
                                    Width="36"
                                    Height="36"
                                    Margin="12,4,12,8"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    IsVisible="False">
                                <Path Width="16" Height="16"
                                      Data="M 15,3 L 7,12 L 15,21"
                                      Stroke="{DynamicResource AuraForegroundBrush}"
                                      StrokeThickness="1.5"
                                      Stretch="Uniform"/>
                            </Button>

                            <!-- Footer items -->
                            <ItemsControl Name="PART_FooterItemsControl"
                                          DockPanel.Dock="Bottom"
                                          Margin="12,0,12,12"/>

                            <!-- Settings item -->
                            <Control Name="PART_SettingsItem"
                                     DockPanel.Dock="Bottom"
                                     Margin="12,0,12,8"/>

                            <!-- Menu items -->
                            <ScrollViewer>
                                <ItemsControl Name="PART_MenuItemsControl"
                                              Margin="12,8"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <!-- Content area -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource AuraBackgroundBrush}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          Margin="24"/>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================================
         NavigationView Class-based Styles (legacy)
         ============================================================ -->
    <Style Selector="Border.navigation-view">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraDividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Width" Value="280"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- Navigation header -->
    <Style Selector="Border.navigation-header">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="Border.navigation-header TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
    </Style>

    <!-- ============================================================
         NavigationViewItem — Fluent Style
         ============================================================ -->
    <Style Selector="Border.nav-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="4,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="Border.nav-item">
        <Setter Property="Border.Transitions">
            <Transitions>
                <BrushTransition Duration="00:00:00.200" Property="Background"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Nav item layout -->
    <Style Selector="Border.nav-item StackPanel">
        <Setter Property="Spacing" Value="12"/>
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>

    <!-- Nav item icon -->
    <Style Selector="Border.nav-item Path">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
    </Style>

    <!-- Nav item text -->
    <Style Selector="Border.nav-item TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Nav item :pointerover -->


    <!-- Nav item :pressed -->
    <Style Selector="Border.nav-item:pressed">
        <Setter Property="Background" Value="{DynamicResource AuraPressedBrush}"/>
    </Style>

    <!-- Nav item :selected (active) -->
    <Style Selector="Border.nav-item.selected">
        <Setter Property="Background" Value="{DynamicResource AuraSelectedBrush}"/>
    </Style>
    <Style Selector="Border.nav-item.selected Path">
        <Setter Property="Fill" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>
    <Style Selector="Border.nav-item.selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Nav item :disabled -->
    <Style Selector="Border.nav-item:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- ============================================================
         NavigationView Section Header
         ============================================================ -->
    <Style Selector="Border.nav-section-header">
        <Setter Property="Padding" Value="16,16,16,4"/>
    </Style>

    <Style Selector="Border.nav-section-header TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundTertiaryBrush}"/>
    </Style>

    <!-- ============================================================
         NavigationView Divider
         ============================================================ -->
    <Style Selector="Border.nav-divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource AuraDividerBrush}"/>
        <Setter Property="Margin" Value="12,8"/>
    </Style>

    <!-- ============================================================
         NavigationView Footer
         ============================================================ -->
    <Style Selector="Border.navigation-footer">
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="DockPanel.Dock" Value="Bottom"/>
    </Style>

    <!-- Compact mode (icon only) -->
    <Style Selector="Border.navigation-view.compact">
        <Setter Property="Width" Value="64"/>
    </Style>

    <Style Selector="Border.navigation-view.compact Border.nav-item">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.navigation-view.compact Border.nav-item TextBlock">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

</Styles>
