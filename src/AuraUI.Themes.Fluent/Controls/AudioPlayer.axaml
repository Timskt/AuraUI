<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- AudioPlayer — Fluent Style -->
    <Style Selector="display|AudioPlayer">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraControlHeightMd}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Border.Transitions>
                        <BrushTransition Duration="00:00:00.200" Property="Background"/>
                        <BrushTransition Duration="00:00:00.200" Property="BorderBrush"/>
                    </Border.Transitions>
                    <StackPanel Spacing="8">
                        <!-- Progress bar -->
                        <ProgressBar Name="PART_ProgressBar"
                                     Minimum="0" Maximum="1"
                                     Height="4"
                                     CornerRadius="2"
                                     Foreground="{DynamicResource AuraPrimaryBrush}"
                                     Background="{DynamicResource AuraMutedBrush}"/>
                        <!-- Controls row -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Name="PART_PlayButton"
                                    Grid.Column="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6"
                                    Cursor="Hand"
                                    Content="&#x25B6;"
                                    FontSize="16"
                                    Foreground="{DynamicResource AuraPrimaryBrush}"/>
                            <Slider Name="PART_VolumeSlider"
                                    Grid.Column="2"
                                    Minimum="0" Maximum="1" Value="1"
                                    Width="80"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="00:00:00.200" Property="Foreground"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="display|AudioPlayer:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Playing state -->
    <Style Selector="display|AudioPlayer:playing">
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Muted state -->
    <Style Selector="display|AudioPlayer:muted">
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="display|AudioPlayer:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
