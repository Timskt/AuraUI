<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout">

    <!-- ============================================================
         Card — Fluent Style
         ============================================================ -->
    <Style Selector="layout|Card">
        <Setter Property="Background" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraCardRadius}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowSm}"/>
        <Setter Property="HeaderBackground" Value="Transparent"/>
        <Setter Property="FooterBackground" Value="Transparent"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="00:00:00.200" Property="Background"/>
                <BrushTransition Duration="00:00:00.200" Property="BorderBrush"/>
                <BoxShadowsTransition Duration="00:00:00.200" Property="BoxShadow"/>
                <DoubleTransition Duration="00:00:00.200" Property="TranslateTransform.Y" Easing="{DynamicResource AuraEasingDecelerate}"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{TemplateBinding BoxShadow}"
                        Padding="{TemplateBinding Padding}"
                        ClipToBounds="{TemplateBinding ClipToBounds}">
                    <DockPanel>
                        <!-- Header -->
                        <Border DockPanel.Dock="Top"
                                Background="{TemplateBinding HeaderBackground}"
                                IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentPresenter Name="PART_HeaderPresenter"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Margin="0,0,0,12"/>
                        </Border>
                        <!-- Footer -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{TemplateBinding FooterBackground}"
                                IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentPresenter Name="PART_FooterPresenter"
                                              Content="{TemplateBinding Footer}"
                                              ContentTemplate="{TemplateBinding FooterTemplate}"
                                              Margin="0,12,0,0"/>
                        </Border>
                        <!-- Content -->
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Card :pointerover -->
    <Style Selector="layout|Card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderHoverBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowMd}"/>
    </Style>

    <!-- Card with IsHoverable -->
    <Style Selector="layout|Card[IsHoverable=true]">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Hoverable card lift effect on hover -->
    <Style Selector="layout|Card[IsHoverable=true]:pointerover">
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowLg}"/>
    </Style>
    <Style Selector="layout|Card[IsHoverable=true]:pointerover /template/ Border">
        <Setter Property="TranslateTransform.Y" Value="-2"/>
    </Style>

    <!-- Card Elevation 0 -->
    <Style Selector="layout|Card[Elevation=0]">
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowNone}"/>
    </Style>

    <!-- Card Elevation 1 -->
    <Style Selector="layout|Card[Elevation=1]">
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowSm}"/>
    </Style>

    <!-- Card Elevation 2 -->
    <Style Selector="layout|Card[Elevation=2]">
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowMd}"/>
    </Style>

    <!-- Card Elevation 3 -->
    <Style Selector="layout|Card[Elevation=3]">
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowLg}"/>
    </Style>

    <!-- Card class .flat — no shadow, no border -->
    <Style Selector="layout|Card.flat">
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowNone}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Card class .outlined — border only, no shadow -->
    <Style Selector="layout|Card.outlined">
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowNone}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</Styles>
