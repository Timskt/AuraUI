<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AuraUI.Controls.Layout;assembly=AuraUI.Controls">

    <!-- ============================================================
         AvatarGroup — Fluent Style
         ============================================================ -->
    <Style Selector="layout|AvatarGroup">
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>

    <!-- Avatar group items: circular clipping -->
    <Style Selector="layout|AvatarGroup Border.avatar-group-item">
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Hover effect on individual avatars -->
    <Style Selector="layout|AvatarGroup Border.avatar-group-item:pointerover">
        <Setter Property="ZIndex" Value="999"/>
        <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>

    <!-- First item in group -->
    <Style Selector="layout|AvatarGroup Border.avatar-group-item.group-first">
        <Setter Property="ZIndex" Value="10"/>
    </Style>

</Styles>
