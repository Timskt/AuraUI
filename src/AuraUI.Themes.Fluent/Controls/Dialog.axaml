<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feedback="using:AuraUI.Controls.Feedback">

    <!-- ============================================================
         AuraDialog — Fluent Style (ContentControl-based dialog)
         ============================================================ -->
    <Style Selector="feedback|AuraDialog">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="OverlayBrush" Value="{DynamicResource AuraSmokeBrush}"/>
        <Setter Property="OverlayOpacity" Value="0.5"/>
        <Setter Property="DialogBackground" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="DialogCornerRadius" Value="{DynamicResource AuraDialogRadius}"/>
        <Setter Property="DialogShadow" Value="{DynamicResource AuraShadowLg}"/>
        <Setter Property="DialogPadding" Value="24"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Overlay backdrop -->
                    <Border Name="PART_Overlay"
                            Background="{TemplateBinding OverlayBrush}"
                            Opacity="{TemplateBinding OverlayOpacity}"
                            IsVisible="False"/>

                    <!-- Dialog border -->
                    <Border Name="PART_DialogBorder"
                            Background="{TemplateBinding DialogBackground}"
                            CornerRadius="{TemplateBinding DialogCornerRadius}"
                            BoxShadow="{TemplateBinding DialogShadow}"
                            ClipToBounds="True"
                            MinWidth="320"
                            MaxWidth="680"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="False">
                        <DockPanel>
                            <!-- Title bar -->
                            <Border DockPanel.Dock="Top"
                                    Background="Transparent"
                                    Padding="24,20,24,0">
                                <DockPanel>
                                    <!-- Close button -->
                                    <Button Name="PART_CloseButton"
                                            DockPanel.Dock="Right"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4"
                                            Width="32" Height="32"
                                            CornerRadius="4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="8,-4,-4,0"
                                            Cursor="Hand">
                                        <Path Width="12" Height="12"
                                              Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                              Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                              StrokeThickness="1.5"/>
                                    </Button>

                                    <!-- Title -->
                                    <TextBlock Name="PART_Title"
                                               Text="{TemplateBinding DialogTitle}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AuraForegroundBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>

                            <!-- Content area -->
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="500">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="24,16"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Dialog open state -->
    <Style Selector="feedback|AuraDialog:open">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="feedback|AuraDialog:open /template/ Border#PART_Overlay">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="feedback|AuraDialog:open /template/ Border#PART_DialogBorder">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Dialog open animation -->
    <Style Selector="feedback|AuraDialog:open /template/ Border#PART_DialogBorder">
        <Style.Animations>
            <Animation Duration="00:00:00.250"
                       Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="0.96"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="0.96"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Overlay fade-in -->
    <Style Selector="feedback|AuraDialog:open /template/ Border#PART_Overlay">
        <Style.Animations>
            <Animation Duration="00:00:00.200"
                       Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Dialog close button hover -->


    <!-- ============================================================
         AuraMessageBox — Window.dialog style (for standalone windows)
         ============================================================ -->
    <Style Selector="Window.dialog">
        <Setter Property="Background" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraDialogRadius}"/>
        <Setter Property="MinWidth" Value="400"/>
        <Setter Property="MaxWidth" Value="680"/>
        <Setter Property="SizeToContent" Value="Height"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource AuraShadowLg}"
                        ClipToBounds="True">
                    <DockPanel>
                        <!-- Title bar / Header -->
                        <Border Name="PART_TitleBar"
                                DockPanel.Dock="Top"
                                Background="Transparent"
                                Padding="24,20,24,0">
                        <DockPanel>
                            <!-- Close button -->
                            <Button Name="PART_CloseButton"
                                    DockPanel.Dock="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    Width="32" Height="32"
                                    CornerRadius="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="8,-4,-4,0"
                                    Cursor="Hand">
                                <Path Width="12" Height="12"
                                      Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                      Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                      StrokeThickness="1.5"/>
                            </Button>

                            <!-- Title -->
                            <TextBlock Name="PART_Title"
                                       Text="{TemplateBinding Title}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AuraForegroundBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        </Border>

                        <!-- Footer buttons -->
                        <StackPanel Name="PART_ButtonArea"
                                    DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    Margin="24,16,24,24">
                            <Button Name="PART_SecondaryButton"
                                    Classes="ghost"
                                    Content="Cancel"/>
                            <Button Name="PART_PrimaryButton"
                                    Content="OK"/>
                        </StackPanel>

                        <!-- Content area with scroll -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="500">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="24,16"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Dialog close button states -->


    <Style Selector="Window.dialog /template/ Button#PART_CloseButton:pressed">
        <Setter Property="Background" Value="{DynamicResource AuraPressedBrush}"/>
    </Style>

    <!-- Dialog overlay backdrop -->
    <Style Selector="Border.dialog-overlay">
        <Setter Property="Background" Value="{DynamicResource AuraSmokeBrush}"/>
    </Style>

    <!-- Overlay backdrop -->
    <Style Selector="Border.flyout-overlay">
        <Setter Property="Background" Value="{DynamicResource AuraSmokeBrush}"/>
    </Style>

    <!-- ============================================================
         Flyout / Popup Panel Style
         ============================================================ -->
    <Style Selector="Border.flyout">
        <Setter Property="Background" Value="{DynamicResource AuraFlyoutBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraFlyoutBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowMd}"/>
    </Style>

    <Style Selector="Border.flyout">
        <Style.Animations>
            <Animation Duration="00:00:00.150"
                       Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="0.95"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>
