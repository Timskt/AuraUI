<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- DeploymentCard — Fluent Style -->
    <Style Selector="display|DeploymentCard">
        <Setter Property="Background" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <!-- Status indicator -->
                        <Border Name="PART_StatusIndicator"
                                DockPanel.Dock="Left"
                                Width="4"
                                CornerRadius="2"
                                Margin="0,0,12,0"
                                Background="{DynamicResource AuraSuccessBrush}"/>
                        <!-- Content -->
                        <StackPanel Spacing="4">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="00:00:00.200" Property="BorderBrush"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="display|DeploymentCard:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowSm}"/>
    </Style>

    <!-- Status colors -->
    <Style Selector="display|DeploymentCard:success /template/ Border#PART_StatusIndicator">
        <Setter Property="Background" Value="{DynamicResource AuraSuccessBrush}"/>
    </Style>
    <Style Selector="display|DeploymentCard:building /template/ Border#PART_StatusIndicator">
        <Setter Property="Background" Value="{DynamicResource AuraWarningBrush}"/>
    </Style>
    <Style Selector="display|DeploymentCard:failed /template/ Border#PART_StatusIndicator">
        <Setter Property="Background" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>
    <Style Selector="display|DeploymentCard:pending /template/ Border#PART_StatusIndicator">
        <Setter Property="Background" Value="{DynamicResource AuraForegroundTertiaryBrush}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="display|DeploymentCard:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
