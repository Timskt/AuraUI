<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="using:AuraUI.Controls.Selection">

    <!-- ============================================================
         RateControl — Fluent Style (Star Rating)
         ============================================================ -->
    <Style Selector="selection|RateControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Rating panel (stars rendered programmatically) -->
                    <Panel Name="PART_RatingPanel"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- RateControl :disabled -->
    <Style Selector="selection|RateControl:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- RateControl :readonly -->
    <Style Selector="selection|RateControl:readonly">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

</Styles>
