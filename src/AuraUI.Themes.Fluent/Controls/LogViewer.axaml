<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- LogViewer — Fluent Style (Control-based, no Template) -->
    <Style Selector="display|LogViewer">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="display|LogViewer:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
