<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AuraUI.Controls.Layout;assembly=AuraUI.Controls">

    <!-- ============================================================
         ButtonGroup — Fluent Style
         ============================================================ -->
    <Style Selector="layout|ButtonGroup">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        BorderBrush="{DynamicResource AuraBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource AuraRadiusMd}"
                        ClipToBounds="True">
                    <ItemsPresenter Name="PART_ItemsPresenter">
                        <ItemsPresenter.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsPresenter.ItemsPanel>
                    </ItemsPresenter>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ButtonGroupText -->
    <Style Selector="layout|ButtonGroupText">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</Styles>
