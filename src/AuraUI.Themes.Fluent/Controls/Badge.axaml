<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout">

    <!-- ============================================================
         Badge — Fluent Style
         ============================================================ -->
    <Style Selector="layout|Badge">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Main content -->
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>

                    <!-- Badge overlay -->
                    <Border Name="PART_BadgeContainer"
                            Background="{DynamicResource AuraPrimaryBrush}"
                            CornerRadius="999"
                            MinWidth="20"
                            MinHeight="20"
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-6,-6,0"
                            ZIndex="1"
                            ClipToBounds="True">
                        <TextBlock Name="PART_BadgeText"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Badge dot mode: hide text, show small dot -->
    <Style Selector="layout|Badge:dot /template/ Border#PART_BadgeContainer">
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,-4,-4,0"/>
    </Style>
    <Style Selector="layout|Badge:dot /template/ TextBlock#PART_BadgeText">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Badge variant colors -->
    <Style Selector="layout|Badge:primary /template/ Border#PART_BadgeContainer">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>
    <Style Selector="layout|Badge:success /template/ Border#PART_BadgeContainer">
        <Setter Property="Background" Value="{DynamicResource AuraSuccessBrush}"/>
    </Style>
    <Style Selector="layout|Badge:warning /template/ Border#PART_BadgeContainer">
        <Setter Property="Background" Value="{DynamicResource AuraWarningBrush}"/>
    </Style>
    <Style Selector="layout|Badge:error /template/ Border#PART_BadgeContainer">
        <Setter Property="Background" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>
    <Style Selector="layout|Badge:default /template/ Border#PART_BadgeContainer">
        <Setter Property="Background" Value="{DynamicResource AuraSecondaryBrush}"/>
    </Style>

</Styles>
