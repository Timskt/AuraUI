<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         PasswordBox — Fluent Style
         ============================================================ -->
    <Style Selector="TextBox.password">
        <Setter Property="Background" Value="{DynamicResource AuraInputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraInputRadius}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraControlHeightMd}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="PasswordChar" Value="*"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AuraForegroundBrush}"/>
    </Style>

    <!-- PasswordBox :pointerover -->
    <Style Selector="TextBox.password:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraInputBackgroundHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderHoverBrush}"/>
    </Style>

    <!-- PasswordBox :focus -->
    <Style Selector="TextBox.password:focus /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraInputBackgroundFocusBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderFocusBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <!-- PasswordBox :disabled -->
    <Style Selector="TextBox.password:disabled">
        <Setter Property="Background" Value="{DynamicResource AuraInputBackgroundDisabledBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundDisabledBrush}"/>
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- Password reveal toggle button -->
    <Style Selector="TextBox.password /template/ Button#PART_RevealButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="TextBox.password /template/ Button#PART_RevealButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Size variants -->
    <Style Selector="TextBox.password.sm">
        <Setter Property="MinHeight" Value="{DynamicResource AuraControlHeightSm}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBox.password.lg">
        <Setter Property="MinHeight" Value="{DynamicResource AuraControlHeightLg}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

</Styles>
