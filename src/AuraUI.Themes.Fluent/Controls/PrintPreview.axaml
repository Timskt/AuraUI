<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:printing="using:AuraUI.Controls.Printing">

    <!-- PrintPreview — Fluent Style (Control-based) -->
    <Style Selector="printing|PrintPreview">
        <Setter Property="Opacity" Value="1"/>
    </Style>

</Styles>
