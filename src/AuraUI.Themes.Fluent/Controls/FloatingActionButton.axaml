<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout">

    <!-- FloatingActionButton — Fluent Style -->
    <Style Selector="layout|FloatingActionButton">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            BoxShadow="{DynamicResource AuraShadowLg}"
                            ClipToBounds="True">
                        <Border.Transitions>
                            <BrushTransition Duration="00:00:00.200" Property="Background"/>
                        </Border.Transitions>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <ContentPresenter Name="PART_IconPresenter"
                                              VerticalAlignment="Center"/>
                            <TextBlock Name="PART_LabelPresenter"
                                       Text="{TemplateBinding Tag}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Duration="00:00:00.100" Property="ScaleTransform.ScaleX" Easing="{DynamicResource AuraEasingStandard}"/>
                <DoubleTransition Duration="00:00:00.100" Property="ScaleTransform.ScaleY" Easing="{DynamicResource AuraEasingStandard}"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="layout|FloatingActionButton:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryHoverBrush}"/>
    </Style>

    <Style Selector="layout|FloatingActionButton:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryPressedBrush}"/>
    </Style>
    <Style Selector="layout|FloatingActionButton:pressed">
        <Setter Property="ScaleTransform.ScaleX" Value="0.95"/>
        <Setter Property="ScaleTransform.ScaleY" Value="0.95"/>
    </Style>

    <Style Selector="layout|FloatingActionButton.mini">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>
    <Style Selector="layout|FloatingActionButton.large">
        <Setter Property="Padding" Value="20"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="MinHeight" Value="64"/>
    </Style>
    <Style Selector="layout|FloatingActionButton.extended">
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
        <Setter Property="Padding" Value="16,16"/>
    </Style>

    <Style Selector="layout|FloatingActionButton:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
