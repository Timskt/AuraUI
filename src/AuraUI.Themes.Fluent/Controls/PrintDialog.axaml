<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:printing="using:AuraUI.Controls.Printing">

    <!-- PrintDialog — Fluent Style -->
    <Style Selector="printing|PrintDialog">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusLg}"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="MinWidth" Value="480"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="{DynamicResource AuraShadowXl}">
                    <DockPanel>
                        <!-- Title -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Print"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AuraForegroundBrush}"
                                   Margin="0,0,0,16"/>
                        <!-- Buttons -->
                        <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    Margin="0,16,0,0">
                            <Button Content="Cancel"
                                    Classes="ghost"
                                    Padding="16,6"/>
                            <Button Content="Print"
                                    Classes="primary"
                                    Padding="16,6"/>
                        </StackPanel>
                        <!-- Content -->
                        <ScrollViewer>
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
