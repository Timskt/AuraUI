<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         ComboBox — Fluent Style
         ============================================================ -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource AuraInputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraInputRadius}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraControlHeightMd}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="00:00:00.200" Property="Background"/>
                <BrushTransition Duration="00:00:00.200" Property="BorderBrush"/>
                <DoubleTransition Duration="00:00:00.200" Property="Opacity" Easing="{DynamicResource AuraEasingStandard}"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Panel>
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Selection box area -->
                            <Border Grid.Column="0"
                                    Padding="8,6">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>

                            <!-- Dropdown toggle -->
                            <Border Name="PART_DropdownGlyph"
                                    Grid.Column="1"
                                    Width="32"
                                    Background="Transparent"
                                    VerticalAlignment="Stretch">
                                <Path Name="Chevron"
                                      Width="12" Height="12"
                                      Data="M 1,4 L 6,9 L 11,4"
                                      Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                      StrokeThickness="1.5"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5"/>
                            </Border>
                        </Grid>
                        <!-- Dropdown popup -->
                        <Popup Name="PART_Popup"
                               IsLightDismissEnabled="True"
                               Placement="BottomEdgeAlignedLeft"
                               MaxHeight="300">
                            <Border Name="PART_DropdownBorder"
                                    Background="{DynamicResource AuraFlyoutBackgroundBrush}"
                                    BorderBrush="{DynamicResource AuraFlyoutBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource AuraRadiusMd}"
                                    BoxShadow="{DynamicResource AuraShadowMd}"
                                    Padding="4">
                                <DockPanel>
                                    <!-- Search box (shown when IsSearchable) -->
                                    <TextBox Name="PART_SearchBox"
                                             DockPanel.Dock="Top"
                                             Margin="4,4,4,8"
                                             FontSize="13"
                                             Watermark="Search..."
                                             IsVisible="False"/>
                                    <ScrollViewer>
                                        <ItemsPresenter Name="PART_ItemsPresenter"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ComboBox placeholder / watermark text -->
    <Style Selector="ComboBox /template/ TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AuraPlaceholderBrush}"/>
    </Style>

    <!-- ComboBox :pointerover -->
    <Style Selector="ComboBox:pointerover /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderHoverBrush}"/>
    </Style>

    <!-- ComboBox :focus — 2px accent border -->
    <Style Selector="ComboBox:focus-visible /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderFocusBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- ComboBox :disabled -->
    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- ComboBox expanded -->
    <Style Selector="ComboBox:expanded /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderFocusBrush}"/>
    </Style>

    <!-- ComboBox dropdown toggle hover -->


    <!-- ============================================================
         ComboBoxItem — Fluent Style
         ============================================================ -->
    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="00:00:00.150" Property="Background"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource AuraRadiusSm}"
                        Margin="4,1"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>



    <Style Selector="ComboBoxItem:selected /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraSelectedBrush}"/>
    </Style>


    <Style Selector="ComboBoxItem:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- ============================================================
         ComboBox Size Classes
         ============================================================ -->
    <Style Selector="ComboBox.sm">
        <Setter Property="MinHeight" Value="{DynamicResource AuraControlHeightSm}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="ComboBox.lg">
        <Setter Property="MinHeight" Value="{DynamicResource AuraControlHeightLg}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- ============================================================
         Popup / Dropdown styling
         ============================================================ -->
    <Style Selector="ComboBox Popup Border">
        <Setter Property="Background" Value="{DynamicResource AuraFlyoutBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraFlyoutBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowMd}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>


    <!-- ============================================================ -->
    <!-- CodexSwitchUI: Opacity-based interaction states              -->
    <!-- ============================================================ -->
    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Opacity" Value="0.92"/>
    </Style>

    <Style Selector="ComboBoxItem:pressed">
        <Setter Property="Opacity" Value="0.86"/>
        <Setter Property="ScaleTransform.ScaleX" Value="0.98"/>
        <Setter Property="ScaleTransform.ScaleY" Value="0.98"/>
    </Style>

</Styles>
