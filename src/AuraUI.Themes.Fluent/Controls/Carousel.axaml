<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- ============================================================
         AuraCarousel — Fluent Style
         ============================================================ -->
    <Style Selector="display|AuraCarousel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource AuraRadiusMd}"
                        ClipToBounds="True">
                    <Panel>
                        <!-- Items presenter -->
                        <ItemsPresenter Name="PART_ItemsPresenter">
                            <ItemsPresenter.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Panel/>
                                </ItemsPanelTemplate>
                            </ItemsPresenter.ItemsPanel>
                        </ItemsPresenter>

                        <!-- Previous button -->
                        <Button Name="PART_PreviousButton"
                                Classes="carousel-prev"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                ZIndex="1">
                            <Path Width="12" Height="12"
                                  Data="M 8,1 L 3,6 L 8,11"
                                  Stroke="{DynamicResource AuraForegroundBrush}"
                                  StrokeThickness="1.5"
                                  Stretch="Uniform"/>
                        </Button>

                        <!-- Next button -->
                        <Button Name="PART_NextButton"
                                Classes="carousel-next"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                ZIndex="1">
                            <Path Width="12" Height="12"
                                  Data="M 4,1 L 9,6 L 4,11"
                                  Stroke="{DynamicResource AuraForegroundBrush}"
                                  StrokeThickness="1.5"
                                  Stretch="Uniform"/>
                        </Button>

                        <!-- Indicators (dots) -->
                        <ItemsControl Name="PART_Indicators"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,12"
                                      ZIndex="1"/>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Carousel slide transition (handled in code) -->

    <!-- Carousel Navigation Buttons -->
    <Style Selector="Button.carousel-prev">
        <Setter Property="Background" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>


    <Style Selector="Button.carousel-next">
        <Setter Property="Background" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>


    <!-- Carousel Indicators (Dots) -->
    <Style Selector="StackPanel.carousel-indicators">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,16"/>
    </Style>

    <Style Selector="Border.carousel-dot">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
        <Setter Property="Background" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.carousel-dot.active">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="Width" Value="24"/>
    </Style>

</Styles>
