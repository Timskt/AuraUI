<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         RadioButton — Fluent Style
         ============================================================ -->
    <Style Selector="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AuraForegroundBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Radio circle -->
                    <Border Name="PART_RadioOuter"
                            Width="20" Height="20"
                            CornerRadius="10"
                            Background="{StaticResource AuraInputBackgroundBrush}"
                            BorderBrush="{StaticResource AuraInputBorderBrush}"
                            BorderThickness="1.5"
                            VerticalAlignment="Center">
                        <Border.Transitions>
                            <BrushTransition Duration="00:00:00.200" Property="Background"/>
                            <BrushTransition Duration="00:00:00.200" Property="BorderBrush"/>
                        </Border.Transitions>
                        <!-- Inner dot -->
                        <Border Name="PART_RadioInner"
                                Width="10" Height="10"
                                CornerRadius="5"
                                Background="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Border.Transitions>
                                <BrushTransition Duration="00:00:00.200" Property="Background"/>
                                <DoubleTransition Duration="00:00:00.200" Property="Width"/>
                                <DoubleTransition Duration="00:00:00.200" Property="Height"/>
                            </Border.Transitions>
                        </Border>
                    </Border>

                    <!-- Content -->
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- RadioButton :pointerover -->
    <Style Selector="RadioButton:pointerover /template/ Border#PART_RadioOuter">
        <Setter Property="BorderBrush" Value="{StaticResource AuraInputBorderHoverBrush}"/>
        <Setter Property="Background" Value="{StaticResource AuraInputBackgroundHoverBrush}"/>
    </Style>

    <!-- RadioButton :checked -->
    <Style Selector="RadioButton:checked /template/ Border#PART_RadioOuter">
        <Setter Property="BorderBrush" Value="{StaticResource AuraPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource AuraInputBackgroundFocusBrush}"/>
    </Style>

    <Style Selector="RadioButton:checked /template/ Border#PART_RadioInner">
        <Setter Property="Background" Value="{StaticResource AuraPrimaryBrush}"/>
    </Style>

    <!-- RadioButton checked + :pointerover -->
    <Style Selector="RadioButton:checked:pointerover /template/ Border#PART_RadioOuter">
        <Setter Property="BorderBrush" Value="{StaticResource AuraPrimaryHoverBrush}"/>
    </Style>
    <Style Selector="RadioButton:checked:pointerover /template/ Border#PART_RadioInner">
        <Setter Property="Background" Value="{StaticResource AuraPrimaryHoverBrush}"/>
    </Style>

    <!-- RadioButton :pressed -->
    <Style Selector="RadioButton:pressed /template/ Border#PART_RadioOuter">
        <Setter Property="Background" Value="{StaticResource AuraInputBackgroundDisabledBrush}"/>
    </Style>

    <!-- RadioButton :focus -->
    <Style Selector="RadioButton:focus /template/ Border#PART_RadioOuter">
        <Setter Property="BorderBrush" Value="{StaticResource AuraFocusBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- RadioButton :disabled -->
    <Style Selector="RadioButton:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- RadioButton error -->
    <Style Selector="RadioButton:error /template/ Border#PART_RadioOuter">
        <Setter Property="BorderBrush" Value="{StaticResource AuraErrorBrush}"/>
    </Style>

    <!-- ============================================================
         RadioButton Variants
         ============================================================ -->

    <!-- Card style radio -->
    <Style Selector="RadioButton.card">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{StaticResource AuraInputBackgroundBrush}"
                        BorderBrush="{StaticResource AuraInputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AuraRadiusMd}"
                        Padding="12">
                    <Border.Transitions>
                        <BrushTransition Duration="00:00:00.200" Property="Background"/>
                        <BrushTransition Duration="00:00:00.200" Property="BorderBrush"/>
                    </Border.Transitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Name="PART_RadioOuter"
                                Width="20" Height="20"
                                CornerRadius="10"
                                Background="{StaticResource AuraInputBackgroundBrush}"
                                BorderBrush="{StaticResource AuraInputBorderBrush}"
                                BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <Border Name="PART_RadioInner"
                                    Width="10" Height="10"
                                    CornerRadius="5"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.card:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{StaticResource AuraHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AuraBorderHoverBrush}"/>
    </Style>

    <Style Selector="RadioButton.card:checked /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{StaticResource AuraPrimaryBrush}"/>
    </Style>

</Styles>
