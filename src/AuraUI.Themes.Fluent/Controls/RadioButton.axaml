<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         RadioButton — Fluent Style
         ============================================================ -->
    <Style Selector="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="00:00:00.150" Property="Background"/>
                <BrushTransition Duration="00:00:00.150" Property="BorderBrush"/>
                <DoubleTransition Duration="00:00:00.200" Property="Opacity" Easing="{DynamicResource AuraEasingStandard}"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Radio circle -->
                    <Border Name="PART_RadioOuter"
                            Width="20" Height="20"
                            CornerRadius="10"
                            Background="{DynamicResource AuraInputBackgroundBrush}"
                            BorderBrush="{DynamicResource AuraInputBorderBrush}"
                            BorderThickness="1.5"
                            VerticalAlignment="Center">
                        <!-- Inner dot -->
                        <Border Name="PART_RadioInner"
                                Width="10" Height="10"
                                CornerRadius="5"
                                Background="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        </Border>
                    </Border>

                    <!-- Content -->
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- RadioButton :pointerover -->
    <Style Selector="RadioButton:pointerover /template/ Border#PART_RadioOuter">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderHoverBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- RadioButton :checked -->
    <Style Selector="RadioButton:checked /template/ Border#PART_RadioOuter">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AuraInputBackgroundFocusBrush}"/>
    </Style>

    <Style Selector="RadioButton:checked /template/ Border#PART_RadioInner">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- RadioButton checked + :pointerover -->
    <Style Selector="RadioButton:checked:pointerover /template/ Border#PART_RadioOuter">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryHoverBrush}"/>
    </Style>


    <!-- RadioButton :pressed -->

    <!-- RadioButton :focus -->
    <Style Selector="RadioButton:focus-visible /template/ Border#PART_RadioOuter">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraFocusBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- RadioButton :disabled -->
    <Style Selector="RadioButton:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- RadioButton error -->
    <Style Selector="RadioButton:error /template/ Border#PART_RadioOuter">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>

    <!-- ============================================================
         RadioButton Variants
         ============================================================ -->

    <!-- Card style radio -->
    <Style Selector="RadioButton.card">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{DynamicResource AuraInputBackgroundBrush}"
                        BorderBrush="{DynamicResource AuraInputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource AuraRadiusMd}"
                        Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Name="PART_RadioOuter"
                                Width="20" Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource AuraInputBackgroundBrush}"
                                BorderBrush="{DynamicResource AuraInputBorderBrush}"
                                BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <Border Name="PART_RadioInner"
                                    Width="10" Height="10"
                                    CornerRadius="5"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.card:pointerover /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderHoverBrush}"/>
    </Style>

    <Style Selector="RadioButton.card:checked /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>


    <!-- ============================================================ -->
    <!-- CodexSwitchUI: Opacity-based interaction states              -->
    <!-- ============================================================ -->
    <Style Selector="RadioButton:pressed">
        <Setter Property="Opacity" Value="0.86"/>
        <Setter Property="ScaleTransform.ScaleX" Value="0.98"/>
        <Setter Property="ScaleTransform.ScaleY" Value="0.98"/>
    </Style>

</Styles>
