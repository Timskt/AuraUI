<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="clr-namespace:AuraUI.Controls.Selection;assembly=AuraUI.Controls">

    <!-- ============================================================
         Cascader — Fluent Style
         ============================================================ -->
    <Style Selector="selection|Cascader">
        <Setter Property="Background" Value="{DynamicResource AuraInputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraInputRadius}"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraControlHeightMd}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Panel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Name="PART_Input"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Watermark="{TemplateBinding Placeholder}"
                                     Padding="8,6"
                                     VerticalAlignment="Stretch"/>
                            <Border Grid.Column="1"
                                    Width="32"
                                    Background="Transparent"
                                    VerticalAlignment="Stretch">
                                <Path Width="12" Height="12"
                                      Data="M 1,4 L 6,9 L 11,4"
                                      Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                      StrokeThickness="1.5"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Popup Name="PART_Dropdown"
                               IsLightDismissEnabled="True"
                               Placement="BottomEdgeAlignedLeft"
                               MaxHeight="400">
                            <Border Background="{DynamicResource AuraFlyoutBackgroundBrush}"
                                    BorderBrush="{DynamicResource AuraFlyoutBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource AuraRadiusMd}"
                                    BoxShadow="{DynamicResource AuraShadowMd}"
                                    Padding="4">
                                <ScrollViewer>
                                    <StackPanel/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Cascader :pointerover -->
    <Style Selector="selection|Cascader:pointerover /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderHoverBrush}"/>
    </Style>

    <!-- Cascader :open / :focus -->
    <Style Selector="selection|Cascader:focus-visible /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderFocusBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <Style Selector="selection|Cascader:open /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderFocusBrush}"/>
    </Style>

    <!-- Cascader :disabled -->
    <Style Selector="selection|Cascader:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
