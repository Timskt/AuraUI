<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="using:AuraUI.Controls.Selection">

    <!-- ============================================================
         Switch — Fluent Style (Toggle Switch)
         ============================================================ -->
    <Style Selector="selection|Switch">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Track -->
                    <Border Name="PART_Track"
                            Width="40" Height="20"
                            CornerRadius="10"
                            Background="{DynamicResource AuraBorderBrush}"
                            BorderBrush="{DynamicResource AuraBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Border.Transitions>
                            <BrushTransition Duration="00:00:00.200" Property="Background"/>
                            <BrushTransition Duration="00:00:00.200" Property="BorderBrush"/>
                        </Border.Transitions>

                        <!-- Thumb -->
                        <Border Name="PART_Thumb"
                                Width="14" Height="14"
                                CornerRadius="7"
                                Background="{DynamicResource AuraForegroundBrush}"
                                Margin="2,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <Border.Transitions>
                                <BrushTransition Duration="00:00:00.200" Property="Background"/>
                            </Border.Transitions>
                        </Border>
                    </Border>

                    <!-- Content -->
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Switch :pointerover on track -->
    <Style Selector="selection|Switch:pointerover /template/ Border#PART_Track">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderHoverBrush}"/>
    </Style>

    <!-- Switch :checked -->
    <Style Selector="selection|Switch:checked /template/ Border#PART_Track">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Switch :disabled -->
    <Style Selector="selection|Switch:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Switch size: small -->
    <Style Selector="selection|Switch:small /template/ Border#PART_Track">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="selection|Switch:small /template/ Border#PART_Thumb">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
    </Style>

    <!-- Switch size: large -->
    <Style Selector="selection|Switch:large /template/ Border#PART_Track">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="selection|Switch:large /template/ Border#PART_Thumb">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
    </Style>

</Styles>
