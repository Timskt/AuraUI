<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="using:AuraUI.Controls.Selection">

    <!-- ============================================================
         Switch — Fluent Style (Toggle Switch)
         ============================================================ -->
    <Style Selector="selection|Switch">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="TrackBackground" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="TrackCornerRadius" Value="10"/>
        <Setter Property="ThumbBackground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="ThumbSize" Value="14"/>
        <Setter Property="CheckedTrackBackground" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="CheckedThumbBackground" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- Track -->
                    <Border Name="PART_Track"
                            Width="40" Height="20"
                            CornerRadius="{TemplateBinding TrackCornerRadius}"
                            Background="{TemplateBinding TrackBackground}"
                            BorderBrush="{DynamicResource AuraBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">

                        <!-- Thumb -->
                        <Border Name="PART_Thumb"
                                Width="{TemplateBinding ThumbSize}"
                                Height="{TemplateBinding ThumbSize}"
                                CornerRadius="999"
                                Background="{TemplateBinding ThumbBackground}"
                                Margin="2,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        </Border>
                    </Border>

                    <!-- Content -->
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Switch :pointerover on track -->
    <Style Selector="selection|Switch:pointerover /template/ Border#PART_Track">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderHoverBrush}"/>
    </Style>

    <!-- Switch :checked -->
    <Style Selector="selection|Switch:checked /template/ Border#PART_Track">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Switch :checked — move thumb to right -->
    <Style Selector="selection|Switch:checked /template/ Border#PART_Thumb">
        <Setter Property="Margin" Value="24,0,2,0"/>
        <Setter Property="Background" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <!-- Switch :pressed -->
    <Style Selector="selection|Switch:pressed /template/ Border#PART_Thumb">
        <Setter Property="Width" Value="16"/>
    </Style>

    <!-- Switch :disabled -->
    <Style Selector="selection|Switch:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Switch size: small -->
    <Style Selector="selection|Switch:small /template/ Border#PART_Track">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="selection|Switch:small /template/ Border#PART_Thumb">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
    </Style>
    <Style Selector="selection|Switch:small:checked /template/ Border#PART_Thumb">
        <Setter Property="Margin" Value="18,0,2,0"/>
    </Style>

    <!-- Switch size: large -->
    <Style Selector="selection|Switch:large /template/ Border#PART_Track">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="selection|Switch:large /template/ Border#PART_Thumb">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
    </Style>
    <Style Selector="selection|Switch:large:checked /template/ Border#PART_Thumb">
        <Setter Property="Margin" Value="30,0,2,0"/>
    </Style>

</Styles>
