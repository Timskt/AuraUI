<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Snackbar — Fluent Style (Bottom notification bar)
         ============================================================ -->
    <Style Selector="Border.snackbar">
        <Setter Property="Background" Value="{StaticResource AuraTooltipBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BoxShadow" Value="{StaticResource AuraShadowMd}"/>
        <Setter Property="MinWidth" Value="300"/>
        <Setter Property="MaxWidth" Value="560"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- Snackbar enter animation -->
    <Style Selector="Border.snackbar">
        <Style.Animations>
            <Animation Duration="00:00:00.300"
                       Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="30"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Snackbar message -->
    <Style Selector="Border.snackbar TextBlock.snackbar-message">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource AuraTooltipForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Snackbar action button -->
    <Style Selector="Border.snackbar Button.snackbar-action">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.snackbar Button.snackbar-action:pointerover">
        <Setter Property="Foreground" Value="{StaticResource AuraPrimaryHoverBrush}"/>
    </Style>

    <!-- Snackbar close button -->
    <Style Selector="Border.snackbar Button.snackbar-close">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.snackbar Button.snackbar-close:pointerover">
        <Setter Property="Background" Value="#20FFFFFF"/>
    </Style>

    <!-- Snackbar divider between message and action -->
    <Style Selector="Border.snackbar-divider">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="#40FFFFFF"/>
        <Setter Property="Margin" Value="8,0"/>
    </Style>

    <!-- ============================================================
         Snackbar Variants
         ============================================================ -->

    <!-- Success snackbar -->
    <Style Selector="Border.snackbar.success">
        <Setter Property="Background" Value="{StaticResource AuraSuccessBrush}"/>
    </Style>

    <!-- Warning snackbar -->
    <Style Selector="Border.snackbar.warning">
        <Setter Property="Background" Value="{StaticResource AuraWarningBrush}"/>
    </Style>

    <!-- Error snackbar -->
    <Style Selector="Border.snackbar.error">
        <Setter Property="Background" Value="{StaticResource AuraErrorBrush}"/>
    </Style>

    <!-- Info snackbar -->
    <Style Selector="Border.snackbar.info">
        <Setter Property="Background" Value="{StaticResource AuraInfoBrush}"/>
    </Style>

    <!-- Light / surface snackbar -->
    <Style Selector="Border.snackbar.light">
        <Setter Property="Background" Value="{StaticResource AuraCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.snackbar.light TextBlock.snackbar-message">
        <Setter Property="Foreground" Value="{StaticResource AuraForegroundBrush}"/>
    </Style>

</Styles>
