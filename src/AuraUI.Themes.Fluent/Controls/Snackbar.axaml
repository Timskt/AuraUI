<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feedback="using:AuraUI.Controls.Feedback">

    <!-- ============================================================
         Snackbar — Fluent Style (Bottom notification bar)
         ============================================================ -->

    <!-- Snackbar ControlTemplate -->
    <Style Selector="feedback|Snackbar">
        <Setter Property="Background" Value="{DynamicResource AuraTooltipBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTooltipForegroundBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MaxWidth" Value="560"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="feedback:Snackbar">
                <Border Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource AuraRadiusMd}"
                        Padding="{TemplateBinding Padding}"
                        MaxWidth="{TemplateBinding MaxWidth}"
                        BoxShadow="{DynamicResource AuraShadowMd}"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto">
                        <!-- Message -->
                        <TextBlock Name="PART_Message"
                                   Grid.Column="0"
                                   Grid.Row="0"
                                   Text="{TemplateBinding Message}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                        <!-- Action button -->
                        <Button Name="PART_ActionButton"
                                Grid.Column="1"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Background="Transparent"
                                Foreground="{DynamicResource AuraPrimaryBrush}"
                                BorderThickness="0"
                                Padding="8,4"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="8,0,-8,0"
                                IsVisible="False"/>

                        <!-- Close button -->
                        <Button Name="PART_CloseButton"
                                Grid.Column="0"
                                Grid.Row="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4"
                                Width="28"
                                Height="28"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                IsVisible="False">
                            <Path Width="10" Height="10"
                                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  Stroke="{DynamicResource AuraTooltipForegroundBrush}"
                                  StrokeThickness="1.5"/>
                        </Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Snackbar enter animation -->
    <Style Selector="feedback|Snackbar">
        <Style.Animations>
            <Animation Duration="00:00:00.300"
                       Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="30"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================================
         Snackbar Class-based Styles (legacy)
         ============================================================ -->
    <Style Selector="Border.snackbar">
        <Setter Property="Background" Value="{DynamicResource AuraTooltipBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowMd}"/>
        <Setter Property="MinWidth" Value="300"/>
        <Setter Property="MaxWidth" Value="560"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- Snackbar enter animation -->
    <Style Selector="Border.snackbar">
        <Style.Animations>
            <Animation Duration="00:00:00.300"
                       Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="30"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Snackbar message -->
    <Style Selector="Border.snackbar TextBlock.snackbar-message">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTooltipForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Snackbar action button -->
    <Style Selector="Border.snackbar Button.snackbar-action">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.snackbar Button.snackbar-action:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryHoverBrush}"/>
    </Style>

    <!-- Snackbar close button -->
    <Style Selector="Border.snackbar Button.snackbar-close">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.snackbar Button.snackbar-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

    <!-- Snackbar divider between message and action -->
    <Style Selector="Border.snackbar-divider">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource AuraDividerBrush}"/>
        <Setter Property="Margin" Value="8,0"/>
    </Style>

    <!-- ============================================================
         Snackbar Variants
         ============================================================ -->

    <!-- Success snackbar -->
    <Style Selector="Border.snackbar.success">
        <Setter Property="Background" Value="{DynamicResource AuraSuccessBrush}"/>
    </Style>

    <!-- Warning snackbar -->
    <Style Selector="Border.snackbar.warning">
        <Setter Property="Background" Value="{DynamicResource AuraWarningBrush}"/>
    </Style>

    <!-- Error snackbar -->
    <Style Selector="Border.snackbar.error">
        <Setter Property="Background" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>

    <!-- Info snackbar -->
    <Style Selector="Border.snackbar.info">
        <Setter Property="Background" Value="{DynamicResource AuraInfoBrush}"/>
    </Style>

    <!-- Light / surface snackbar -->
    <Style Selector="Border.snackbar.light">
        <Setter Property="Background" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.snackbar.light TextBlock.snackbar-message">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
    </Style>

</Styles>
