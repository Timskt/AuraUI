<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feedback="clr-namespace:AuraUI.Controls.Feedback;assembly=AuraUI.Controls">

    <!-- ============================================================
         Tour — Fluent Style
         ============================================================ -->
    <Style Selector="feedback|Tour">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Overlay -->
                    <Border Name="PART_Overlay"
                            Background="#80000000"
                            IsVisible="False"/>
                    <!-- Tooltip -->
                    <Border Name="PART_Tooltip"
                            Background="{DynamicResource AuraCardBrush}"
                            BorderBrush="{DynamicResource AuraBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource AuraRadiusMd}"
                            BoxShadow="{DynamicResource AuraShadowLg}"
                            Padding="16"
                            MinWidth="240"
                            MaxWidth="360"
                            IsVisible="False">
                        <StackPanel Spacing="12">
                            <!-- Step title -->
                            <TextBlock Name="PART_Title"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <!-- Step description -->
                            <TextBlock Name="PART_Description"
                                       FontSize="14"
                                       Foreground="{DynamicResource AuraForegroundSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <!-- Custom content -->
                            <ContentPresenter Name="PART_Content"
                                              IsVisible="False"/>
                            <!-- Navigation -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Button Name="PART_CloseButton"
                                        Grid.Column="0"
                                        Classes="icon sm"
                                        Width="28" Height="28"
                                        Margin="0,0,8,0">
                                    <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                          Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                          StrokeThickness="2"
                                          Width="12" Height="12"/>
                                </Button>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Name="PART_PreviousButton"
                                            Classes="sm"
                                            Content="Previous"/>
                                    <Button Name="PART_NextButton"
                                            Classes="primary sm"
                                            Content="Next"/>
                                </StackPanel>
                            </Grid>
                            <!-- Step indicator -->
                            <TextBlock Name="PART_StepIndicator"
                                       FontSize="12"
                                       Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Tour :open -->
    <Style Selector="feedback|Tour:open /template/ Border#PART_Overlay">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="feedback|Tour:open /template/ Border#PART_Tooltip">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Hide previous on first step -->
    <Style Selector="feedback|Tour:first-step /template/ Button#PART_PreviousButton">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

</Styles>
