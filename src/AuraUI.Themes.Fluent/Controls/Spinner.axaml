<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:AuraUI.Controls.Display;assembly=AuraUI.Controls">

    <!-- ============================================================
         Spinner — Fluent Style
         ============================================================ -->
    <Style Selector="display|Spinner">
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>

    <!-- Size: Small -->
    <Style Selector="display|Spinner.small">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <!-- Size: Medium -->
    <Style Selector="display|Spinner.medium">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>

    <!-- Size: Large -->
    <Style Selector="display|Spinner.large">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <!-- Paused state: lower opacity -->
    <Style Selector="display|Spinner.paused">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
