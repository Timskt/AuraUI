<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         StepIndicator — Fluent Style
         ============================================================ -->
    <Style Selector="ItemsControl.step-indicator">
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter">
                    <ItemsPresenter.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="0"/>
                        </ItemsPanelTemplate>
                    </ItemsPresenter.ItemsPanel>
                </ItemsPresenter>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Step item container -->
    <Style Selector="Border.step-item">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- Step circle -->
    <Style Selector="Border.step-circle">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusFull}"/>
        <Setter Property="Background" Value="{StaticResource AuraMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.step-circle TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Step connector line -->
    <Style Selector="Border.step-connector">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Background" Value="{StaticResource AuraDividerBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>

    <!-- Step label -->
    <Style Selector="TextBlock.step-label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource AuraForegroundTertiaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- ============================================================
         Step States
         ============================================================ -->

    <!-- Completed step -->
    <Style Selector="Border.step-circle.completed">
        <Setter Property="Background" Value="{StaticResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AuraPrimaryBrush}"/>
    </Style>
    <Style Selector="Border.step-circle.completed TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <!-- Active step -->
    <Style Selector="Border.step-circle.active">
        <Setter Property="Background" Value="{StaticResource AuraBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AuraPrimaryBrush}"/>
    </Style>
    <Style Selector="Border.step-circle.active TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Upcoming step (default) -->
    <Style Selector="Border.step-circle.upcoming">
        <Setter Property="Background" Value="{StaticResource AuraMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AuraBorderBrush}"/>
    </Style>

    <!-- Error step -->
    <Style Selector="Border.step-circle.error">
        <Setter Property="Background" Value="{StaticResource AuraErrorBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AuraErrorBrush}"/>
    </Style>
    <Style Selector="Border.step-circle.error TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <!-- Completed connector -->
    <Style Selector="Border.step-connector.completed">
        <Setter Property="Background" Value="{StaticResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Active connector -->
    <Style Selector="Border.step-connector.active">
        <Setter Property="Background" Value="{StaticResource AuraPrimaryBrush}"/>
    </Style>

    <!-- ============================================================
         Step Indicator Variants
         ============================================================ -->

    <!-- Compact (small circles) -->
    <Style Selector="ItemsControl.step-indicator.compact Border.step-circle">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="ItemsControl.step-indicator.compact Border.step-circle TextBlock">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Vertical orientation -->
    <Style Selector="ItemsControl.step-indicator.vertical /template/ ItemsPresenter">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
        </Setter>
    </Style>

</Styles>
