<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- ============================================================
         StepIndicator — Fluent Style
         ============================================================ -->
    <Style Selector="display|StepIndicator">
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter">
                    <ItemsPresenter.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="0"/>
                        </ItemsPanelTemplate>
                    </ItemsPresenter.ItemsPanel>
                </ItemsPresenter>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================================
         StepIndicatorItem — Fluent Style
         ============================================================ -->
    <Style Selector="display|StepIndicatorItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <!-- Step circle + label -->
                        <StackPanel Width="120" Spacing="8" HorizontalAlignment="Center">
                            <!-- Circle with step number -->
                            <Border Name="PART_Circle"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    Background="{DynamicResource AuraMutedBrush}"
                                    BorderBrush="{DynamicResource AuraBorderBrush}"
                                    BorderThickness="2"
                                    HorizontalAlignment="Center">
                                <TextBlock Name="PART_StepNumber"
                                           Text="{TemplateBinding StepIndex}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AuraForegroundSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Title and Description -->
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="{TemplateBinding Title}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Description}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Connector line (not on last item) -->
                        <Border Name="PART_Connector"
                                Height="2"
                                Width="40"
                                Background="{DynamicResource AuraDividerBrush}"
                                VerticalAlignment="Top"
                                Margin="0,16,0,0"/>
                    </StackPanel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Step states -->
    <Style Selector="display|StepIndicatorItem:completed /template/ Border#PART_Circle">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>
    <Style Selector="display|StepIndicatorItem:completed /template/ Border#PART_Circle TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <Style Selector="display|StepIndicatorItem:active /template/ Border#PART_Circle">
        <Setter Property="Background" Value="{DynamicResource AuraBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>
    <Style Selector="display|StepIndicatorItem:active /template/ Border#PART_Circle TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <Style Selector="display|StepIndicatorItem:error /template/ Border#PART_Circle">
        <Setter Property="Background" Value="{DynamicResource AuraErrorBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>

    <!-- Hide connector on last item -->
    <Style Selector="display|StepIndicatorItem:last /template/ Border#PART_Connector">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Completed connector -->
    <Style Selector="display|StepIndicatorItem:completed /template/ Border#PART_Connector">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

</Styles>
