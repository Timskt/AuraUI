<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:AuraUI.Controls.Input;assembly=AuraUI.Controls">

    <!-- ============================================================
         AutoComplete — Fluent Style
         ============================================================ -->
    <Style Selector="input|AutoComplete">
        <Setter Property="Background" Value="{DynamicResource AuraInputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraInputRadius}"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraControlHeightMd}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Panel>
                        <TextBox Name="PART_TextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Watermark="{TemplateBinding Placeholder}"
                                 Padding="8,6"
                                 VerticalAlignment="Stretch"/>
                        <Popup Name="PART_Popup"
                               IsLightDismissEnabled="True"
                               Placement="BottomEdgeAlignedLeft"
                               MaxHeight="300">
                            <Border Background="{DynamicResource AuraFlyoutBackgroundBrush}"
                                    BorderBrush="{DynamicResource AuraFlyoutBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource AuraRadiusMd}"
                                    BoxShadow="{DynamicResource AuraShadowMd}"
                                    Padding="4">
                                <ListBox Name="PART_SuggestionsList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MaxHeight="250"/>
                            </Border>
                        </Popup>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- AutoComplete :pointerover -->
    <Style Selector="input|AutoComplete:pointerover /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderHoverBrush}"/>
    </Style>

    <!-- AutoComplete :focus / :open -->
    <Style Selector="input|AutoComplete:focus-visible /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderFocusBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <Style Selector="input|AutoComplete:open /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderFocusBrush}"/>
    </Style>

    <!-- AutoComplete :loading -->
    <Style Selector="input|AutoComplete:loading">
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <!-- AutoComplete :disabled -->
    <Style Selector="input|AutoComplete:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
