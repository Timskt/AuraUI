<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="using:AuraUI.Controls.Input">

    <!-- ConfigEditor — Fluent Style -->
    <Style Selector="input|ConfigEditor">
        <Setter Property="Background" Value="{DynamicResource AuraSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <!-- Header -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{TemplateBinding Tag}"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Foreground="{DynamicResource AuraForegroundBrush}"
                                   Margin="0,0,0,12"/>
                        <!-- Validation errors -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource AuraErrorMutedBrush}"
                                CornerRadius="{DynamicResource AuraRadiusSm}"
                                Padding="10,6"
                                Margin="0,12,0,0"
                                IsVisible="False">
                            <ItemsControl/>
                        </Border>
                        <!-- Form content -->
                        <ScrollViewer/>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="input|ConfigEditor:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Focus -->
    <Style Selector="input|ConfigEditor:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraFocusBrush}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="input|ConfigEditor:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
