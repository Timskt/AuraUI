<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         CheckBox — Fluent Style
         ============================================================ -->
    <Style Selector="CheckBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="00:00:00.150" Property="Background"/>
                <BrushTransition Duration="00:00:00.150" Property="BorderBrush"/>
                <DoubleTransition Duration="00:00:00.200" Property="Opacity" Easing="{DynamicResource AuraEasingStandard}"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Checkbox box -->
                    <Border Name="PART_Border"
                            Width="20" Height="20"
                            CornerRadius="4"
                            Background="{DynamicResource AuraInputBackgroundBrush}"
                            BorderBrush="{DynamicResource AuraInputBorderBrush}"
                            BorderThickness="1.5"
                            VerticalAlignment="Center">
                        <!-- Checkmark -->
                        <Path Name="PART_CheckMark"
                              Width="12" Height="12"
                              Data="M 2,6 L 5,9 L 10,3"
                              Stroke="Transparent"
                              StrokeThickness="2"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                        </Path>
                    </Border>

                    <!-- Content -->
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- CheckBox :pointerover -->
    <Style Selector="CheckBox:pointerover /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderHoverBrush}"/>
    </Style>

    <!-- CheckBox :checked -->
    <Style Selector="CheckBox:checked /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <Style Selector="CheckBox:checked /template/ Path#PART_CheckMark">
        <Setter Property="Stroke" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <!-- CheckBox checked + :pointerover -->
    <Style Selector="CheckBox:checked:pointerover /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryHoverBrush}"/>
    </Style>

    <!-- CheckBox checked + :pressed -->
    <Style Selector="CheckBox:checked:pressed /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryPressedBrush}"/>
    </Style>

    <!-- CheckBox :pressed -->

    <!-- CheckBox :focus -->
    <Style Selector="CheckBox:focus-visible /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraFocusBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- CheckBox :disabled -->
    <Style Selector="CheckBox:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- CheckBox indeterminate -->
    <Style Selector="CheckBox:indeterminate /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <Style Selector="CheckBox:indeterminate /template/ Path#PART_CheckMark">
        <Setter Property="Data" Value="M 3,6 L 9,6"/>
        <Setter Property="Stroke" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
    </Style>

    <!-- CheckBox error -->
    <Style Selector="CheckBox:error /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>

    <!-- ============================================================
         CheckBox Variants
         ============================================================ -->

    <!-- Card style -->
    <Style Selector="CheckBox.card">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{DynamicResource AuraInputBackgroundBrush}"
                        BorderBrush="{DynamicResource AuraInputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource AuraRadiusMd}"
                        Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Name="PART_CheckBoxBorder"
                                Width="20" Height="20"
                                CornerRadius="4"
                                Background="{DynamicResource AuraInputBackgroundBrush}"
                                BorderBrush="{DynamicResource AuraInputBorderBrush}"
                                BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <Path Name="PART_CheckMark"
                                  Width="12" Height="12"
                                  Data="M 2,6 L 5,9 L 10,3"
                                  Stroke="Transparent"
                                  StrokeThickness="2"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox.card:pointerover /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderHoverBrush}"/>
    </Style>

    <Style Selector="CheckBox.card:checked /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Toggle style (Switch-like) -->
    <Style Selector="CheckBox.toggle">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Name="PART_Border"
                            Width="40" Height="20"
                            CornerRadius="10"
                            Background="{DynamicResource AuraBorderBrush}"
                            VerticalAlignment="Center">
                        <Border Name="PART_SwitchKnob"
                                Width="16" Height="16"
                                CornerRadius="8"
                                Background="{DynamicResource AuraBackgroundBrush}"
                                Margin="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        </Border>
                    </Border>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox.toggle:checked /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <Style Selector="CheckBox.toggle:checked /template/ Border#PART_SwitchKnob">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>


    <!-- ============================================================ -->
    <!-- CodexSwitchUI: Opacity-based interaction states              -->
    <!-- ============================================================ -->
    <Style Selector="CheckBox:pressed">
        <Setter Property="Opacity" Value="0.86"/>
        <Setter Property="ScaleTransform.ScaleX" Value="0.98"/>
        <Setter Property="ScaleTransform.ScaleY" Value="0.98"/>
    </Style>

</Styles>
