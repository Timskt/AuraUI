<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selection="clr-namespace:AuraUI.Controls.Selection;assembly=AuraUI.Controls">

    <!-- ============================================================
         TreeSelect — Fluent Style
         ============================================================ -->
    <Style Selector="selection|TreeSelect">
        <Setter Property="Background" Value="{DynamicResource AuraInputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraInputRadius}"/>
        <Setter Property="MinHeight" Value="{DynamicResource AuraControlHeightMd}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Panel>
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Selection display area -->
                            <Border Grid.Column="0"
                                    Padding="8,6">
                                <TextBlock Name="PART_DisplayText"
                                           Foreground="{DynamicResource AuraPlaceholderBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <!-- Dropdown toggle -->
                            <Border Grid.Column="1"
                                    Width="32"
                                    Background="Transparent"
                                    VerticalAlignment="Stretch">
                                <Path Width="12" Height="12"
                                      Data="M 1,4 L 6,9 L 11,4"
                                      Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                      StrokeThickness="1.5"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Popup Name="PART_Dropdown"
                               IsLightDismissEnabled="True"
                               Placement="BottomEdgeAlignedLeft"
                               MaxHeight="400">
                            <Border Background="{DynamicResource AuraFlyoutBackgroundBrush}"
                                    BorderBrush="{DynamicResource AuraFlyoutBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource AuraRadiusMd}"
                                    BoxShadow="{DynamicResource AuraShadowMd}"
                                    Padding="4">
                                <DockPanel>
                                    <TextBox Name="PART_SearchBox"
                                             DockPanel.Dock="Top"
                                             Margin="4,4,4,8"
                                             FontSize="13"
                                             Watermark="Search..."
                                             IsVisible="False"/>
                                    <TreeView Name="PART_TreeView"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"/>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- TreeSelect :pointerover -->
    <Style Selector="selection|TreeSelect:pointerover /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderHoverBrush}"/>
    </Style>

    <!-- TreeSelect :open / :focus -->
    <Style Selector="selection|TreeSelect:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderFocusBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <Style Selector="selection|TreeSelect:open /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInputBorderFocusBrush}"/>
    </Style>

    <!-- TreeSelect :disabled -->
    <Style Selector="selection|TreeSelect:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

</Styles>
