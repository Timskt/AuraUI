<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="using:AuraUI.Controls.Display">

    <!-- ============================================================
         ProgressRing — Fluent Style
         ============================================================ -->
    <Style Selector="display|ProgressRing">
        <Setter Property="Foreground" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Track (background ring) -->
                    <Ellipse Name="PART_Track"
                             Stroke="{TemplateBinding Background}"
                             StrokeThickness="3"
                             Fill="Transparent"/>

                    <!-- Indicator (progress arc) -->
                    <Ellipse Name="PART_Indicator"
                             Stroke="{TemplateBinding Foreground}"
                             StrokeThickness="3"
                             Fill="Transparent"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Indeterminate spinning animation -->
    <Style Selector="display|ProgressRing:indeterminate /template/ Ellipse#PART_Indicator">
        <Style.Animations>
            <Animation Duration="00:00:01.500"
                       IterationCount="Infinite"
                       Easing="LinearEasing">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.3"/>
                    <Setter Property="RenderTransform">
                        <RotateTransform Angle="0"/>
                    </Setter>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1.0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.3"/>
                    <Setter Property="RenderTransform">
                        <RotateTransform Angle="360"/>
                    </Setter>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================================
         ProgressRing Size Variants
         ============================================================ -->

    <!-- Small -->
    <Style Selector="display|ProgressRing.sm">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="display|ProgressRing.sm /template/ Ellipse">
        <Setter Property="StrokeThickness" Value="2"/>
    </Style>

    <!-- Medium (default: 32) -->

    <!-- Large -->
    <Style Selector="display|ProgressRing.lg">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
    </Style>
    <Style Selector="display|ProgressRing.lg /template/ Ellipse">
        <Setter Property="StrokeThickness" Value="4"/>
    </Style>

    <!-- Extra Large -->
    <Style Selector="display|ProgressRing.xl">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
    </Style>
    <Style Selector="display|ProgressRing.xl /template/ Ellipse">
        <Setter Property="StrokeThickness" Value="5"/>
    </Style>

    <!-- ============================================================
         ProgressRing Color Variants
         ============================================================ -->

    <Style Selector="display|ProgressRing.success">
        <Setter Property="Foreground" Value="{DynamicResource AuraSuccessBrush}"/>
    </Style>
    <Style Selector="display|ProgressRing.warning">
        <Setter Property="Foreground" Value="{DynamicResource AuraWarningBrush}"/>
    </Style>
    <Style Selector="display|ProgressRing.error">
        <Setter Property="Foreground" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>
    <Style Selector="display|ProgressRing.info">
        <Setter Property="Foreground" Value="{DynamicResource AuraInfoBrush}"/>
    </Style>

</Styles>
