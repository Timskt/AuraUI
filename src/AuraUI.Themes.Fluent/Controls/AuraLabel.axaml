<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:AuraUI.Controls.Display;assembly=AuraUI.Controls">

    <!-- ============================================================
         AuraLabel — Fluent Style (Form Label)
         ============================================================ -->
    <Style Selector="display|AuraLabel">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="0,0,0,4"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="2">
                    <DockPanel>
                        <TextBlock Name="PART_RequiredIndicator"
                                   Text=" *"
                                   Foreground="{DynamicResource AuraErrorBrush}"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Right"
                                   IsVisible="False"/>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </DockPanel>
                    <TextBlock Name="PART_Description"
                               Text="{TemplateBinding Description}"
                               FontSize="12"
                               Foreground="{DynamicResource AuraForegroundTertiaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Required indicator visible -->
    <Style Selector="display|AuraLabel.required /template/ TextBlock#PART_RequiredIndicator">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Description visible -->
    <Style Selector="display|AuraLabel:not(.has-description) /template/ TextBlock#PART_Description">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Size: Small -->
    <Style Selector="display|AuraLabel.small">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="display|AuraLabel.small /template/ TextBlock#PART_Description">
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Size: Large -->
    <Style Selector="display|AuraLabel.large">
        <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="display|AuraLabel.large /template/ TextBlock#PART_Description">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Target disabled -->
    <Style Selector="display|AuraLabel.target-disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

</Styles>
