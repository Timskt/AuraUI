<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feedback="using:AuraUI.Controls.Feedback">

    <!-- ============================================================
         AuraToast Control — Fluent Style with ControlTemplate
         ============================================================ -->
    <Style Selector="feedback|AuraToast">
        <Setter Property="ProgressBarBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="CloseButtonForeground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="feedback:AuraToast">
                <Border Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource AuraBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="{DynamicResource AuraShadowMd}"
                        ClipToBounds="True"
                        MinWidth="300"
                        MaxWidth="{TemplateBinding MaxWidth}">
                    <DockPanel>
                        <!-- Close button -->
                        <Button Name="PART_CloseButton"
                                DockPanel.Dock="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4"
                                Width="28" Height="28"
                                Margin="8,0,-4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                IsVisible="{TemplateBinding ShowClose}">
                            <Path Width="10" Height="10"
                                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  Stroke="{DynamicResource AuraForegroundSecondaryBrush}"
                                  StrokeThickness="1.5"/>
                        </Button>

                        <!-- Icon -->
                        <ContentPresenter Name="PART_IconPresenter"
                                          DockPanel.Dock="Left"
                                          VerticalAlignment="Top"
                                          Margin="0,0,12,0"/>

                        <!-- Progress bar -->
                        <Border Name="PART_ProgressBar"
                                DockPanel.Dock="Bottom"
                                Height="3"
                                CornerRadius="1.5"
                                Background="{TemplateBinding ProgressBarBrush}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"/>

                        <!-- Content area -->
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding ToastTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AuraForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{TemplateBinding ToastTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{TemplateBinding Message}"
                                       FontSize="13"
                                       Foreground="{DynamicResource AuraForegroundSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================================
         Toast — Fluent Style (Small notification popup)
         ============================================================ -->
    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AuraShadowMd}"/>
        <Setter Property="MinWidth" Value="300"/>
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- Toast enter animation -->
    <Style Selector="Border.toast">
        <Style.Animations>
            <Animation Duration="00:00:00.300"
                       Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="-20"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Toast layout: icon + text + close -->
    <Style Selector="Border.toast StackPanel">
        <Setter Property="Spacing" Value="12"/>
    </Style>

    <!-- Toast icon -->
    <Style Selector="Border.toast-icon">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusFull}"/>
    </Style>

    <!-- Toast title -->
    <Style Selector="Border.toast TextBlock.toast-title">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
    </Style>

    <!-- Toast message -->
    <Style Selector="Border.toast TextBlock.toast-message">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Toast close button -->
    <Style Selector="Button.toast-close">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.toast-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>
    <Style Selector="Button.toast-close:pressed">
        <Setter Property="Background" Value="{DynamicResource AuraPressedBrush}"/>
    </Style>

    <!-- ============================================================
         Toast Variants
         ============================================================ -->

    <!-- Success toast -->
    <Style Selector="Border.toast.success">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraSuccessBrush}"/>
    </Style>
    <Style Selector="Border.toast.success Border.toast-icon">
        <Setter Property="Background" Value="{DynamicResource AuraSuccessLightBrush}"/>
    </Style>

    <!-- Warning toast -->
    <Style Selector="Border.toast.warning">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraWarningBrush}"/>
    </Style>
    <Style Selector="Border.toast.warning Border.toast-icon">
        <Setter Property="Background" Value="{DynamicResource AuraWarningLightBrush}"/>
    </Style>

    <!-- Error toast -->
    <Style Selector="Border.toast.error">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>
    <Style Selector="Border.toast.error Border.toast-icon">
        <Setter Property="Background" Value="{DynamicResource AuraErrorLightBrush}"/>
    </Style>

    <!-- Info toast -->
    <Style Selector="Border.toast.info">
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInfoBrush}"/>
    </Style>
    <Style Selector="Border.toast.info Border.toast-icon">
        <Setter Property="Background" Value="{DynamicResource AuraInfoLightBrush}"/>
    </Style>

</Styles>
