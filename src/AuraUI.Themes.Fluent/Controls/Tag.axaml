<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout">

    <!-- ============================================================
         Tag — Fluent Style
         ============================================================ -->
    <Style Selector="layout|Tag">
        <Setter Property="Background" Value="{DynamicResource AuraMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CloseIconForeground" Value="{DynamicResource AuraForegroundTertiaryBrush}"/>
        <Setter Property="CloseButtonSize" Value="10"/>
        <Setter Property="CloseButtonHoverBackground" Value="{DynamicResource AuraPressedBrush}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource AuraBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource AuraTagRadius}"
                        Padding="8,4"
                        MinHeight="24"
                        ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- Icon -->
                        <ContentPresenter Name="PART_IconPresenter"
                                          Content="{TemplateBinding Icon}"
                                          VerticalAlignment="Center"/>
                        <!-- Content -->
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                        <!-- Close button -->
                        <Button Name="PART_CloseButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2,0"
                                Margin="2,0,-2,0"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                IsVisible="False">
                            <Path Width="{TemplateBinding CloseButtonSize}"
                                  Height="{TemplateBinding CloseButtonSize}"
                                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  Stroke="{TemplateBinding CloseIconForeground}"
                                  StrokeThickness="1.5"/>
                        </Button>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Closable: show close button -->
    <Style Selector="layout|Tag:closable /template/ Button#PART_CloseButton">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="layout|Tag:closable /template/ Border#PART_Border">
        <Setter Property="Padding" Value="8,4,4,4"/>
    </Style>

    <!-- Tag hover/press states -->
    <Style Selector="layout|Tag:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderHoverBrush}"/>
    </Style>

    <!-- Tag variant colors -->
    <Style Selector="layout|Tag:primary /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <Style Selector="layout|Tag:success /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraSuccessLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraSuccessBrush}"/>
    </Style>

    <Style Selector="layout|Tag:warning /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraWarningLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraWarningBrush}"/>
    </Style>

    <Style Selector="layout|Tag:error /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AuraErrorLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>

    <Style Selector="layout|Tag:outlined /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
    </Style>

    <!-- Close button hover -->
    <Style Selector="layout|Tag /template/ Button#PART_CloseButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraPressedBrush}"/>
    </Style>

</Styles>
