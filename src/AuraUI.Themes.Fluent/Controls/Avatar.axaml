<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Avatar — Fluent Style
         ============================================================ -->
    <Style Selector="Border.avatar">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraAvatarRadius}"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Avatar content (text initials) -->
    <Style Selector="Border.avatar TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AuraForegroundOnAccentBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Avatar image -->
    <Style Selector="Border.avatar Image">
        <Setter Property="Stretch" Value="UniformToFill"/>
    </Style>

    <!-- Avatar sizes -->
    <Style Selector="Border.avatar.xs">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="Border.avatar.xs TextBlock">
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style Selector="Border.avatar.sm">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
    </Style>
    <Style Selector="Border.avatar.sm TextBlock">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.avatar.lg">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
    </Style>
    <Style Selector="Border.avatar.lg TextBlock">
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <Style Selector="Border.avatar.xl">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
    </Style>
    <Style Selector="Border.avatar.xl TextBlock">
        <Setter Property="FontSize" Value="24"/>
    </Style>

    <!-- Avatar shape: square -->
    <Style Selector="Border.avatar.square">
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
    </Style>

    <!-- Avatar ring (with border) -->
    <Style Selector="Border.avatar.ring">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBrush}"/>
    </Style>

    <!-- Avatar color variants -->
    <Style Selector="Border.avatar.secondary">
        <Setter Property="Background" Value="{DynamicResource AuraSecondaryBrush}"/>
    </Style>
    <Style Selector="Border.avatar.success">
        <Setter Property="Background" Value="{DynamicResource AuraSuccessBrush}"/>
    </Style>
    <Style Selector="Border.avatar.warning">
        <Setter Property="Background" Value="{DynamicResource AuraWarningBrush}"/>
    </Style>
    <Style Selector="Border.avatar.error">
        <Setter Property="Background" Value="{DynamicResource AuraErrorBrush}"/>
    </Style>

    <!-- Avatar group (stacked) -->
    <Style Selector="StackPanel.avatar-group">
        <Setter Property="Spacing" Value="-8"/>
    </Style>
    <Style Selector="StackPanel.avatar-group Border.avatar">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBackgroundBrush}"/>
    </Style>

</Styles>
