<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AuraUI.Controls.Layout">

    <!-- ============================================================
         Avatar — Fluent Style
         ============================================================ -->
    <Style Selector="layout|Avatar">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="AvatarForeground" Value="White"/>
        <Setter Property="AvatarBorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="AvatarBorderThickness" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding FallbackBackground}"
                        CornerRadius="999"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        ClipToBounds="True"
                        BorderBrush="{TemplateBinding AvatarBorderBrush}"
                        BorderThickness="{TemplateBinding AvatarBorderThickness}">
                    <Panel>
                        <Image Name="PART_Image"
                               Stretch="UniformToFill"
                               IsVisible="False"/>
                        <TextBlock Name="PART_Fallback"
                                   Text="{TemplateBinding FallbackText}"
                                   Foreground="{TemplateBinding AvatarForeground}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Avatar sizes -->
    <Style Selector="layout|Avatar[Size=Small]">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
    </Style>
    <Style Selector="layout|Avatar[Size=Small] /template/ TextBlock#PART_Fallback">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="layout|Avatar[Size=Medium]">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <Style Selector="layout|Avatar[Size=Large]">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
    </Style>
    <Style Selector="layout|Avatar[Size=Large] /template/ TextBlock#PART_Fallback">
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <Style Selector="layout|Avatar[Size=XL]">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
    </Style>
    <Style Selector="layout|Avatar[Size=XL] /template/ TextBlock#PART_Fallback">
        <Setter Property="FontSize" Value="24"/>
    </Style>

    <!-- Avatar shape: square -->
    <Style Selector="layout|Avatar[Shape=Square] /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
    </Style>

</Styles>
