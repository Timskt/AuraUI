<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:AuraUI.Controls.Input;assembly=AuraUI.Controls">

    <!-- ============================================================
         SplitButton — Fluent Style
         ============================================================ -->
    <Style Selector="input|SplitButton">
        <Setter Property="Background" Value="{DynamicResource AuraCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AuraRadiusMd}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Primary Action -->
                        <Button Name="PART_PrimaryAction"
                                Grid.Column="0"
                                Content="{TemplateBinding Content}"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="12,8"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand"/>

                        <!-- Dropdown Arrow -->
                        <Button Name="PART_MenuTrigger"
                                Grid.Column="1"
                                Content="&#x25BC;"
                                Background="Transparent"
                                BorderThickness="0"
                                BorderBrush="{DynamicResource AuraBorderBrush}"
                                Padding="8"
                                FontSize="10"
                                Cursor="Hand"/>

                        <!-- Dropdown Surface -->
                        <Border Name="PART_Surface"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                IsVisible="False"
                                Background="{DynamicResource AuraCardBrush}"
                                BoxShadow="{DynamicResource AuraShadowMd}"
                                CornerRadius="{DynamicResource AuraRadiusMd}"
                                Margin="0,4,0,0">
                            <ContentPresenter Content="{TemplateBinding DropDownContent}"
                                              ContentTemplate="{TemplateBinding DropDownContentTemplate}"/>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Open state: show dropdown surface -->
    <Style Selector="input|SplitButton.open /template/ Border#PART_Surface">
        <Setter Property="IsVisible" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,40,0,0"/>
    </Style>

    <!-- Loading state -->
    <Style Selector="input|SplitButton.loading">
        <Setter Property="Opacity" Value="0.6"/>
        <Setter Property="IsEnabled" Value="False"/>
    </Style>

    <!-- Hover states -->
    <Style Selector="input|SplitButton /template/ Button#PART_PrimaryAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>
    <Style Selector="input|SplitButton /template/ Button#PART_MenuTrigger:pointerover">
        <Setter Property="Background" Value="{DynamicResource AuraHoverBrush}"/>
    </Style>

</Styles>
